@model CYHAstro.Core.DTOs.Astrologer.AstrologerDetailDto
@{
    ViewData["Title"] = $"{Model.DisplayName} - Astrologer Profile";
    decimal userBalance = ViewBag.UserBalance != null ? (decimal)ViewBag.UserBalance : 0m;
    decimal minBalanceNeeded = Model.ChatRatePerMinute * 5m;
    bool hasSufficientBalance = userBalance >= minBalanceNeeded;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Astrologer" asp-action="Index" class="text-secondary text-decoration-none">Astrologers</a></li>
            <li class="breadcrumb-item active text-warning" aria-current="page">@Model.DisplayName</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Left: Profile Overview & Bio -->
        <div class="col-lg-8">
            <div class="cosmic-card p-4 p-sm-5 mb-4">
                <div class="d-flex flex-wrap align-items-center gap-4 mb-4">
                    <img src="@(string.IsNullOrEmpty(Model.ProfilePhotoUrl) ? "https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&q=80&w=300" : Model.ProfilePhotoUrl)"
                         alt="@Model.DisplayName" class="astro-avatar" style="width: 100px; height: 100px;" />

                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h3 class="fw-bold text-white mb-0 brand-font">@Model.DisplayName</h3>
                            <span class="badge-verified"><i class="fa-solid fa-certificate me-1"></i> Verified</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="d-flex align-items-center text-warning">
                                <i class="fa-solid fa-star gold-star me-1"></i>
                                <span class="fw-bold">@Model.Rating.ToString("F2")</span>
                            </div>
                            <span class="text-secondary small">| @Model.TotalReviews Reviews</span>
                            <span class="text-secondary small">| @Model.TotalConsultations Consultations</span>
                        </div>
                        <div class="small text-secondary">
                            <i class="fa-solid fa-language me-1 text-info"></i> <strong>Languages:</strong> @string.Join(", ", Model.Languages)
                        </div>
                    </div>
                </div>

                <!-- Specialties -->
                <h6 class="text-warning text-uppercase small fw-bold mb-2">Areas of Expertise</h6>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    @foreach (var spec in Model.Specializations)
                    {
                        <span class="badge bg-dark border border-secondary text-secondary py-2 px-3 small">
                            <i class="fa-solid fa-check text-warning me-1"></i> @spec
                        </span>
                    }
                </div>

                <!-- Bio -->
                <h6 class="text-warning text-uppercase small fw-bold mb-2">About Astrologer</h6>
                <p class="text-light leading-relaxed mb-4">
                    @(Model.Bio ?? "Distinguished Vedic scholar with over two decades of dedicated study in predictive horary astrology, Nakshatra analysis, and Lal Kitab remedies. Provides compassionate and actionable guidance.")
                </p>

                <div class="row g-3 text-center border-top border-secondary border-opacity-25 pt-4">
                    <div class="col-4">
                        <h4 class="fw-bold text-warning mb-0">@Model.ExperienceYears+</h4>
                        <span class="text-secondary small">Years Experience</span>
                    </div>
                    <div class="col-4">
                        <h4 class="fw-bold text-warning mb-0">@Model.TotalConsultations+</h4>
                        <span class="text-secondary small">Orders Completed</span>
                    </div>
                    <div class="col-4">
                        <h4 class="fw-bold text-warning mb-0">99.4%</h4>
                        <span class="text-secondary small">Satisfaction Rate</span>
                    </div>
                </div>
            </div>

            <!-- Customer Reviews -->
            <div class="cosmic-card p-4 p-sm-5">
                <h5 class="fw-bold text-white brand-font mb-4">
                    <i class="fa-solid fa-comments text-warning me-2"></i> Verified Seeker Reviews (@Model.RecentReviews.Count)
                </h5>

                @if (Model.RecentReviews.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var rev in Model.RecentReviews)
                        {
                            <div class="p-3 rounded bg-dark border border-secondary border-opacity-30">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-white small">@rev.UserName</span>
                                    <div class="text-warning small">
                                        @for (int i = 0; i < (int)rev.Rating; i++)
                                        {
                                            <i class="fa-solid fa-star gold-star"></i>
                                        }
                                    </div>
                                </div>
                                <p class="text-secondary small mb-1">@(rev.Comment ?? "Accurate prediction and very soothing guidance. Highly recommended!")</p>
                                <span class="text-secondary" style="font-size: 0.65rem;">@rev.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-secondary small mb-0">No reviews yet for this astrologer.</p>
                }
            </div>
        </div>

        <!-- Right: Consultation Pricing & Booking Action Card -->
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 90px;">
                <div class="cosmic-card p-4 border-warning border-opacity-40">
                    <h5 class="fw-bold text-white mb-3">Consultation Rates</h5>

                    <!-- Pricing Options -->
                    <div class="d-flex flex-column gap-2 mb-4">
                        <div class="p-3 rounded bg-dark border border-warning border-opacity-30 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-4 text-warning"><i class="fa-solid fa-comments"></i></span>
                                <div>
                                    <span class="fw-bold text-white d-block small">Chat Consultation</span>
                                    <span class="text-secondary" style="font-size: 0.7rem;">Real-time text & chart sharing</span>
                                </div>
                            </div>
                            <span class="fw-bold text-warning">₹@Model.ChatRatePerMinute<small class="text-secondary fw-normal">/min</small></span>
                        </div>

                        <div class="p-3 rounded bg-dark border border-secondary border-opacity-30 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-4 text-info"><i class="fa-solid fa-phone-volume"></i></span>
                                <div>
                                    <span class="fw-bold text-white d-block small">Voice Call</span>
                                    <span class="text-secondary" style="font-size: 0.7rem;">Private WebRTC audio</span>
                                </div>
                            </div>
                            <span class="fw-bold text-white">₹@Model.AudioRatePerMinute<small class="text-secondary fw-normal">/min</small></span>
                        </div>

                        <div class="p-3 rounded bg-dark border border-secondary border-opacity-30 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-4 text-primary"><i class="fa-solid fa-video"></i></span>
                                <div>
                                    <span class="fw-bold text-white d-block small">Video Call</span>
                                    <span class="text-secondary" style="font-size: 0.7rem;">Face-to-face LiveKit session</span>
                                </div>
                            </div>
                            <span class="fw-bold text-white">₹@Model.VideoRatePerMinute<small class="text-secondary fw-normal">/min</small></span>
                        </div>
                    </div>

                    <!-- User Balance Status & Booking CTA -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="p-3 rounded bg-dark border border-secondary mb-3 small">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-secondary">Your Balance:</span>
                                <strong class="text-warning">₹@userBalance.ToString("F2")</strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <span class="text-secondary">Min Required (5 mins):</span>
                                <span class="text-secondary">₹@minBalanceNeeded.ToString("F2")</span>
                            </div>
                        </div>

                        @if (hasSufficientBalance)
                        {
                            <button class="btn btn-gold w-100 py-3 fw-bold mb-2" onclick="startSession('@Model.PublicId', 'CHAT')">
                                <i class="fa-solid fa-comment-dots me-2"></i> Start Chat Session
                            </button>
                            <button class="btn btn-outline-gold w-100 py-2 small" onclick="startSession('@Model.PublicId', 'AUDIO')">
                                <i class="fa-solid fa-phone me-2"></i> Start Audio Call
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-warning py-2 small mb-3">
                                <i class="fa-solid fa-circle-exclamation me-1"></i> Balance low. Recharge at least 5 mins (₹@minBalanceNeeded.ToString("F2")) to connect.
                            </div>
                            <a asp-controller="Wallet" asp-action="Index" class="btn btn-gold w-100 py-3 fw-bold">
                                <i class="fa-solid fa-wallet me-2"></i> Recharge Wallet Now
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-gold w-100 py-3 fw-bold">
                            <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Sign In to Consult
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function startSession(astroId, sessionType) {
            alert("Connecting with astrologer... Creating encrypted LiveKit room.");
            // Session initiation logic connects to Phase 14-16 WebRTC consultation hub
        }
    </script>
}
