@model CYHAstro.Core.DTOs.Astrology.KundliChartDto
@{
    ViewData["Title"] = $"Janam Kundli - {Model.Name}";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="text-warning small fw-bold text-uppercase">Vedic Horoscope Calculation</span>
            <h2 class="fw-bold text-white brand-font mb-0">Kundli for @Model.Name</h2>
        </div>
        <div class="d-flex gap-2 mt-3 mt-sm-0">
            <a asp-action="Index" class="btn btn-outline-gold btn-sm">
                <i class="fa-solid fa-rotate-left me-1"></i> New Kundli
            </a>
            <button onclick="window.print()" class="btn btn-gold btn-sm">
                <i class="fa-solid fa-print me-1"></i> Print / Save PDF
            </button>
        </div>
    </div>

    <!-- Core Highlights Cards -->
    <div class="row g-3 text-center mb-4">
        <div class="col-6 col-md-3">
            <div class="cosmic-card p-3">
                <span class="text-secondary small d-block">Ascendant (Lagna)</span>
                <h5 class="text-warning fw-bold mb-0">@Model.AscendantSign</h5>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="cosmic-card p-3">
                <span class="text-secondary small d-block">Moon Sign (Rashi)</span>
                <h5 class="text-info fw-bold mb-0">@Model.MoonSign</h5>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="cosmic-card p-3">
                <span class="text-secondary small d-block">Sun Sign (Surya)</span>
                <h5 class="text-warning fw-bold mb-0">@Model.SunSign</h5>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="cosmic-card p-3">
                <span class="text-secondary small d-block">Birth Nakshatra</span>
                <h5 class="text-success fw-bold mb-0">@Model.BirthNakshatra <small class="text-secondary">P-@Model.BirthPada</small></h5>
            </div>
        </div>
    </div>

    <!-- Dosha & Dasha Highlights Bar -->
    <div class="cosmic-card p-4 mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-shield text-warning fs-4"></i>
                    <div>
                        <span class="text-secondary small d-block">Mangal Dosha Status</span>
                        <strong class="text-white">@Model.MangalDoshaStatus</strong>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-infinity text-info fs-4"></i>
                    <div>
                        <span class="text-secondary small d-block">Kaal Sarp Status</span>
                        <strong class="text-white">@Model.KaalSarpDoshaStatus</strong>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-timeline text-success fs-4"></i>
                    <div>
                        <span class="text-secondary small d-block">Current Operating Dasha</span>
                        <strong class="text-white small">@Model.CurrentDasha</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gemini AI Synthesis -->
    @if (!string.IsNullOrWhiteSpace(Model.AiInterpretation))
    {
        <div class="cosmic-card p-4 p-md-5 mb-4 border-warning border-opacity-40">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="fs-4 text-warning"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
                <h5 class="fw-bold text-white brand-font mb-0">AI Astrological Synthesis (Grounded in Vedic Positions)</h5>
            </div>
            <p class="text-light leading-relaxed mb-0">
                @Model.AiInterpretation
            </p>
        </div>
    }

    <!-- 9 Grahas Table -->
    <div class="cosmic-card p-4 mb-4">
        <h5 class="fw-bold text-white brand-font mb-3">
            <i class="fa-solid fa-table-cells text-warning me-2"></i> Planetary Positions (Nava Grahas)
        </h5>
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 small">
                <thead>
                    <tr class="text-secondary border-secondary">
                        <th>Planet</th>
                        <th>Sanskrit</th>
                        <th>Sign (Rashi)</th>
                        <th>House (Bhava)</th>
                        <th>Nakshatra</th>
                        <th>Pada</th>
                        <th>Longitude</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Planets)
                    {
                        <tr>
                            <td class="fw-bold text-warning">@p.PlanetName</td>
                            <td>@p.SanskritName</td>
                            <td>@p.SignName</td>
                            <td>House @p.House</td>
                            <td>@p.Nakshatra</td>
                            <td>@p.Pada</td>
                            <td>@p.Longitude°</td>
                            <td>
                                @if (p.IsRetrograde)
                                {
                                    <span class="badge bg-danger text-white">Retrograde</span>
                                }
                                else if (p.IsCombust)
                                {
                                    <span class="badge bg-warning text-dark">Combust</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-light">Direct</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 12 Bhavas (Houses) -->
    <div class="cosmic-card p-4 mb-4">
        <h5 class="fw-bold text-white brand-font mb-3">
            <i class="fa-solid fa-house text-warning me-2"></i> 12 Bhavas (Vedic House Breakdown)
        </h5>
        <div class="row g-3">
            @foreach (var h in Model.Houses)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="p-3 rounded bg-dark border border-secondary border-opacity-30 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-warning small">House @h.HouseNumber</span>
                            <span class="badge bg-secondary small">@h.SignName</span>
                        </div>
                        <span class="text-secondary small d-block">Degree: @h.Degree°</span>
                        <div class="mt-2 small text-light">
                            <strong>Planets:</strong> @(h.PlanetsInHouse.Any() ? string.Join(", ", h.PlanetsInHouse) : "None")
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Talk to Astrologer CTA -->
    <div class="p-4 rounded bg-dark border border-warning border-opacity-30 text-center">
        <h5 class="fw-bold text-white mb-2">Want a Deep Dive Consultation on this Kundli?</h5>
        <p class="text-secondary small mb-3">Our verified astrologers can analyze specific career yogas, marriage timing, and recommend personalized gemstones and remedies.</p>
        <a asp-controller="Astrologer" asp-action="Index" class="btn btn-gold px-4 py-2">
            <i class="fa-solid fa-comments me-2"></i> Talk to Astrologer for Detailed Analysis
        </a>
    </div>
</div>
