@model CYHAstro.Core.DTOs.Astrologer.AstrologerRegistrationDto
@{
    ViewData["Title"] = "Astrologer Onboarding Application";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Join as Astrologer Partner - CYHAstro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            background: radial-gradient(circle at center, #141a32 0%, #090c17 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #f1f3f9;
            padding: 30px 15px;
        }
        .brand-font {
            font-family: 'Cinzel', serif;
        }
        .register-card {
            background: rgba(19, 25, 46, 0.95);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(229, 169, 59, 0.25);
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
            max-width: 680px;
            width: 100%;
        }
        .btn-gold {
            background: linear-gradient(135deg, #e5a93b 0%, #d48b18 100%);
            color: #0b0e1b;
            font-weight: 700;
            border: none;
            transition: all 0.2s ease;
        }
        .btn-gold:hover {
            background: linear-gradient(135deg, #f5bc56 0%, #e5a93b 100%);
            color: #000;
            transform: translateY(-1px);
        }
        .form-control, .form-select {
            background-color: #0d1224 !important;
            border-color: #273151 !important;
            color: #f1f3f9 !important;
        }
        .form-control:focus, .form-select:focus {
            border-color: #e5a93b !important;
            box-shadow: 0 0 0 0.2rem rgba(229, 169, 59, 0.25) !important;
        }
    </style>
</head>
<body>
    <div class="register-card p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="mb-2">
                <i class="fa-solid fa-om text-warning fs-1"></i>
            </div>
            <h3 class="fw-bold brand-font text-white mb-1">CYH<span class="text-warning">Astro</span></h3>
            <span class="badge bg-warning text-dark fw-bold mb-2">ASTROLOGER PARTNER ONBOARDING</span>
            <p class="text-secondary small mb-0">Apply to join India's trusted Vedic platform. Connect with thousands of seekers daily.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger bg-danger bg-opacity-25 border-danger text-light small py-2 mb-4">
                <div asp-validation-summary="All" class="text-danger mb-0"></div>
            </div>
        }

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <!-- Personal Info -->
                <div class="col-12">
                    <h6 class="text-warning brand-font small border-bottom border-secondary pb-1 mb-2">
                        <i class="fa-solid fa-user me-1"></i> 1. Personal & Contact Details
                    </h6>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-light small fw-bold">Full Name / Display Name *</label>
                    <input type="text" asp-for="DisplayName" class="form-control" placeholder="e.g. Acharya Raman Sharma" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label text-light small fw-bold">Email Address (Login ID) *</label>
                    <input type="email" asp-for="Email" class="form-control" placeholder="name@domain.com" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label text-light small fw-bold">Phone Number *</label>
                    <input type="tel" asp-for="PhoneNumber" class="form-control" placeholder="+91 98765 43210" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label text-light small fw-bold">Years of Experience *</label>
                    <input type="number" asp-for="ExperienceYears" min="1" max="60" class="form-control" placeholder="e.g. 8" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label text-light small fw-bold">Password *</label>
                    <input type="password" asp-for="Password" class="form-control" placeholder="At least 6 characters" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label text-light small fw-bold">Confirm Password *</label>
                    <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" required />
                </div>

                <!-- Professional Expertise -->
                <div class="col-12 pt-2">
                    <h6 class="text-warning brand-font small border-bottom border-secondary pb-1 mb-2">
                        <i class="fa-solid fa-certificate me-1"></i> 2. Astrology Expertise & Languages
                    </h6>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-light small fw-bold">Specializations *</label>
                    <input type="text" asp-for="Specializations" class="form-control" placeholder="Vedic, Kundli, Prashna, Tarot, Vastu" required />
                    <span class="text-secondary small">Comma-separated</span>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-light small fw-bold">Languages Spoken *</label>
                    <input type="text" asp-for="Languages" class="form-control" placeholder="Hindi, English, Sanskrit, Gujarati" required />
                    <span class="text-secondary small">Comma-separated</span>
                </div>

                <div class="col-12">
                    <label class="form-label text-light small fw-bold">Bio & Vedic Pedigree</label>
                    <textarea asp-for="Bio" rows="3" class="form-control" placeholder="Briefly describe your astrological lineage, education, remedies expertise, and practice focus..."></textarea>
                </div>

                <!-- Rates -->
                <div class="col-12 pt-2">
                    <h6 class="text-warning brand-font small border-bottom border-secondary pb-1 mb-2">
                        <i class="fa-solid fa-indian-rupee-sign me-1"></i> 3. Proposed Rates (₹ / Min)
                    </h6>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-light small">Chat Rate / Min (₹)</label>
                    <input type="number" asp-for="ChatRatePerMinute" min="5" max="500" class="form-control" value="15" />
                </div>

                <div class="col-md-4">
                    <label class="form-label text-light small">Audio Call Rate / Min (₹)</label>
                    <input type="number" asp-for="AudioRatePerMinute" min="5" max="500" class="form-control" value="25" />
                </div>

                <div class="col-md-4">
                    <label class="form-label text-light small">Video Call Rate / Min (₹)</label>
                    <input type="number" asp-for="VideoRatePerMinute" min="10" max="1000" class="form-control" value="35" />
                </div>

                <div class="col-12 pt-3">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="agreeTerms" required checked />
                        <label class="form-check-label text-secondary small" for="agreeTerms">
                            I certify that all details provided are authentic and agree to CYHAstro's code of Vedic ethics and partner terms.
                        </label>
                    </div>
                </div>

                <div class="col-12 pt-2">
                    <button type="submit" class="btn btn-gold w-100 py-2 fw-bold">
                        <i class="fa-solid fa-paper-plane me-2"></i> Submit Astrologer Application
                    </button>
                </div>
            </div>

            <div class="text-center mt-3">
                <span class="text-secondary small">Already have an astrologer account?</span>
                <a asp-action="Login" class="text-warning small fw-bold text-decoration-none ms-1">
                    Sign In here <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>

            <div class="text-center mt-2">
                <a href="/" class="text-secondary small text-decoration-none">
                    <i class="fa-solid fa-house me-1"></i> Back to Main Portal
                </a>
            </div>
        </form>
    </div>
</body>
</html>
