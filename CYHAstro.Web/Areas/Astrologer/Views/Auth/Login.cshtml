@{
    ViewData["Title"] = "Astrologer Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Astrologer Portal Login - CYHAstro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            background: radial-gradient(circle at center, #141a32 0%, #090c17 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #f1f3f9;
        }
        .brand-font {
            font-family: 'Cinzel', serif;
        }
        .login-card {
            background: rgba(19, 25, 46, 0.95);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(229, 169, 59, 0.25);
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
            max-width: 440px;
            width: 100%;
        }
        .btn-gold {
            background: linear-gradient(135deg, #e5a93b 0%, #d48b18 100%);
            color: #0b0e1b;
            font-weight: 700;
            border: none;
            transition: all 0.2s ease;
        }
        .btn-gold:hover {
            background: linear-gradient(135deg, #f5bc56 0%, #e5a93b 100%);
            color: #000;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>
    <div class="login-card p-4 p-md-5 mx-3">
        <div class="text-center mb-4">
            <div class="mb-2">
                <i class="fa-solid fa-om text-warning fs-1"></i>
            </div>
            <h3 class="fw-bold brand-font text-white mb-1">CYH<span class="text-warning">Astro</span></h3>
            <span class="badge bg-warning text-dark fw-bold mb-2">ASTROLOGER PARTNER PORTAL</span>
            <p class="text-secondary small mb-0">Sign in to manage live consultations, accept seeker calls, and track earnings</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger bg-danger bg-opacity-25 border-danger text-light small py-2 mb-3">
                <i class="fa-solid fa-triangle-exclamation me-1"></i> @TempData["Error"]
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success bg-success bg-opacity-25 border-success text-light small py-2 mb-3">
                <i class="fa-solid fa-circle-check me-1"></i> @TempData["Success"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger bg-danger bg-opacity-25 border-danger text-light small py-2 mb-3">
                <div asp-validation-summary="All" class="mb-0"></div>
            </div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="mb-3">
                <label class="form-label small text-secondary">Astrologer Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-black border-secondary text-secondary"><i class="fa-solid fa-envelope"></i></span>
                    <input type="email" name="email" class="form-control bg-black border-secondary text-light"
                           placeholder="astrologer@cyhastro.com" value="astrologer@cyhastro.com" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small text-secondary">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-black border-secondary text-secondary"><i class="fa-solid fa-lock"></i></span>
                    <input type="password" name="password" class="form-control bg-black border-secondary text-light"
                           placeholder="••••••••" value="Astro@CYHAstro2026!" required />
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input type="checkbox" name="rememberMe" class="form-check-input" id="rememberMe" checked />
                    <label class="form-check-label text-secondary small" for="rememberMe">Remember me</label>
                </div>
                <span class="text-warning small opacity-75">Verified Partners Only</span>
            </div>

            <button type="submit" class="btn btn-gold w-100 py-2 fw-bold mb-3">
                <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Sign In to Console
            </button>

            <div class="text-center mb-3">
                <span class="text-secondary small">Want to join as an expert?</span>
                <a asp-action="Register" class="text-warning small fw-bold text-decoration-none ms-1">
                    Apply as Astrologer <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>

            <div class="text-center">
                <a href="/" class="text-secondary small text-decoration-none">
                    <i class="fa-solid fa-house me-1"></i> Back to Main Portal
                </a>
            </div>
        </form>
    </div>
</body>
</html>
