@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="theme-color" content="#090c17" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>@ViewData["Title"] - CYHAstro Astrologer Portal</title>
    <link rel="icon" type="image/png" href="~/images/cyhastro-favicon.png" asp-append-version="true" />

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- Site Responsive Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --cosmic-bg: #090c17;
            --cosmic-surface: #101526;
            --cosmic-card: rgba(19, 25, 46, 0.85);
            --cosmic-border: rgba(229, 169, 59, 0.2);
            --gold-primary: #e5a93b;
            --gold-hover: #f5bc56;
            --gold-gradient: linear-gradient(135deg, #e5a93b 0%, #d48b18 100%);
        }

        body {
            background-color: var(--cosmic-bg);
            color: #f1f3f9;
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .brand-font {
            font-family: 'Cinzel', serif;
            letter-spacing: 0.5px;
        }

        .cosmic-navbar {
            background: rgba(12, 16, 29, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--cosmic-border);
        }

        .cosmic-card {
            background: var(--cosmic-card);
            backdrop-filter: blur(10px);
            border: 1px solid var(--cosmic-border);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
        }

        .btn-gold {
            background: var(--gold-gradient);
            color: #0b0e1b;
            font-weight: 700;
            border: none;
            transition: all 0.2s ease;
        }
        .btn-gold:hover {
            background: linear-gradient(135deg, #f5bc56 0%, #e5a93b 100%);
            color: #000;
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(229, 169, 59, 0.35);
        }

        .nav-link.active-astro {
            color: var(--gold-primary) !important;
            border-bottom: 2px solid var(--gold-primary);
        }
    </style>
</head>
@{
    var astroController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var astroAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAstroAuthed = User.Identity?.IsAuthenticated == true && User.IsInRole("Astrologer");
    var showAstroBottomNav = isAstroAuthed && !(string.Equals(astroController, "Consultation", StringComparison.OrdinalIgnoreCase) && string.Equals(astroAction, "Room", StringComparison.OrdinalIgnoreCase));
}
<body class="@(showAstroBottomNav ? "has-mobile-nav" : "no-mobile-nav")">
    @if (isAstroAuthed)
    {
        <!-- Astrologer Top Navigation -->
        <nav class="navbar navbar-expand-lg cosmic-navbar sticky-top py-2">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2 m-0 flex-shrink-0" asp-area="Astrologer" asp-controller="Home" asp-action="Index">
                    <img src="~/images/cyhastro-logo.png" alt="CYHAstro Logo" class="brand-logo-img" asp-append-version="true" />
                    <span class="text-white fw-bold brand-font fs-5">CYH<span class="text-warning">Astro</span></span>
                    <span class="badge bg-warning text-dark fw-bold d-none d-sm-inline" style="font-size: 0.65rem;">ASTROLOGER</span>
                </a>

                <!-- Desktop Links (>= 992px) -->
                <ul class="navbar-nav cosmic-desktop-nav d-none d-lg-flex align-items-center me-auto ms-4 gap-1">
                    <li class="nav-item">
                        <a class="nav-link @(astroController == "Home" ? "active" : "")"
                           asp-area="Astrologer" asp-controller="Home" asp-action="Index">
                            <i class="fa-solid fa-chart-pie text-warning"></i><span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(astroController == "Earnings" ? "active" : "")"
                           asp-area="Astrologer" asp-controller="Earnings" asp-action="Index">
                            <i class="fa-solid fa-wallet text-success"></i><span>Earnings &amp; Sessions</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(astroController == "Profile" ? "active" : "")"
                           asp-area="Astrologer" asp-controller="Profile" asp-action="Index">
                            <i class="fa-solid fa-user-pen text-info"></i><span>Profile &amp; Rates</span>
                        </a>
                    </li>
                </ul>

                <!-- Right Actions (Always Visible & Single Row) -->
                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <!-- Live Availability Switch -->
                    <div class="d-flex align-items-center gap-2 bg-dark px-2 px-sm-3 py-1 rounded-pill border border-secondary border-opacity-50">
                        <span class="small text-secondary d-none d-md-inline">Status:</span>
                        <div class="form-check form-switch mb-0 d-flex align-items-center gap-1">
                            <input class="form-check-input m-0" type="checkbox" role="switch" id="navAvailabilitySwitch" onchange="toggleNavAvailability(this)">
                            <label class="form-check-label small fw-bold" id="navAvailabilityLabel" for="navAvailabilitySwitch">Offline</label>
                        </div>
                    </div>

                    <!-- Notification Bell -->
                    <div class="dropdown" id="astroNotifDropdown">
                        <button class="header-icon-btn position-relative" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false" id="astroNotifBtn"
                                title="Notifications" aria-label="Notifications">
                            <i class="fa-solid fa-bell" id="astroNotifIcon"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"
                                  id="astroNotifBadge" style="font-size:0.6rem;">0</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark border-secondary shadow-lg cosmic-notif-menu p-0" id="astroNotifList">
                            <li class="px-3 py-2 d-flex justify-content-between align-items-center border-bottom border-secondary bg-black">
                                <span class="fw-bold small text-warning"><i class="fa-solid fa-bell me-1"></i> Notifications</span>
                                <button class="btn btn-link btn-sm text-secondary p-0 small text-decoration-none" onclick="astroMarkAllRead()">Mark all read</button>
                            </li>
                            <li id="astroNotifEmpty" class="px-3 py-3 text-center text-secondary small">
                                <i class="fa-solid fa-check-circle me-1 text-success"></i> You're all caught up!
                            </li>
                        </ul>
                    </div>

                    <!-- Desktop User Dropdown -->
                    <div class="dropdown d-none d-lg-block">
                        <button class="btn btn-outline-secondary dropdown-toggle text-light btn-sm d-flex align-items-center gap-2 border-opacity-50 header-user-btn"
                                type="button" data-bs-toggle="dropdown">
                            <i class="fa-solid fa-circle-user text-warning fs-6"></i>
                            <span class="text-truncate small" style="max-width: 115px;">@(User.Identity?.Name ?? "Astrologer")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark border-secondary shadow-lg mt-2">
                            <li>
                                <a class="dropdown-item py-2" asp-area="Astrologer" asp-controller="Profile" asp-action="Index">
                                    <i class="fa-solid fa-gear me-2 text-secondary"></i> Settings
                                </a>
                            </li>
                            <li><hr class="dropdown-divider border-secondary"></li>
                            <li>
                                <form asp-area="Astrologer" asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item py-2 text-danger">
                                        <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>

                    <!-- Mobile Drawer Button (< 992px) -->
                    <button class="header-icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#astroMobileDrawer" aria-label="Open menu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </div>
        </nav>

        <!-- Astrologer Mobile Drawer (< 992px) -->
        <div class="offcanvas offcanvas-end cosmic-offcanvas d-lg-none" tabindex="-1" id="astroMobileDrawer" aria-labelledby="astroMobileDrawerLabel">
            <div class="offcanvas-header border-bottom border-secondary border-opacity-25 px-3 py-3">
                <span class="d-flex align-items-center gap-2 brand-font fw-bold" id="astroMobileDrawerLabel">
                    <img src="~/images/cyhastro-logo.png" alt="CYHAstro Logo" class="brand-logo-img" style="width: 32px; height: 32px;" asp-append-version="true" />
                    <span class="text-white fs-5">CYH<span class="text-warning">Astro</span></span>
                </span>
                <button type="button" class="header-icon-btn" data-bs-dismiss="offcanvas" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-3">
                <div class="drawer-user-card mb-3 p-3 rounded-4 d-flex align-items-center gap-2">
                    <div class="drawer-avatar flex-shrink-0"><i class="fa-solid fa-om text-dark"></i></div>
                    <div class="min-w-0">
                        <div class="text-white fw-bold small text-truncate">@(User.Identity?.Name ?? "Astrologer")</div>
                        <div class="text-warning" style="font-size: 0.72rem;">Astrologer Partner</div>
                    </div>
                </div>
                <div class="drawer-section-label">Console Menu</div>
                <div class="d-flex flex-column gap-1 mb-3">
                    <a class="drawer-nav-item @(astroController == "Home" ? "active" : "")" asp-area="Astrologer" asp-controller="Home" asp-action="Index">
                        <span class="drawer-nav-icon text-warning"><i class="fa-solid fa-chart-pie"></i></span>
                        <span>Dashboard</span>
                    </a>
                    <a class="drawer-nav-item @(astroController == "Earnings" ? "active" : "")" asp-area="Astrologer" asp-controller="Earnings" asp-action="Index">
                        <span class="drawer-nav-icon text-success"><i class="fa-solid fa-wallet"></i></span>
                        <span>Earnings &amp; Sessions</span>
                    </a>
                    <a class="drawer-nav-item @(astroController == "Profile" ? "active" : "")" asp-area="Astrologer" asp-controller="Profile" asp-action="Index">
                        <span class="drawer-nav-icon text-info"><i class="fa-solid fa-user-pen"></i></span>
                        <span>My Profile &amp; Rates</span>
                    </a>
                </div>
                <div class="mt-auto pt-3 border-top border-secondary border-opacity-25">
                    <form asp-area="Astrologer" asp-controller="Auth" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100 rounded-pill fw-semibold">
                            <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Toast Notification Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div id="incomingToast" class="toast bg-dark text-white border-warning" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="false">
            <div class="toast-header bg-warning text-dark fw-bold">
                <i class="fa-solid fa-bell me-2"></i>
                <strong class="me-auto">New Consultation Request!</strong>
                <button type="button" class="btn-close btn-close-dark" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body p-3">
                <div class="mb-2" id="toastMessage">Seeker is waiting for you to connect.</div>
                <div class="d-flex gap-2">
                    <a href="#" id="toastAcceptBtn" class="btn btn-success btn-sm fw-bold flex-grow-1">
                        <i class="fa-solid fa-phone me-1"></i> Accept & Join
                    </a>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="toast">Dismiss</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Banners -->
    <main class="flex-grow-1 py-4">
        <div class="container-fluid px-lg-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-25 border-success text-light mb-4" role="alert">
                    <i class="fa-solid fa-circle-check text-success me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show bg-danger bg-opacity-25 border-danger text-light mb-4" role="alert">
                    <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="py-3 text-center text-secondary small border-top border-secondary border-opacity-25">
        <span>&copy; @DateTime.UtcNow.Year CYHAstro Jyotish Platform. Astrologer Partner Console.</span>
    </footer>

    <!-- Bootstrap 5.3 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SignalR Client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>
        // Web Audio Synthesizer Beep for Incoming Request
        function playAlertTone() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
                osc.frequency.setValueAtTime(880.00, ctx.currentTime + 0.15); // A5
                gain.gain.setValueAtTime(0.2, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.5);
            } catch (e) {
                console.log("Audio alert playback error:", e);
            }
        }

        async function toggleNavAvailability(checkbox) {
            const isAvailable = checkbox.checked;
            const label = document.getElementById("navAvailabilityLabel");
            label.innerText = isAvailable ? "Online" : "Offline";
            label.className = isAvailable ? "form-check-label small fw-bold text-success" : "form-check-label small fw-bold text-secondary";

            try {
                const resp = await fetch("/Astrologer/Home/ToggleAvailability", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ isAvailable })
                });
                const data = await resp.json();
                if (!resp.ok) {
                    checkbox.checked = !isAvailable;
                    label.innerText = !isAvailable ? "Online" : "Offline";
                }
            } catch (e) {
                checkbox.checked = !isAvailable;
                label.innerText = !isAvailable ? "Online" : "Offline";
            }
        }
    </script>

    <!-- Astrologer Notification Bell JS -->
    <script>
        (function () {
            let _astroNotifTimer = null;

            async function loadAstroNotifications() {
                try {
                    const resp = await fetch('/Astrologer/Notifications/List', { credentials: 'same-origin' });
                    if (!resp.ok) return;
                    const data = await resp.json();
                    if (!data.success) return;

                    const badge = document.getElementById('astroNotifBadge');
                    const icon = document.getElementById('astroNotifIcon');
                    const list = document.getElementById('astroNotifList');
                    const empty = document.getElementById('astroNotifEmpty');
                    const count = data.unreadCount || 0;

                    if (count > 0) {
                        badge.textContent = count > 99 ? '99+' : count;
                        badge.classList.remove('d-none');
                        icon.classList.add('text-warning');
                        icon.classList.remove('text-secondary');
                    } else {
                        badge.classList.add('d-none');
                        icon.classList.remove('text-warning');
                        icon.classList.add('text-secondary');
                    }

                    // Remove old items (keep header + empty)
                    const toRemove = list.querySelectorAll('.astro-notif-item');
                    toRemove.forEach(el => el.remove());

                    if (!data.items || data.items.length === 0) {
                        empty.classList.remove('d-none');
                    } else {
                        empty.classList.add('d-none');
                        data.items.forEach(n => {
                            const li = document.createElement('li');
                            li.className = 'astro-notif-item border-bottom border-secondary border-opacity-25';
                            li.innerHTML = `<a href="${n.actionUrl || '#'}" class="dropdown-item py-2 px-3 ${n.isRead ? '' : 'fw-bold'}"
                                onclick="astroMarkRead(${n.id}, this)">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="fa-solid fa-star-and-crescent text-warning mt-1 small"></i>
                                    <div>
                                        <div class="small">${n.title || ''}</div>
                                        <div class="text-secondary" style="font-size:0.75rem;">${n.message || ''}</div>
                                    </div>
                                </div>
                            </a>`;
                            list.appendChild(li);
                        });
                    }
                } catch (e) { }
            }

            window.astroMarkRead = async function (id, el) {
                try {
                    const form = new FormData();
                    form.append('id', id);
                    const tok = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (tok) form.append('__RequestVerificationToken', tok.value);
                    await fetch('/Astrologer/Notifications/MarkRead', { method: 'POST', body: form, credentials: 'same-origin' });
                    el?.closest('.astro-notif-item')?.querySelector('a')?.classList.remove('fw-bold');
                    await loadAstroNotifications();
                } catch (e) { }
            };

            window.astroMarkAllRead = async function () {
                try {
                    const form = new FormData();
                    const tok = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (tok) form.append('__RequestVerificationToken', tok.value);
                    await fetch('/Astrologer/Notifications/MarkAllRead', { method: 'POST', body: form, credentials: 'same-origin' });
                    await loadAstroNotifications();
                } catch (e) { }
            };

            // Load on page load & every 30s
            document.addEventListener('DOMContentLoaded', function () {
                if (document.getElementById('astroNotifBadge')) {
                    loadAstroNotifications();
                    _astroNotifTimer = setInterval(loadAstroNotifications, 30000);
                }
            });
        })();
    </script>

    @if (showAstroBottomNav)
    {
        <!-- Astrologer Mobile Bottom Navigation -->
        <nav class="mobile-bottom-nav d-md-none" aria-label="Astrologer Mobile Navigation">
            <a asp-area="Astrologer" asp-controller="Home" asp-action="Index" class="@(astroController == "Home" ? "active" : "")">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Dashboard</span>
            </a>
            <a asp-area="Astrologer" asp-controller="Earnings" asp-action="Index" class="@(astroController == "Earnings" ? "active" : "")">
                <i class="fa-solid fa-wallet"></i>
                <span>Earnings</span>
            </a>
            <a asp-area="Astrologer" asp-controller="Profile" asp-action="Index" class="@(astroController == "Profile" ? "active" : "")">
                <i class="fa-solid fa-user-pen"></i>
                <span>Profile</span>
            </a>
        </nav>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
