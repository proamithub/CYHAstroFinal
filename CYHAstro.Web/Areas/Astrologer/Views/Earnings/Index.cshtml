@model IReadOnlyList<CYHAstro.Core.DTOs.Astrologer.AstrologerEarningItemDto>
@{
    ViewData["Title"] = "Earnings & Payout Ledger";
    var dash = ViewBag.Dashboard as CYHAstro.Core.DTOs.Astrologer.AstrologerDashboardDto ?? new CYHAstro.Core.DTOs.Astrologer.AstrologerDashboardDto();
    var settlements = ViewBag.Settlements as IReadOnlyList<CYHAstro.Core.DTOs.Admin.SettlementDto> ?? new List<CYHAstro.Core.DTOs.Admin.SettlementDto>();
}

<!-- Top Stats Row -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="cosmic-card p-4">
            <span class="text-secondary small text-uppercase d-block mb-1">Today's Net Earnings</span>
            <h2 class="fw-bold text-success mb-0">₹@dash.TodayEarnings.ToString("F2")</h2>
            <span class="text-secondary small">Credited today</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="cosmic-card p-4">
            <span class="text-secondary small text-uppercase d-block mb-1">Lifetime Net Earnings</span>
            <h2 class="fw-bold text-warning mb-0">₹@dash.TotalEarnings.ToString("F2")</h2>
            <span class="text-secondary small">Across all consultations</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="cosmic-card p-4">
            <span class="text-secondary small text-uppercase d-block mb-1">Completed Sessions</span>
            <h2 class="fw-bold text-white mb-0">@dash.TotalConsultations</h2>
            <span class="text-secondary small">Average rating: ⭐ @dash.Rating.ToString("F2")</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="cosmic-card p-4 text-center d-flex flex-column justify-content-center align-items-center">
            <span class="text-secondary small text-uppercase d-block mb-2">Payout Withdrawal</span>
            <button type="button" class="btn btn-warning w-100 fw-bold py-2 shadow" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                <i class="fa-solid fa-money-bill-transfer me-2"></i> Request Payout
            </button>
            <span class="text-secondary small mt-1">Min: ₹100 | Direct Bank/UPI</span>
        </div>
    </div>
</div>

<!-- Nav Tabs for Ledger and Settlements -->
<ul class="nav nav-pills mb-4 gap-2" id="earningsTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active bg-black border border-warning text-warning fw-bold px-4 py-2" id="ledger-tab" data-bs-toggle="tab" data-bs-target="#ledger-pane" type="button" role="tab">
            <i class="fa-solid fa-receipt me-2"></i> Consultation Earnings Ledger
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link bg-black border border-secondary text-light fw-bold px-4 py-2" id="settlements-tab" data-bs-toggle="tab" data-bs-target="#settlements-pane" type="button" role="tab">
            <i class="fa-solid fa-building-columns me-2"></i> Payout & Withdrawal History
            @if (settlements.Any(s => s.Status == "PENDING"))
            {
                <span class="badge bg-warning text-dark ms-2">@settlements.Count(s => s.Status == "PENDING") Pending</span>
            }
        </button>
    </li>
</ul>

<div class="tab-content" id="earningsTabsContent">
    <!-- Tab 1: Consultation Earnings Ledger -->
    <div class="tab-pane fade show active" id="ledger-pane" role="tabpanel">
        <div class="cosmic-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold text-white brand-font mb-1">Consultation Earnings Ledger</h4>
                    <span class="text-secondary small">Detailed audit trail of all completed consultations, platform fees, and net take-home</span>
                </div>
                <span class="badge bg-dark border border-secondary text-secondary">Immutable Record</span>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 small">
                        <thead>
                            <tr class="text-secondary border-secondary">
                                <th>Date & Time</th>
                                <th>Session Public ID</th>
                                <th>Seeker Name</th>
                                <th>Type</th>
                                <th>Duration</th>
                                <th>Gross Charge</th>
                                <th>Platform Fee</th>
                                <th>Net Earning</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model)
                            {
                                <tr>
                                    <td>@e.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td class="font-monospace text-warning">@e.SessionPublicId</td>
                                    <td class="text-white fw-bold">@e.ClientName</td>
                                    <td>
                                        <span class="badge @(e.SessionType == "VIDEO" ? "bg-primary" : e.SessionType == "AUDIO" ? "bg-info text-dark" : "bg-warning text-dark")">
                                            @e.SessionType
                                        </span>
                                    </td>
                                    <td>@(e.DurationSeconds / 60)m @(e.DurationSeconds % 60)s</td>
                                    <td class="text-light">₹@e.GrossAmount.ToString("F2")</td>
                                    <td class="text-danger">- ₹@e.CommissionDeducted.ToString("F2")</td>
                                    <td class="text-success fw-bold">₹@e.NetEarning.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-secondary">
                    <i class="fa-solid fa-receipt fs-2 text-warning mb-2 opacity-50 d-block"></i>
                    <span>No consultation earnings logged yet. As seekers consult with you, earnings appear here automatically.</span>
                </div>
            }
        </div>
    </div>

    <!-- Tab 2: Payout & Withdrawal History -->
    <div class="tab-pane fade" id="settlements-pane" role="tabpanel">
        <div class="cosmic-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold text-white brand-font mb-1">Bank & UPI Settlement History</h4>
                    <span class="text-secondary small">Direct payout requests processed to your verified bank account or UPI ID</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-gold" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                    <i class="fa-solid fa-plus me-1"></i> New Withdrawal
                </button>
            </div>

            @if (settlements.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 small">
                        <thead>
                            <tr class="text-secondary border-secondary">
                                <th>Requested At</th>
                                <th>Reference ID</th>
                                <th>Amount</th>
                                <th>Payout Mode</th>
                                <th>Account Details</th>
                                <th>Bank UTR / Ref</th>
                                <th>Status</th>
                                <th>Processed At</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in settlements)
                            {
                                <tr>
                                    <td>@s.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td class="font-monospace text-warning">@s.PublicId</td>
                                    <td class="fw-bold text-success fs-6">₹@s.Amount.ToString("F2")</td>
                                    <td>
                                        <span class="badge bg-dark border border-secondary text-info">@s.PayoutMethod</span>
                                    </td>
                                    <td class="text-light">@(string.IsNullOrWhiteSpace(s.Remarks) ? "—" : s.Remarks)</td>
                                    <td class="font-monospace text-warning">@(string.IsNullOrWhiteSpace(s.PayoutReference) ? "Pending Transfer" : s.PayoutReference)</td>
                                    <td>
                                        @if (s.Status == "COMPLETED")
                                        {
                                            <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Paid</span>
                                        }
                                        else if (s.Status == "REJECTED")
                                        {
                                            <span class="badge bg-danger"><i class="fa-solid fa-xmark me-1"></i> Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> Under Review</span>
                                        }
                                    </td>
                                    <td class="text-secondary">@(s.ProcessedAt.HasValue ? s.ProcessedAt.Value.ToString("dd MMM yyyy, hh:mm tt") : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-secondary">
                    <i class="fa-solid fa-building-columns fs-2 text-warning mb-2 opacity-50 d-block"></i>
                    <span>No withdrawal requests submitted yet. Use the "Request Payout" button above to withdraw your balance.</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: Request Withdrawal -->
<div class="modal fade" id="withdrawModal" tabindex="-1" aria-labelledby="withdrawModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border border-warning text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-warning brand-font" id="withdrawModalLabel">
                    <i class="fa-solid fa-money-bill-transfer me-2"></i> Request Payout Withdrawal
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RequestWithdrawal" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-light">Withdrawal Amount (₹) *</label>
                        <input type="number" name="amount" min="100" max="@dash.TotalEarnings" step="1" class="form-control bg-black border-secondary text-warning fw-bold fs-5" placeholder="1000" required />
                        <span class="text-secondary small">Lifetime earnings: ₹@dash.TotalEarnings.ToString("F2") (Min ₹100)</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-light">Payout Mode *</label>
                        <select name="payoutMethod" class="form-select bg-black border-secondary text-light">
                            <option value="UPI" selected>UPI (GooglePay, PhonePe, Paytm)</option>
                            <option value="BankTransfer">Direct NEFT / IMPS Bank Transfer</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-light">Payment Account Details *</label>
                        <textarea name="remarks" rows="2" class="form-control bg-black border-secondary text-light" placeholder="For UPI: yourname@okaxis&#10;For Bank: A/C No, IFSC Code, Beneficiary Name" required></textarea>
                    </div>

                    <div class="p-3 bg-black rounded border border-secondary text-secondary small">
                        <i class="fa-solid fa-shield-halved text-warning me-1"></i> Payouts are verified by finance and disbursed within 24 business hours directly to your provided account.
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold fw-bold px-4">Submit Withdrawal Request</button>
                </div>
            </form>
        </div>
    </div>
</div>
