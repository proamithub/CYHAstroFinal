@model CYHAstro.Core.DTOs.Consultation.ConsultationResponseDto
@{
    ViewData["Title"] = $"Consultation with {Model.UserName}";
    var isMedia = Model.SessionType == "AUDIO" || Model.SessionType == "VIDEO";
    var seekerProfile = ViewBag.SeekerProfile as CYHAstro.Core.Entities.BirthProfile;
}

<div class="container-fluid py-2" style="max-width: 1440px;">
    <!-- Top Consultation Bar -->
    <div class="card cosmic-card p-3 mb-3 border-warning border-opacity-50">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <!-- Seeker Info -->
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 50px; height: 50px;">
                    @(string.IsNullOrEmpty(Model.UserName) ? "S" : Model.UserName.Substring(0, 1).ToUpper())
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h5 class="fw-bold text-white mb-0 brand-font">@Model.UserName</h5>
                        <span class="badge bg-warning text-dark fw-bold">@Model.SessionType</span>
                    </div>
                    <span class="text-secondary small">
                        Earning Rate: <strong class="text-success">₹@Model.RatePerMinute.ToString("F2")/min</strong>
                    </span>
                </div>
            </div>

            <!-- Live Session Counters -->
            <div class="d-flex align-items-center gap-4 bg-black bg-opacity-50 px-4 py-2 rounded-4 border border-secondary border-opacity-25">
                <div class="text-center">
                    <span class="d-block text-secondary small text-uppercase">Duration</span>
                    <span class="text-warning fw-bold fs-5 font-monospace" id="astroSessionTimer">00:00</span>
                </div>
                <div class="text-center border-start border-secondary border-opacity-50 ps-4">
                    <span class="d-block text-secondary small text-uppercase">Gross Billed</span>
                    <span class="text-white fw-bold fs-5 font-monospace" id="astroGrossBilled">₹0.00</span>
                </div>
                <div class="text-center border-start border-secondary border-opacity-50 ps-4">
                    <span class="d-block text-secondary small text-uppercase">Est. Net Take-Home</span>
                    <span class="text-success fw-bold fs-5 font-monospace" id="astroNetEarnings">₹0.00</span>
                </div>
            </div>

            <!-- End Call Action -->
            <div>
                <button type="button" class="btn btn-danger fw-bold px-4 py-2" data-bs-toggle="modal" data-bs-target="#endAstroSessionModal">
                    <i class="fa-solid fa-phone-slash me-1"></i> End Consultation
                </button>
            </div>
        </div>
    </div>

    <!-- Main Workspace -->
    <div class="row g-3">
        <!-- Media / Seeker Kundli Section -->
        <div class="@(isMedia ? "col-lg-7" : "col-lg-6")">
            @if (isMedia)
            {
                <!-- Video / Audio Stream Grid -->
                <div class="card cosmic-card p-3 mb-3" style="min-height: 480px;">
                    <div class="position-relative rounded-4 overflow-hidden bg-black d-flex align-items-center justify-content-center border border-secondary border-opacity-50"
                         style="height: 420px;" id="videoContainer">
                        <!-- Remote Seeker Feed Placeholder -->
                        <div class="text-center p-4" id="remoteParticipantCard" style="z-index: 2;">
                            <div class="rounded-circle bg-secondary bg-opacity-25 border border-warning mx-auto mb-3 d-flex align-items-center justify-content-center"
                                 style="width: 100px; height: 100px;">
                                <i class="fa-solid fa-user text-warning fs-1"></i>
                            </div>
                            <h5 class="text-white fw-bold mb-1">@Model.UserName</h5>
                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">
                                <i class="fa-solid fa-signal me-1"></i> Seeker Feed Active
                            </span>
                        </div>

                        <!-- Astrologer Local Pip -->
                        <div class="position-absolute bottom-0 end-0 m-3 rounded-3 overflow-hidden border border-warning shadow"
                             style="width: 140px; height: 95px; background-color: #101526; z-index: 20;" id="localParticipantCard">
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-secondary small">
                                <i class="fa-solid fa-video me-1 text-warning"></i> You
                            </div>
                        </div>
                    </div>

                    <!-- Media Controls -->
                    <div class="d-flex justify-content-center gap-3 mt-3">
                        <button class="btn btn-outline-light rounded-circle p-3" id="micToggleBtn" title="Mute/Unmute Mic" onclick="toggleAudio()">
                            <i class="fa-solid fa-microphone fs-5"></i>
                        </button>
                        @if (Model.SessionType == "VIDEO")
                        {
                            <button class="btn btn-outline-light rounded-circle p-3" id="camToggleBtn" title="Camera On/Off" onclick="toggleVideo()">
                                <i class="fa-solid fa-video fs-5"></i>
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Seeker Vedic Birth Profile Card -->
            <div class="card cosmic-card p-3">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <span class="text-warning fw-bold">
                        <i class="fa-solid fa-dharmachakra me-2"></i> Seeker Vedic Birth Details
                    </span>
                    <span class="badge bg-dark text-secondary">Verified Profile</span>
                </div>

                @if (seekerProfile != null)
                {
                    <div class="row g-2 small">
                        <div class="col-6 col-md-3">
                            <div class="p-2 rounded bg-dark border border-secondary border-opacity-25">
                                <span class="d-block text-secondary">Date of Birth</span>
                                <strong class="text-white">@seekerProfile.DateOfBirth.ToString("dd MMM yyyy")</strong>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-2 rounded bg-dark border border-secondary border-opacity-25">
                                <span class="d-block text-secondary">Time of Birth</span>
                                <strong class="text-white">@(seekerProfile.TimeOfBirth.HasValue ? seekerProfile.TimeOfBirth.Value.ToString("hh:mm tt") : "Not provided")</strong>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-2 rounded bg-dark border border-secondary border-opacity-25">
                                <span class="d-block text-secondary">Place of Birth</span>
                                <strong class="text-white text-truncate d-block">@(string.IsNullOrEmpty(seekerProfile.BirthPlace) ? "Not specified" : seekerProfile.BirthPlace)</strong>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-2 rounded bg-dark border border-secondary border-opacity-25">
                                <span class="d-block text-secondary">Gender</span>
                                <strong class="text-white">@(seekerProfile.Gender == "M" ? "Male" : seekerProfile.Gender == "F" ? "Female" : "Other")</strong>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-secondary small mb-0">Seeker has not linked a primary birth profile. Please ask for their birth details directly in chat.</p>
                }
            </div>
        </div>

        <!-- Chat Stream & Astrologer Notes Section -->
        <div class="@(isMedia ? "col-lg-5" : "col-lg-6")">
            <div class="card cosmic-card p-3 d-flex flex-column" style="height: 600px;">
                <div class="card-header bg-transparent border-0 pb-2 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                    <span class="text-white fw-bold"><i class="fa-solid fa-comments text-warning me-2"></i>Live Consultation Chat</span>
                    <span class="badge bg-dark border border-secondary text-secondary small" id="astroConnectionStatus">Connecting...</span>
                </div>

                <!-- Messages Stream -->
                <div class="flex-grow-1 p-3 overflow-y-auto" id="astroChatMessages" style="background-color: rgba(9, 12, 23, 0.7); border-radius: 12px;">
                    <div class="text-center my-2">
                        <span class="badge bg-dark border border-secondary text-secondary px-3 py-1">
                            <i class="fa-solid fa-hand-holding-heart text-warning me-1"></i> Consultation session #@Model.PublicId is live.
                        </span>
                    </div>
                </div>

                <!-- Typing indicator -->
                <div class="small text-secondary px-3 py-1" id="astroTypingIndicator" style="display: none;">
                    <i class="fa-solid fa-ellipsis fa-fade text-warning me-1"></i> Seeker is typing...
                </div>

                <!-- Message Input -->
                <div class="card-footer bg-transparent border-0 pt-2 border-top border-secondary border-opacity-25">
                    <div class="input-group">
                        <input type="text" id="astroChatInput" class="form-control bg-black text-light border-secondary"
                               placeholder="Type your astrological guidance..." onkeypress="handleAstroKeyPress(event)" />
                        <button class="btn btn-gold px-4 fw-bold" type="button" onclick="sendAstroMessage()">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Confirm End Consultation -->
<div class="modal fade" id="endAstroSessionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light rounded-4 shadow-lg">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title text-danger fw-bold">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>End Consultation Session?
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3">
                    Are you sure you want to end this consultation with <strong>@Model.UserName</strong>?
                </p>
                <div class="p-3 rounded bg-black border border-secondary border-opacity-50 text-secondary small">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Elapsed Consultation Time:</span>
                        <strong class="text-white" id="modalAstroElapsed">00:00</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Approximate Earnings:</span>
                        <strong class="text-success" id="modalAstroEarn">₹0.00</strong>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary border-opacity-25">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Continue</button>
                <form asp-action="EndSession" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sessionPublicId" value="@Model.PublicId" />
                    <button type="submit" class="btn btn-danger px-4 fw-bold">Yes, End Session</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SignalR Client Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>
        const sessionPublicId = "@Model.PublicId";
        const sessionType = "@Model.SessionType";
        const sessionStatus = "@Model.Status";
        const ratePerMinute = @Model.RatePerMinute;
        const commissionPct = 20.0; // 20% platform commission
        let elapsedSeconds = @Model.DurationSeconds;
        let timerInterval = null;
        let timerStarted = false;

        function startAstroTimer() {
            if (timerStarted) return;
            timerStarted = true;
            timerInterval = setInterval(() => {
                elapsedSeconds++;
                const mins = Math.floor(elapsedSeconds / 60);
                const secs = elapsedSeconds % 60;
                const timeStr = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

                document.getElementById("astroSessionTimer").innerText = timeStr;
                document.getElementById("modalAstroElapsed").innerText = timeStr;

                const billedMinutes = Math.max(1, Math.ceil(elapsedSeconds / 60));
                const gross = (billedMinutes * ratePerMinute);
                const net = gross * ((100 - commissionPct) / 100);

                document.getElementById("astroGrossBilled").innerText = "₹" + gross.toFixed(2);
                document.getElementById("astroNetEarnings").innerText = "₹" + net.toFixed(2);
                document.getElementById("modalAstroEarn").innerText = "₹" + net.toFixed(2);
            }, 1000);
        }

        // Initialize SignalR
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/consultation")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveMessage", function (msg) {
            appendAstroMessage(msg.senderName, msg.message, msg.senderType === "ASTROLOGER");
        });

        connection.on("UserTyping", function (data) {
            const elem = document.getElementById("astroTypingIndicator");
            if (elem) elem.style.display = data.isTyping ? "block" : "none";
        });

        connection.on("SessionAccepted", function (data) {
            console.log("Astrologer SessionAccepted:", data);
            document.getElementById("astroConnectionStatus").innerText = "Live";
            document.getElementById("astroConnectionStatus").className = "badge bg-success";
            startAstroTimer();
            startAstroHeartbeat();
            if (sessionType === 'VIDEO' || sessionType === 'AUDIO') {
                setTimeout(() => initAstroWebRTC(), 800);
            }
        });

        connection.on("SessionEnded", function (data) {
            clearInterval(timerInterval);
            stopAstroHeartbeat();
            closeAstroWebRTC();
            const mins = Math.floor((data.durationSeconds || 0) / 60);
            const secs = (data.durationSeconds || 0) % 60;
            alert(`Consultation ended. Total Duration: ${mins}m ${secs}s. Net Earnings: ₹${(data.astrologerEarnings || 0).toFixed(2)}`);
            window.location.href = "/Astrologer/Home";
        });

        connection.on("UserJoinedSession", function (data) {
            console.log("Seeker joined/reconnected:", data.displayName);
            if (sessionType === 'VIDEO' || sessionType === 'AUDIO') {
                setTimeout(() => createAndSendAstroOffer(), 1200);
            }
        });

        connection.on("ReceiveMediaOfferRequest", async function () {
            console.log("Seeker requested media offer, creating offer...");
            if (sessionType === 'VIDEO' || sessionType === 'AUDIO') {
                await createAndSendAstroOffer();
            }
        });

        // WebRTC Signaling
        connection.on("ReceiveMediaAnswer", async function (answer) {
            console.log("Astrologer received answer:", answer);
            if (astroPeerConnection) {
                try {
                    const desc = new RTCSessionDescription({
                        type: (answer.type || answer.Type || 'answer').toLowerCase(),
                        sdp: answer.sdp || answer.Sdp
                    });
                    await astroPeerConnection.setRemoteDescription(desc);
                    await drainAstroIceCandidates();
                } catch (err) {
                    console.error("Error setting remote answer:", err);
                }
            }
        });

        connection.on("ReceiveIceCandidate", async function (candidate) {
            if (!candidate) return;
            await addAstroIceCandidateSafely(candidate);
        });

        connection.start()
            .then(function () {
                document.getElementById("astroConnectionStatus").innerText = "Live";
                document.getElementById("astroConnectionStatus").className = "badge bg-success";
                connection.invoke("JoinSessionGroup", sessionPublicId);

                if (sessionStatus === 'ACTIVE') {
                    startAstroTimer();
                    startAstroHeartbeat();
                    if (sessionType === 'VIDEO' || sessionType === 'AUDIO') {
                        setTimeout(() => initAstroWebRTC(), 1000);
                    }
                    const now = Math.floor(Date.now() / 1000);
                    connection.invoke("BroadcastSessionAccepted", sessionPublicId, now).catch(() => {});
                }
            })
            .catch(function (err) {
                console.error("SignalR Error: ", err);
                document.getElementById("astroConnectionStatus").innerText = "Offline Mode";
                document.getElementById("astroConnectionStatus").className = "badge bg-danger";
            });

        // ===================== HEARTBEAT =====================
        let astroHeartbeatInterval = null;
        function startAstroHeartbeat() {
            if (astroHeartbeatInterval) return;
            astroHeartbeatInterval = setInterval(() => {
                if (connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("Ping", sessionPublicId).catch(() => {});
                }
            }, 30000);
        }
        function stopAstroHeartbeat() {
            if (astroHeartbeatInterval) { clearInterval(astroHeartbeatInterval); astroHeartbeatInterval = null; }
        }

        window.addEventListener("beforeunload", function () {
            stopAstroHeartbeat();
            closeAstroWebRTC();
        });

        // ===================== CHAT =====================
        function appendAstroMessage(sender, text, isMe) {
            const box = document.getElementById("astroChatMessages");
            const div = document.createElement("div");
            div.className = isMe ? "d-flex justify-content-end mb-2" : "d-flex justify-content-start mb-2";

            div.innerHTML = `
                <div class="p-3 rounded-4 shadow-sm" style="max-width: 80%; background-color: ${isMe ? '#e5a93b' : '#1e2642'}; color: ${isMe ? '#0c0f1d' : '#ffffff'};">
                    <div class="small fw-bold opacity-75 mb-1">${sender}</div>
                    <div style="font-size: 0.95rem;">${text}</div>
                </div>
            `;
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        }

        function sendAstroMessage() {
            const input = document.getElementById("astroChatInput");
            const text = input.value.trim();
            if (!text) return;

            connection.invoke("SendMessage", sessionPublicId, text)
                .then(() => { input.value = ""; })
                .catch(err => {
                    appendAstroMessage("You", text, true);
                    input.value = "";
                });
        }

        function handleAstroKeyPress(e) {
            if (e.key === "Enter") sendAstroMessage();
        }

        // ===================== WebRTC (Astrologer = Caller) =====================
        let astroPeerConnection = null;
        let astroLocalStream = null;
        let isInitializingAstroWebRTC = false;
        let astroRemoteIceQueue = [];

        const iceServers = {
            iceServers: [
                { urls: "stun:stun.l.google.com:19302" },
                { urls: "stun:stun1.l.google.com:19302" },
                { urls: "stun:stun2.l.google.com:19302" },
                { urls: "stun:stun3.l.google.com:19302" },
                { urls: "stun:stun4.l.google.com:19302" },
                { urls: "stun:stun.cloudflare.com:3478" }
            ]
        };

        async function getAstroMediaStream(isVideo) {
            if (!isVideo) {
                return await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
            }
            try {
                return await navigator.mediaDevices.getUserMedia({
                    audio: true,
                    video: {
                        width: { ideal: 1280, max: 1920 },
                        height: { ideal: 720, max: 1080 }
                    }
                });
            } catch (err1) {
                console.warn("Retrying astrologer media with basic constraints:", err1);
                try {
                    return await navigator.mediaDevices.getUserMedia({ audio: true, video: true });
                } catch (err2) {
                    console.error("Failed to acquire astrologer media:", err2);
                    throw err2;
                }
            }
        }

        function parseAstroCandidate(raw) {
            if (!raw) return null;
            const candStr = raw.candidate ?? raw.Candidate;
            if (candStr === undefined || candStr === null || (candStr !== '' && typeof candStr !== 'string')) return null;
            return new RTCIceCandidate({
                candidate: candStr,
                sdpMid: raw.sdpMid ?? raw.SdpMid ?? null,
                sdpMLineIndex: raw.sdpMLineIndex ?? raw.SdpMLineIndex ?? 0
            });
        }

        async function addAstroIceCandidateSafely(candidate) {
            const ice = parseAstroCandidate(candidate);
            if (!ice) return;
            if (astroPeerConnection && astroPeerConnection.remoteDescription && astroPeerConnection.remoteDescription.type) {
                try {
                    await astroPeerConnection.addIceCandidate(ice);
                } catch (e) {
                    console.warn("Astro addIceCandidate error:", e);
                }
            } else {
                astroRemoteIceQueue.push(ice);
            }
        }

        async function drainAstroIceCandidates() {
            if (!astroPeerConnection) return;
            while (astroRemoteIceQueue.length > 0) {
                const ice = astroRemoteIceQueue.shift();
                try {
                    await astroPeerConnection.addIceCandidate(ice);
                } catch (e) {
                    console.warn("Astro drain candidate error:", e);
                }
            }
        }

        async function initAstroWebRTC() {
            if (astroPeerConnection) return astroPeerConnection;
            if (isInitializingAstroWebRTC) return;
            isInitializingAstroWebRTC = true;

            try {
                const isVideo = sessionType === 'VIDEO';
                astroLocalStream = await getAstroMediaStream(isVideo);

                // Show local video PiP
                if (isVideo) {
                    const localContainer = document.getElementById('localParticipantCard');
                    if (localContainer) {
                        localContainer.innerHTML = '';
                        const localVid = document.createElement('video');
                        localVid.srcObject = astroLocalStream;
                        localVid.autoplay = true;
                        localVid.muted = true;
                        localVid.defaultMuted = true;
                        localVid.setAttribute('muted', '');
                        localVid.playsInline = true;
                        localVid.setAttribute('playsinline', '');
                        localVid.style.cssText = 'width: 100%; height: 100%; object-fit: cover; border-radius: 8px;';
                        localContainer.appendChild(localVid);
                        localVid.play().catch(() => {});
                    }
                }

                astroPeerConnection = new RTCPeerConnection(iceServers);
                astroLocalStream.getTracks().forEach(track => astroPeerConnection.addTrack(track, astroLocalStream));

                astroPeerConnection.onicecandidate = (event) => {
                    if (event.candidate) {
                        connection.invoke("SignalIceCandidate", sessionPublicId, {
                            candidate: event.candidate.candidate,
                            sdpMid: event.candidate.sdpMid,
                            sdpMLineIndex: event.candidate.sdpMLineIndex
                        });
                    }
                };

                astroPeerConnection.onconnectionstatechange = () => {
                    console.log("Astrologer WebRTC state:", astroPeerConnection.connectionState);
                    if (astroPeerConnection.connectionState === 'connected') {
                        const placeholder = document.getElementById('remoteParticipantCard');
                        if (placeholder) { placeholder.style.display = 'none'; placeholder.classList.add('d-none'); }
                        applyAdaptiveBitrate(astroPeerConnection);
                    }
                };

                astroPeerConnection.oniceconnectionstatechange = () => {
                    console.log("Astrologer ICE state:", astroPeerConnection.iceConnectionState);
                    const statusBadge = document.getElementById("astroConnectionStatus");
                    if (astroPeerConnection.iceConnectionState === 'disconnected') {
                        if (statusBadge) {
                            statusBadge.innerText = "Network Slow / Reconnecting...";
                            statusBadge.className = "badge bg-warning text-dark";
                        }
                        // Try graceful auto-reconnect if network dipped
                        setTimeout(() => {
                            if (astroPeerConnection && astroPeerConnection.iceConnectionState === 'disconnected') {
                                createAndSendAstroOffer(true);
                            }
                        }, 3000);
                    } else if (astroPeerConnection.iceConnectionState === 'connected' || astroPeerConnection.iceConnectionState === 'completed') {
                        if (statusBadge) {
                            statusBadge.innerText = "Live";
                            statusBadge.className = "badge bg-success";
                        }
                    }
                };

                astroPeerConnection.ontrack = (event) => {
                    console.log("Astrologer received track:", event.track.kind);
                    const placeholder = document.getElementById('remoteParticipantCard');
                    if (placeholder) {
                        placeholder.style.display = 'none';
                        placeholder.classList.add('d-none');
                    }
                    const container = document.getElementById('videoContainer');

                    if (event.track.kind === 'video') {
                        let remoteVid = document.getElementById('remoteVideoEl');
                        if (!remoteVid) {
                            remoteVid = document.createElement('video');
                            remoteVid.id = 'remoteVideoEl';
                            remoteVid.autoplay = true;
                            remoteVid.playsInline = true;
                            remoteVid.setAttribute('playsinline', '');
                            remoteVid.muted = true;
                            remoteVid.defaultMuted = true;
                            remoteVid.setAttribute('muted', '');
                            remoteVid.style.cssText = 'width: 100%; height: 100%; object-fit: cover; border-radius: 12px; position: absolute; top: 0; left: 0; z-index: 5;';
                            container.appendChild(remoteVid);
                        }
                        if (event.streams && event.streams[0]) {
                            remoteVid.srcObject = event.streams[0];
                        } else {
                            if (!remoteVid.srcObject) remoteVid.srcObject = new MediaStream();
                            remoteVid.srcObject.addTrack(event.track);
                        }
                        remoteVid.play().catch(e => console.warn("Video play notice:", e));
                    } else if (event.track.kind === 'audio') {
                        let remoteAudio = document.getElementById('remoteAudioEl');
                        if (!remoteAudio) {
                            remoteAudio = document.createElement('audio');
                            remoteAudio.id = 'remoteAudioEl';
                            remoteAudio.autoplay = true;
                            document.body.appendChild(remoteAudio);
                        }
                        if (event.streams && event.streams[0]) {
                            remoteAudio.srcObject = event.streams[0];
                        } else {
                            if (!remoteAudio.srcObject) remoteAudio.srcObject = new MediaStream();
                            remoteAudio.srcObject.addTrack(event.track);
                        }
                        remoteAudio.play().catch(e => console.warn("Audio play notice:", e));
                    }
                };

                return astroPeerConnection;

            } catch (err) {
                console.error("Astrologer Camera/Mic access error:", err);
                alert("Could not access camera or microphone. Please allow permissions in your browser.");
                return null;
            } finally {
                isInitializingAstroWebRTC = false;
            }
        }

        function applyAdaptiveBitrate(pc) {
            if (!pc) return;
            try {
                pc.getSenders().forEach(sender => {
                    if (sender.track && sender.track.kind === 'video') {
                        const params = sender.getParameters();
                        if (!params.encodings || params.encodings.length === 0) params.encodings = [{}];
                        params.degradationPreference = 'balanced';
                        params.encodings[0].maxBitrate = 800000; // max 800kbps (HD)
                        params.encodings[0].minBitrate = 80000;  // floor 80kbps (auto downscale without freeze on slow net)
                        sender.setParameters(params).catch(() => {});
                    } else if (sender.track && sender.track.kind === 'audio') {
                        const params = sender.getParameters();
                        if (!params.encodings || params.encodings.length === 0) params.encodings = [{}];
                        params.encodings[0].maxBitrate = 36000; // 36kbps Opus voice priority
                        sender.setParameters(params).catch(() => {});
                    }
                });
            } catch (e) {
                console.warn("Adaptive bitrate notice:", e);
            }
        }

        async function createAndSendAstroOffer(restartIce = false) {
            if (!astroPeerConnection) {
                await initAstroWebRTC();
            }
            if (!astroPeerConnection) return;
            if (!restartIce && astroPeerConnection.signalingState === "have-local-offer") {
                console.log("Astrologer already has local offer pending answer, skipping duplicate offer.");
                return;
            }
            try {
                const offer = await astroPeerConnection.createOffer({
                    iceRestart: restartIce,
                    offerToReceiveAudio: true,
                    offerToReceiveVideo: sessionType === 'VIDEO'
                });
                await astroPeerConnection.setLocalDescription(offer);
                connection.invoke("SignalMediaOffer", sessionPublicId, {
                    type: offer.type,
                    sdp: offer.sdp
                });
                console.log("Astrologer offer sent successfully (iceRestart=" + restartIce + ")");
                applyAdaptiveBitrate(astroPeerConnection);
            } catch (e) {
                console.error("Error creating astrologer offer:", e);
            }
        }

        function ensureAudioPlaying() {
            const audioEl = document.getElementById('remoteAudioEl');
            if (audioEl && audioEl.paused && audioEl.srcObject) {
                audioEl.play().catch(() => {});
            }
        }
        document.addEventListener('click', ensureAudioPlaying, { passive: true });
        document.addEventListener('touchstart', ensureAudioPlaying, { passive: true });

        function closeAstroWebRTC() {
            if (astroLocalStream) {
                astroLocalStream.getTracks().forEach(t => t.stop());
                astroLocalStream = null;
            }
            if (astroPeerConnection) {
                astroPeerConnection.close();
                astroPeerConnection = null;
            }
            astroRemoteIceQueue = [];
            isInitializingAstroWebRTC = false;
        }

        let isAudioMuted = false;
        async function toggleAudio() {
            isAudioMuted = !isAudioMuted;
            const btn = document.getElementById('micToggleBtn');
            btn.innerHTML = isAudioMuted
                ? '<i class="fa-solid fa-microphone-slash text-danger fs-5"></i>'
                : '<i class="fa-solid fa-microphone fs-5"></i>';
            if (astroLocalStream) {
                astroLocalStream.getAudioTracks().forEach(t => t.enabled = !isAudioMuted);
            }
        }

        let isVideoOff = false;
        async function toggleVideo() {
            isVideoOff = !isVideoOff;
            const btn = document.getElementById('camToggleBtn');
            btn.innerHTML = isVideoOff
                ? '<i class="fa-solid fa-video-slash text-danger fs-5"></i>'
                : '<i class="fa-solid fa-video fs-5"></i>';
            if (astroLocalStream) {
                astroLocalStream.getVideoTracks().forEach(t => t.enabled = !isVideoOff);
            }
        }
    </script>
}
