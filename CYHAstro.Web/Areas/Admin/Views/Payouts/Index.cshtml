@model IReadOnlyList<CYHAstro.Core.DTOs.Admin.SettlementDto>
@{
    ViewData["Title"] = "Astrologer Payout Settlements";
    var currentStatus = ViewBag.Status as string;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="text-white fw-bold mb-1">Astrologer Payout & Settlements</h3>
            <p class="text-secondary small mb-0">Review astrologer withdrawal requests, disburse via UPI/NEFT, and record bank UTR references.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-dark border border-warning text-warning px-3 py-2 d-flex align-items-center">
                Total Requests: <strong class="ms-1">@(Model?.Count ?? 0)</strong>
            </span>
        </div>
    </div>

    <!-- Filter Buttons -->
    <div class="card admin-card p-3 mb-4">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="text-secondary small fw-bold text-uppercase me-2"><i class="fa-solid fa-filter text-warning me-1"></i> Filter Status:</span>
            <a asp-action="Index" asp-route-status=""
               class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-gold" : "btn-outline-secondary")">
                All Payouts
            </a>
            <a asp-action="Index" asp-route-status="PENDING"
               class="btn btn-sm @(currentStatus == "PENDING" ? "btn-gold" : "btn-outline-secondary")">
                Pending Approval
            </a>
            <a asp-action="Index" asp-route-status="COMPLETED"
               class="btn btn-sm @(currentStatus == "COMPLETED" ? "btn-gold" : "btn-outline-secondary")">
                Completed / Paid
            </a>
            <a asp-action="Index" asp-route-status="REJECTED"
               class="btn btn-sm @(currentStatus == "REJECTED" ? "btn-gold" : "btn-outline-secondary")">
                Rejected
            </a>
        </div>
    </div>

    <!-- Settlements Table -->
    <div class="card admin-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-admin mb-0">
                <thead>
                    <tr>
                        <th>Req ID</th>
                        <th>Astrologer</th>
                        <th>Amount</th>
                        <th>Mode</th>
                        <th>Beneficiary Details</th>
                        <th>UTR / Reference</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="font-monospace text-warning">@s.PublicId</td>
                                <td class="text-white fw-bold">@s.AstrologerName</td>
                                <td class="text-success fw-bold fs-6">₹@s.Amount.ToString("F2")</td>
                                <td>
                                    <span class="badge bg-dark border border-secondary text-info">@s.PayoutMethod</span>
                                </td>
                                <td class="text-light small" style="max-width: 250px;">
                                    @(string.IsNullOrWhiteSpace(s.Remarks) ? "—" : s.Remarks)
                                </td>
                                <td class="font-monospace text-warning small">
                                    @(string.IsNullOrWhiteSpace(s.PayoutReference) ? "Pending" : s.PayoutReference)
                                </td>
                                <td>
                                    @if (s.Status == "COMPLETED")
                                    {
                                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Completed</span>
                                    }
                                    else if (s.Status == "REJECTED")
                                    {
                                        <span class="badge bg-danger"><i class="fa-solid fa-xmark me-1"></i> Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> Pending</span>
                                    }
                                </td>
                                <td class="text-secondary small">@s.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td class="text-end">
                                    @if (s.Status == "PENDING")
                                    {
                                        <button type="button" class="btn btn-sm btn-gold fw-bold" data-bs-toggle="modal" data-bs-target="#processModal_@s.Id">
                                            Process Payout
                                        </button>

                                        <!-- Process Modal -->
                                        <div class="modal fade" id="processModal_@s.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered text-start">
                                                <div class="modal-content bg-dark border border-warning text-light">
                                                    <div class="modal-header border-secondary">
                                                        <h5 class="modal-title text-warning brand-font">Process Payout #@s.PublicId</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form asp-action="Process" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@s.Id" />
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <span class="text-secondary small d-block">Astrologer:</span>
                                                                <strong class="text-white">@s.AstrologerName</strong>
                                                            </div>
                                                            <div class="mb-3">
                                                                <span class="text-secondary small d-block">Payout Amount:</span>
                                                                <strong class="text-success fs-5">₹@s.Amount.ToString("F2")</strong>
                                                            </div>
                                                            <div class="mb-3">
                                                                <span class="text-secondary small d-block">Bank / UPI Details:</span>
                                                                <span class="text-warning">@s.Remarks</span>
                                                            </div>

                                                            <div class="mb-3">
                                                                <label class="form-label small fw-bold text-light">Action Decision *</label>
                                                                <select name="status" class="form-select bg-black border-secondary text-light" required>
                                                                    <option value="COMPLETED" selected>Mark as Completed / Paid</option>
                                                                    <option value="REJECTED">Reject Withdrawal Request</option>
                                                                </select>
                                                            </div>

                                                            <div class="mb-3">
                                                                <label class="form-label small fw-bold text-light">Bank UTR / UPI Ref ID</label>
                                                                <input type="text" name="payoutReference" class="form-control bg-black border-secondary text-warning" placeholder="e.g. UTR20261113098234" />
                                                            </div>

                                                            <div class="mb-3">
                                                                <label class="form-label small fw-bold text-light">Admin Notes / Remarks</label>
                                                                <textarea name="remarks" rows="2" class="form-control bg-black border-secondary text-light" placeholder="Optional notes for audit"></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-secondary">
                                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-gold fw-bold">Confirm & Save</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small">Processed</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-secondary py-5">
                                <i class="fa-solid fa-money-check-dollar fs-3 mb-2 d-block"></i>
                                No settlement requests found matching the filter.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
