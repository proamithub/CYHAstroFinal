@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CYHAstro Admin Console</title>

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- Admin Console Custom Theme -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="sidebar-brand">
                <span class="text-warning fs-4"><i class="fa-solid fa-shield-halved"></i></span>
                <div>
                    <span class="text-white fw-bold">CYH<span class="text-warning">Astro</span></span>
                    <span class="badge bg-danger ms-1 text-uppercase" style="font-size: 0.65rem;">Admin</span>
                </div>
            </div>

            <div class="sidebar-nav">
                <div class="text-uppercase small text-secondary px-3 py-2 fw-semibold" style="letter-spacing: 1px;">Platform Core</div>
                
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-chart-line text-warning"></i>
                    <span>Dashboard</span>
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Astrologers" ? "active" : "")"
                   asp-controller="Astrologers" asp-action="Index">
                    <i class="fa-solid fa-user-astronaut text-info"></i>
                    <span>Astrologers</span>
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Packages" ? "active" : "")"
                   asp-controller="Packages" asp-action="Index">
                    <i class="fa-solid fa-cubes text-warning"></i>
                    <span>Recharge Packages</span>
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transactions" ? "active" : "")"
                   asp-controller="Transactions" asp-action="Index">
                    <i class="fa-solid fa-receipt text-success"></i>
                    <span>Financial Ledger</span>
                </a>

                <div class="text-uppercase small text-secondary px-3 pt-3 pb-2 fw-semibold" style="letter-spacing: 1px;">External</div>
                
                <a class="nav-link" href="/" target="_blank">
                    <i class="fa-solid fa-globe text-primary"></i>
                    <span>Client Portal</span>
                    <i class="fa-solid fa-arrow-up-right-from-square ms-auto small text-secondary"></i>
                </a>
            </div>

            <div class="sidebar-footer d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px;">
                        A
                    </div>
                    <div class="small text-truncate" style="max-width: 130px;">
                        <span class="d-block text-white fw-medium">@(User.Identity?.Name ?? "Administrator")</span>
                        <span class="text-secondary small">Super Admin</span>
                    </div>
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Sign Out">
                        <i class="fa-solid fa-power-off"></i>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="admin-main">
            <!-- Topbar -->
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-secondary d-lg-none" type="button" onclick="document.getElementById('adminSidebar').classList.toggle('show')">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h5 class="mb-0 text-white fw-bold">@ViewData["Title"]</h5>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-3 py-2">
                        <i class="fa-solid fa-circle me-1" style="font-size: 8px;"></i> LiveKit & Redis Ready
                    </span>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-sm btn-outline-danger">
                        <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Sign Out
                    </a>
                </div>
            </header>

            <!-- Page Body -->
            <main class="admin-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="p-3 text-secondary text-center small border-top border-secondary border-opacity-25 bg-black bg-opacity-30">
                &copy; @DateTime.UtcNow.Year CYHAstro Enterprise Management Console | .NET 10 LTS LTS Platform
            </footer>
        </div>
    }
    else
    {
        <!-- Minimal Layout for Login / AccessDenied -->
        <main>
            @RenderBody()
        </main>
    }

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
