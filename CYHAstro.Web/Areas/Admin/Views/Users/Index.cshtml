@model IReadOnlyList<CYHAstro.Core.DTOs.Admin.AdminUserDto>
@{
    ViewData["Title"] = "User & Seeker Management";
    var search = ViewBag.Search as string;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="text-white fw-bold mb-1">Seeker & User Directory</h3>
            <p class="text-secondary small mb-0">Manage registered clients, inspect wallet balances, and manage account access.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-dark border border-warning text-warning px-3 py-2 d-flex align-items-center">
                Total Users: <strong class="ms-1">@(Model?.Count ?? 0)</strong>
            </span>
        </div>
    </div>

    <!-- Search Toolbar -->
    <div class="card admin-card p-3 mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-black border-secondary text-warning"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="search" class="form-control bg-black text-light border-secondary"
                           placeholder="Search by user name, email, or phone number..." value="@search" />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-warning w-100 btn-sm fw-bold">
                    Search Users
                </button>
            </div>
        </form>
    </div>

    <!-- Users Table -->
    <div class="card admin-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-admin mb-0">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Seeker Name</th>
                        <th>Email Address</th>
                        <th>Phone</th>
                        <th>Main Balance</th>
                        <th>Promo Balance</th>
                        <th>Status</th>
                        <th>Registered Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td class="font-monospace text-warning small">@u.PublicId</td>
                                <td class="text-white fw-bold">@u.DisplayName</td>
                                <td class="text-light small">@u.Email</td>
                                <td class="text-secondary small">@(string.IsNullOrWhiteSpace(u.PhoneNumber) ? "—" : u.PhoneNumber)</td>
                                <td class="fw-bold text-success">₹@u.MainBalance.ToString("F2")</td>
                                <td class="text-info small">₹@u.PromotionalBalance.ToString("F2")</td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-25 text-danger">Suspended</span>
                                    }
                                </td>
                                <td class="text-secondary small">@u.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <form asp-action="ToggleStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <input type="hidden" name="isActive" value="@(u.IsActive ? "false" : "true")" />
                                        <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                title="@(u.IsActive ? "Suspend User" : "Activate User")">
                                            <i class="fa-solid @(u.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                            @(u.IsActive ? "Suspend" : "Activate")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-secondary py-5">
                                <i class="fa-solid fa-users-slash fs-3 mb-2 d-block"></i>
                                No users found matching the query.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
