@model CYHAstro.Core.DTOs.Scans.AstroScanDetailDto
@{
    ViewData["Title"] = $"{Model.Report?.Title ?? "वैदिक विश्लेषण रिपोर्ट"} - CYHAstro";
    var report = Model.Report ?? new CYHAstro.Core.DTOs.Scans.AstroScanReportDto();
}

<div class="container py-4">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-warning text-decoration-none">स्कैन हब</a></li>
                <li class="breadcrumb-item active text-secondary" aria-current="page">@(Model.ScanType == "PALM" ? "हस्तरेखा" : "सामुद्रिक मस्तक") रिपोर्ट</li>
            </ol>
        </nav>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-warning btn-sm">
                <i class="fa-solid fa-print me-1"></i> प्रिंट / PDF सेव करें
            </button>
            <a asp-action="@(Model.ScanType == "PALM" ? "Palm" : "Head")" class="btn btn-warning btn-sm fw-bold">
                <i class="fa-solid fa-camera-rotate me-1"></i> नया स्कैन करें
            </a>
        </div>
    </div>

    <!-- Hero Card -->
    <div class="card bg-dark border-secondary shadow-lg rounded-4 overflow-hidden mb-4" style="background: radial-gradient(circle at 100% 0%, rgba(255, 193, 7, 0.12) 0%, rgba(16, 21, 31, 0.95) 70%);">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="badge @(Model.ScanType == "PALM" ? "bg-warning text-dark" : "bg-info text-dark") px-3 py-1 fw-bold">
                            @(Model.ScanType == "PALM" ? "✋ वैदिक हस्तरेखा विश्लेषण" : "👤 सामुद्रिक मस्तक लक्षण")
                        </span>
                        @if (!string.IsNullOrEmpty(report.HandOrFaceType))
                        {
                            <span class="badge bg-secondary text-white px-3 py-1">
                                @report.HandOrFaceType
                            </span>
                        }
                        @if (Model.IsAdminReviewed)
                        {
                            <span class="badge bg-success text-white px-2 py-1">
                                <i class="fa-solid fa-certificate me-1"></i> ज्योतिषी द्वारा सत्यापित
                            </span>
                        }
                    </div>

                    <h2 class="display-6 fw-bold text-white brand-font mb-2">
                        @(report.Title ?? $"{Model.ScanType} वैदिक विश्लेषण")
                    </h2>

                    <div class="text-secondary small mb-3">
                        विश्लेषण तिथि: <span class="text-white">@Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy, hh:mm tt")</span>
                        @if (!string.IsNullOrEmpty(Model.BirthProfileName))
                        {
                            <span class="ms-2">| कुंडली: <span class="text-warning">@Model.BirthProfileName</span></span>
                        }
                    </div>

                    <p class="text-light mb-0 lead" style="font-size: 1.1rem; line-height: 1.7;">
                        @report.OverviewSummary
                    </p>
                </div>

                <!-- Auspicious Meter Circle -->
                <div class="col-lg-4 text-center">
                    <div class="p-4 rounded-4 bg-black bg-opacity-40 border border-secondary d-inline-block w-100" style="max-width: 280px;">
                        <span class="text-secondary small d-block mb-1 text-uppercase fw-semibold" style="letter-spacing: 0.5px;">शुभता गुणांक (Auspicious Score)</span>
                        <div class="display-4 fw-bold text-warning mb-1">
                            @report.OverallAuspiciousnessScore<span class="fs-4 text-secondary">%</span>
                        </div>
                        <div class="progress mb-3 bg-secondary" style="height: 8px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: @report.OverallAuspiciousnessScore%"></div>
                        </div>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-3 py-1">
                            <i class="fa-solid fa-sparkles me-1"></i> अत्यंत अनुकूल योग
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area: Left Image Preview + Right Tabs -->
    <div class="row g-4">
        
        <!-- Left Sidebar: Photo & Meta -->
        <div class="col-lg-4">
            <div class="card bg-dark border-secondary shadow-sm rounded-4 overflow-hidden mb-4 sticky-top" style="top: 90px;">
                <div class="card-header bg-secondary bg-opacity-25 border-secondary d-flex justify-content-between align-items-center">
                    <span class="text-white fw-bold"><i class="fa-solid fa-image text-warning me-2"></i>स्कैन की गई फोटो</span>
                    <span class="badge bg-secondary text-white">ID: @Model.PublicId.Substring(0, 8)</span>
                </div>
                <div class="card-body p-3 text-center">
                    <div class="position-relative overflow-hidden rounded-3 border border-secondary shadow-sm mb-3" style="background: #0a0d14;">
                        <img src="@Model.ImageUrl" alt="Scanned Image" class="img-fluid w-100" style="max-height: 380px; object-fit: contain;" />
                    </div>
                    <a href="@Model.ImageUrl" target="_blank" class="btn btn-sm btn-outline-secondary w-100">
                        <i class="fa-solid fa-magnifying-glass-plus me-1"></i> फुल स्क्रीन में देखें
                    </a>
                </div>

                <!-- Astrologer Verified Box if available -->
                @if (Model.IsAdminReviewed && !string.IsNullOrEmpty(Model.AdminNotes))
                {
                    <div class="card-footer bg-success bg-opacity-10 border-top border-success border-opacity-25 p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fa-solid fa-user-check text-success fs-5"></i>
                            <span class="text-success fw-bold">वरिष्ठ ज्योतिषी परामर्श</span>
                        </div>
                        <p class="text-light small mb-0" style="line-height: 1.6;">
                            @Model.AdminNotes
                        </p>
                    </div>
                }
            </div>
        </div>

        <!-- Right Side: Detailed Tabs -->
        <div class="col-lg-8">
            <div class="card bg-dark border-secondary shadow-sm rounded-4 overflow-hidden mb-4">
                <!-- Nav Tabs -->
                <div class="card-header bg-secondary bg-opacity-25 border-secondary p-2">
                    <ul class="nav nav-pills nav-pills-cosmic card-header-pills gap-1 flex-nowrap overflow-x-auto pb-1" id="reportTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active text-white fw-semibold" id="features-tab" data-bs-toggle="tab" data-bs-target="#features" type="button" role="tab">
                                <i class="fa-solid fa-bezier-curve text-warning me-1"></i> रेखाएं एवं लक्षण
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link text-white fw-semibold" id="aspects-tab" data-bs-toggle="tab" data-bs-target="#aspects" type="button" role="tab">
                                <i class="fa-solid fa-compass text-info me-1"></i> जीवन के 4 आयाम
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link text-white fw-semibold" id="remedies-tab" data-bs-toggle="tab" data-bs-target="#remedies" type="button" role="tab">
                                <i class="fa-solid fa-om text-danger me-1"></i> वैदिक उपाय व रत्न
                            </button>
                        </li>
                        @if (!string.IsNullOrEmpty(report.KundliCorrelationAnalysis))
                        {
                            <li class="nav-item" role="presentation">
                                <button class="nav-link text-white fw-semibold" id="kundli-tab" data-bs-toggle="tab" data-bs-target="#kundli" type="button" role="tab">
                                    <i class="fa-solid fa-certificate text-warning me-1"></i> कुंडली समन्वय
                                </button>
                            </li>
                        }
                    </ul>
                </div>

                <div class="card-body p-4">
                    <div class="tab-content" id="reportTabsContent">
                        
                        <!-- TAB 1: Lines & Features -->
                        <div class="tab-pane fade show active" id="features" role="tabpanel">
                            
                            <!-- Key Highlights Bullets -->
                            @if (report.KeyHighlights != null && report.KeyHighlights.Any())
                            {
                                <div class="p-3 rounded-3 bg-warning bg-opacity-10 border border-warning border-opacity-25 mb-4">
                                    <h6 class="text-warning fw-bold mb-3"><i class="fa-solid fa-star me-2"></i>प्रमुख योग एवं विशेषताएं (Key Highlights)</h6>
                                    <div class="row g-2">
                                        @foreach (var h in report.KeyHighlights)
                                        {
                                            <div class="col-md-6">
                                                <div class="d-flex align-items-center gap-2 text-white small">
                                                    <i class="fa-solid fa-circle-check text-warning flex-shrink-0"></i>
                                                    <span>@h</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Primary Features Grid -->
                            <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-fingerprint text-warning me-2"></i>प्रमुख रेखाओं का सूक्ष्म विश्लेषण</h5>
                            <div class="d-flex flex-column gap-3 mb-4">
                                @if (report.PrimaryFeatures != null)
                                {
                                    foreach (var f in report.PrimaryFeatures)
                                    {
                                        <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-secondary">
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                                <div>
                                                    <span class="text-warning fw-bold fs-6">@f.Name</span>
                                                    @if (!string.IsNullOrEmpty(f.SanskritName))
                                                    {
                                                        <span class="badge bg-secondary text-white-50 ms-2">@f.SanskritName</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(f.AuspiciousSign))
                                                    {
                                                        <span class="badge bg-success bg-opacity-50 text-white ms-1">
                                                            <i class="fa-solid fa-om me-1"></i>@f.AuspiciousSign
                                                        </span>
                                                    }
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-secondary text-white">@f.Status</span>
                                                    <span class="badge bg-warning text-dark fw-bold">बल: @f.StrengthScore%</span>
                                                </div>
                                            </div>
                                            <p class="text-light small mb-2" style="line-height: 1.6;">@f.Details</p>
                                            <div class="text-secondary small" style="font-size: 0.78rem;">
                                                <i class="fa-solid fa-circle-info me-1 text-info"></i>ज्योतिषीय महत्व: @f.Significance
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Secondary Features / Mounts -->
                            @if (report.SecondaryFeatures != null && report.SecondaryFeatures.Any())
                            {
                                <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-mountain text-info me-2"></i>पर्वत एवं सहायक लक्षण</h5>
                                <div class="row g-3">
                                    @foreach (var sf in report.SecondaryFeatures)
                                    {
                                        <div class="col-md-6">
                                            <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-secondary h-100">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="text-info fw-bold">@sf.Name</span>
                                                    <span class="badge bg-secondary text-white small">@sf.StrengthScore%</span>
                                                </div>
                                                <p class="text-light small mb-2" style="line-height: 1.6;">@sf.Details</p>
                                                <div class="text-secondary small" style="font-size: 0.75rem;">
                                                    @sf.Significance
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                        </div>

                        <!-- TAB 2: Life Aspects -->
                        <div class="tab-pane fade" id="aspects" role="tabpanel">
                            <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-compass text-info me-2"></i>जीवन के प्रमुख क्षेत्रों में प्रभाव</h5>
                            <div class="row g-4">
                                @if (report.LifeAspects != null)
                                {
                                    foreach (var aspect in report.LifeAspects)
                                    {
                                        <div class="col-12">
                                            <div class="p-4 rounded-3 bg-black bg-opacity-40 border border-secondary">
                                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                                    <div class="d-flex align-items-center gap-2">
                                                        @if (aspect.Category == "Career")
                                                        {
                                                            <div class="p-2 rounded bg-warning bg-opacity-10 text-warning"><i class="fa-solid fa-briefcase fs-5"></i></div>
                                                        }
                                                        else if (aspect.Category == "Wealth")
                                                        {
                                                            <div class="p-2 rounded bg-success bg-opacity-10 text-success"><i class="fa-solid fa-coins fs-5"></i></div>
                                                        }
                                                        else if (aspect.Category == "Health")
                                                        {
                                                            <div class="p-2 rounded bg-danger bg-opacity-10 text-danger"><i class="fa-solid fa-heart-pulse fs-5"></i></div>
                                                        }
                                                        else
                                                        {
                                                            <div class="p-2 rounded bg-info bg-opacity-10 text-info"><i class="fa-solid fa-hand-holding-heart fs-5"></i></div>
                                                        }
                                                        <div>
                                                            <h6 class="text-white fw-bold mb-0">@aspect.HindiTitle</h6>
                                                            <span class="text-secondary small">@aspect.Category Forecast</span>
                                                        </div>
                                                    </div>
                                                    <span class="badge bg-success bg-opacity-50 text-white px-3 py-2">
                                                        @aspect.FavorabilityScore% अनुकूलता
                                                    </span>
                                                </div>

                                                <p class="text-light mb-3" style="font-size: 1rem; line-height: 1.7;">
                                                    @aspect.Prediction
                                                </p>

                                                @if (!string.IsNullOrEmpty(aspect.AuspiciousAgeRange))
                                                {
                                                    <div class="p-2 rounded bg-warning bg-opacity-10 border border-warning border-opacity-25 text-warning small">
                                                        <i class="fa-solid fa-hourglass-half me-1"></i>शुभ कालखंड (Auspicious Phase): <strong>@aspect.AuspiciousAgeRange</strong>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <!-- TAB 3: Vedic Remedies -->
                        <div class="tab-pane fade" id="remedies" role="tabpanel">
                            <h5 class="text-white fw-bold mb-2"><i class="fa-solid fa-om text-danger me-2"></i>सटीक वैदिक उपाय एवं रत्न परामर्श</h5>
                            <p class="text-secondary small mb-4">आपकी रेखाओं और ग्रहों के संतुलन के लिए शास्त्र सम्मत प्रभावशाली उपाय:</p>

                            <div class="d-flex flex-column gap-3">
                                @if (report.VedicRemedies != null)
                                {
                                    foreach (var rem in report.VedicRemedies)
                                    {
                                        <div class="p-4 rounded-3 bg-black bg-opacity-40 border border-warning border-opacity-30">
                                            <h6 class="text-warning fw-bold fs-6 mb-2">
                                                <i class="fa-solid fa-bell-concierge me-2"></i>@rem.Title
                                            </h6>
                                            <p class="text-light small mb-3" style="line-height: 1.6;">
                                                @rem.Description
                                            </p>

                                            <div class="row g-2">
                                                @if (!string.IsNullOrEmpty(rem.RecommendedGemstone))
                                                {
                                                    <div class="col-md-4">
                                                        <div class="p-2 rounded bg-dark border border-secondary text-secondary small">
                                                            <div class="text-info fw-bold mb-1"><i class="fa-solid fa-gem me-1"></i>शुभ रत्न / रुद्राक्ष</div>
                                                            <div class="text-white">@rem.RecommendedGemstone</div>
                                                        </div>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(rem.Mantra))
                                                {
                                                    <div class="col-md-4">
                                                        <div class="p-2 rounded bg-dark border border-secondary text-secondary small">
                                                            <div class="text-warning fw-bold mb-1"><i class="fa-solid fa-om me-1"></i>वैदिक मंत्र</div>
                                                            <div class="text-white font-monospace">@rem.Mantra</div>
                                                        </div>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(rem.DaanDonation))
                                                {
                                                    <div class="col-md-4">
                                                        <div class="p-2 rounded bg-dark border border-secondary text-secondary small">
                                                            <div class="text-success fw-bold mb-1"><i class="fa-solid fa-hand-holding-heart me-1"></i>दान सामग्री</div>
                                                            <div class="text-white">@rem.DaanDonation</div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <!-- TAB 4: Kundli Synthesis -->
                        @if (!string.IsNullOrEmpty(report.KundliCorrelationAnalysis))
                        {
                            <div class="tab-pane fade" id="kundli" role="tabpanel">
                                <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-certificate text-warning me-2"></i>जन्म कुंडली एवं हस्तरेखा समन्वय</h5>
                                <div class="p-4 rounded-3 bg-black bg-opacity-40 border border-secondary">
                                    <p class="text-light leading-relaxed mb-0" style="font-size: 1.05rem; line-height: 1.8;">
                                        @report.KundliCorrelationAnalysis
                                    </p>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
