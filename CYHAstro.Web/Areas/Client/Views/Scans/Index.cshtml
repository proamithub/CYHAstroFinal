@{
    ViewData["Title"] = "AI Palm & Head Scan - हस्तरेखा एवं सामुद्रिक शास्त्र";
    var settings = ViewBag.Settings as CYHAstro.Core.DTOs.Scans.AstroScanSettingsDto ?? new CYHAstro.Core.DTOs.Scans.AstroScanSettingsDto();
    var recentScans = ViewBag.RecentScans as List<CYHAstro.Core.DTOs.Scans.AstroScanListItemDto> ?? new List<CYHAstro.Core.DTOs.Scans.AstroScanListItemDto>();
}

<!-- Hero Section -->
<section class="py-5 text-center position-relative overflow-hidden" style="background: radial-gradient(circle at 50% 20%, rgba(255, 193, 7, 0.15) 0%, rgba(10, 13, 20, 1) 75%);">
    <div class="container py-3">
        <span class="badge bg-warning text-dark px-3 py-2 text-uppercase fw-bold mb-3 shadow-sm" style="letter-spacing: 1px;">
            <i class="fa-solid fa-sparkles me-1"></i> Ancient Vedic Vision AI
        </span>
        <h1 class="display-4 fw-bold text-white mb-3 brand-font">
            हस्तरेखा एवं सामुद्रिक शास्त्र <span class="text-warning">स्कैन</span>
        </h1>
        <p class="lead text-secondary mx-auto mb-4" style="max-width: 720px; font-size: 1.15rem;">
            गूगल जेमिनी विजन और प्राचीन भारतीय सामुद्रिक शास्त्र के समन्वय से जानें अपनी हथेली की रेखाओं, पर्वतों और मस्तक के गुप्त रहस्य।
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="#scan-options" class="btn btn-warning btn-lg px-4 fw-bold shadow">
                <i class="fa-solid fa-camera me-2"></i> अभी स्कैन करें
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-action="History" class="btn btn-outline-light btn-lg px-4">
                    <i class="fa-solid fa-clock-rotate-left me-2"></i> मेरी स्कैन हिस्ट्री
                </a>
            }
        </div>
    </div>
</section>

<!-- Alerts -->
<div class="container mt-3">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-25 border-success text-white" role="alert">
            <i class="fa-solid fa-circle-check me-2 text-success"></i>@TempData["Success"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show bg-danger bg-opacity-25 border-danger text-white" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2 text-danger"></i>@TempData["Error"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>

<!-- Scan Options Section -->
<section id="scan-options" class="py-5">
    <div class="container">
        <div class="row g-4 justify-content-center">
            
            <!-- Palm Scan Card -->
            <div class="col-lg-6 col-md-10">
                <div class="card h-100 bg-dark border-secondary shadow-lg rounded-4 overflow-hidden position-relative hover-scale transition-all" style="background: linear-gradient(145deg, #161b26, #0e121a);">
                    <div class="position-absolute top-0 end-0 p-3">
                        @if (settings.PalmScanPrice > 0)
                        {
                            <span class="badge bg-warning text-dark fs-6 px-3 py-2 fw-bold">₹@settings.PalmScanPrice.ToString("F0") / स्कैन</span>
                        }
                        else
                        {
                            <span class="badge bg-success text-white fs-6 px-3 py-2 fw-bold">निःशुल्क (FREE)</span>
                        }
                    </div>
                    <div class="card-body p-4 p-md-5 d-flex flex-column">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-10 text-warning mb-4" style="width: 75px; height: 75px;">
                            <i class="fa-solid fa-hand fs-1"></i>
                        </div>
                        <h3 class="text-white fw-bold mb-2">हस्तरेखा स्कैन (Palm Scan)</h3>
                        <p class="text-secondary mb-4">
                            अपनी हथेली की फोटो लें और पायें जीवन रेखा, मस्तिष्क रेखा, हृदय रेखा, भाग्य रेखा, और 7 नवग्रह पर्वतों का गहन विश्लेषण।
                        </p>
                        
                        <div class="mb-4">
                            <h6 class="text-warning small text-uppercase fw-bold mb-3" style="letter-spacing: 0.5px;">आपको क्या जानकारी मिलेगी:</h6>
                            <ul class="list-unstyled text-light small mb-0 d-flex flex-column gap-2">
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-warning"></i>
                                    <span><strong>आयु एवं स्वास्थ्य:</strong> जीवन रेखा व आरोग्य शक्ति</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-warning"></i>
                                    <span><strong>करियर एवं भाग्य:</strong> भाग्य रेखा, धन त्रिकोण व राजयोग</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-warning"></i>
                                    <span><strong>प्रेम एवं विवाह:</strong> हृदय रेखा व दांपत्य सुख के योग</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-warning"></i>
                                    <span><strong>वैदिक उपाय:</strong> रत्न, मंत्र एवं दान परामर्श</span>
                                </li>
                            </ul>
                        </div>

                        <div class="mt-auto pt-3">
                            @if (settings.IsPalmScanEnabled)
                            {
                                <a asp-action="Palm" class="btn btn-warning btn-lg w-100 fw-bold shadow py-3">
                                    <i class="fa-solid fa-hand-holding-hand me-2"></i> हथेली स्कैन शुरू करें
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-lg w-100" disabled>
                                    <i class="fa-solid fa-ban me-2"></i> अस्थायी रूप से बंद है
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Head & Face Scan Card -->
            <div class="col-lg-6 col-md-10">
                <div class="card h-100 bg-dark border-secondary shadow-lg rounded-4 overflow-hidden position-relative hover-scale transition-all" style="background: linear-gradient(145deg, #161b26, #0e121a);">
                    <div class="position-absolute top-0 end-0 p-3">
                        @if (settings.HeadScanPrice > 0)
                        {
                            <span class="badge bg-info text-dark fs-6 px-3 py-2 fw-bold">₹@settings.HeadScanPrice.ToString("F0") / स्कैन</span>
                        }
                        else
                        {
                            <span class="badge bg-success text-white fs-6 px-3 py-2 fw-bold">निःशुल्क (FREE)</span>
                        }
                    </div>
                    <div class="card-body p-4 p-md-5 d-flex flex-column">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-info bg-opacity-10 text-info mb-4" style="width: 75px; height: 75px;">
                            <i class="fa-solid fa-user-astronaut fs-1"></i>
                        </div>
                        <h3 class="text-white fw-bold mb-2">सामुद्रिक मस्तक स्कैन (Head Scan)</h3>
                        <p class="text-secondary mb-4">
                            ऋषि पराशर एवं वराहमिहिर के सामुद्रिक शास्त्र अनुसार माथे की रेखाओं और ललाट की बनावट से जानें व्यक्तित्व और राजयोग।
                        </p>

                        <div class="mb-4">
                            <h6 class="text-info small text-uppercase fw-bold mb-3" style="letter-spacing: 0.5px;">आपको क्या जानकारी मिलेगी:</h6>
                            <ul class="list-unstyled text-light small mb-0 d-flex flex-column gap-2">
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-info"></i>
                                    <span><strong>ललाट रेखाएं:</strong> गुरु, सूर्य, शनि व मंगल रेखाओं का फल</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-info"></i>
                                    <span><strong>बुद्धि व विवेक:</strong> निर्णय क्षमता एवं स्मरण शक्ति</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-info"></i>
                                    <span><strong>ओजस एवं तेज:</strong> चेहरे का आभा मंडल एवं नेतृत्व योग</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-info"></i>
                                    <span><strong>सामुद्रिक उपाय:</strong> तिलक, प्राणायाम एवं ध्यान साधना</span>
                                </li>
                            </ul>
                        </div>

                        <div class="mt-auto pt-3">
                            @if (settings.IsHeadScanEnabled)
                            {
                                <a asp-action="Head" class="btn btn-info text-dark btn-lg w-100 fw-bold shadow py-3">
                                    <i class="fa-solid fa-face-smile me-2"></i> मस्तक स्कैन शुरू करें
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-lg w-100" disabled>
                                    <i class="fa-solid fa-ban me-2"></i> अस्थायी रूप से बंद है
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- How it works -->
<section class="py-5 bg-black bg-opacity-30 border-top border-bottom border-secondary border-opacity-25">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="text-white fw-bold mb-2">यह कैसे काम करता है? (How It Works)</h2>
            <p class="text-secondary small">केवल 3 आसान चरणों में अपनी विस्तृत वैदिक रिपोर्ट प्राप्त करें</p>
        </div>

        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-dark border border-secondary h-100">
                    <div class="fs-1 text-warning mb-3"><i class="fa-solid fa-camera-rotate"></i></div>
                    <h5 class="text-white fw-bold mb-2">1. फोटो खींचें या अपलोड करें</h5>
                    <p class="text-secondary small mb-0">स्क्रीन पर दिखाए गए हैंड या फेस फ्रेम के अनुसार स्पष्ट और सीधे प्रकाश में फोटो लें।</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-dark border border-secondary h-100">
                    <div class="fs-1 text-info mb-3"><i class="fa-solid fa-microchip"></i></div>
                    <h5 class="text-white fw-bold mb-2">2. वैदिक AI विजन विश्लेषण</h5>
                    <p class="text-secondary small mb-0">गूगल जेमिनी विजन रेखाओं, पर्वतों और बनावट को स्कैन करके प्राचीन शास्त्रों से मिलान करता है।</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-dark border border-secondary h-100">
                    <div class="fs-1 text-success mb-3"><i class="fa-solid fa-scroll"></i></div>
                    <h5 class="text-white fw-bold mb-2">3. विस्तृत रिपोर्ट व उपाय</h5>
                    <p class="text-secondary small mb-0">करियर, धन, स्वास्थ्य, प्रेम और अनुकूल वैदिक उपायों के साथ अपनी व्यक्तिगत रिपोर्ट पायें।</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Recent Scans (if user logged in) -->
@if (recentScans.Any())
{
    <section class="py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="text-white fw-bold mb-1"><i class="fa-solid fa-clock-rotate-left text-warning me-2"></i>आपके हालिया स्कैन्स</h3>
                    <p class="text-secondary small mb-0">आपके द्वारा पहले किए गए विश्लेषण</p>
                </div>
                <a asp-action="History" class="btn btn-outline-warning btn-sm">सारे स्कैन्स देखें</a>
            </div>

            <div class="row g-3">
                @foreach (var scan in recentScans.Take(4))
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="card bg-dark border-secondary h-100 shadow-sm rounded-3 overflow-hidden">
                            <div class="position-relative" style="height: 160px; background: #111;">
                                <img src="@scan.ImageUrl" alt="Scan" class="w-100 h-100 object-fit-cover" onerror="this.src='/images/placeholder_scan.png'" />
                                <span class="position-absolute top-0 start-0 m-2 badge @(scan.ScanType == "PALM" ? "bg-warning text-dark" : "bg-info text-dark")">
                                    @(scan.ScanType == "PALM" ? "✋ हस्तरेखा" : "👤 सामुद्रिक")
                                </span>
                                @if (scan.AuspiciousScore > 0)
                                {
                                    <span class="position-absolute top-0 end-0 m-2 badge bg-success">
                                        @scan.AuspiciousScore% शुभ
                                    </span>
                                }
                            </div>
                            <div class="card-body p-3 d-flex flex-column">
                                <h6 class="text-white fw-bold mb-1 text-truncate">@scan.Title</h6>
                                <p class="text-secondary small mb-3 text-truncate-2" style="font-size: 0.8rem;">@scan.Summary</p>
                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <span class="text-muted small" style="font-size: 0.75rem;">@scan.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                    <a asp-action="Report" asp-route-id="@scan.PublicId" class="btn btn-sm btn-outline-warning">
                                        रिपोर्ट देखें
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
