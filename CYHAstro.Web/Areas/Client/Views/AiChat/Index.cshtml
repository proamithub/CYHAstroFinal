@using CYHAstro.Core.DTOs.Ai
@using CYHAstro.Core.Entities
@{
    ViewData["Title"] = "Ask AI Astrologer - Real-Time Vedic AI";
    var sessions = ViewBag.Sessions as List<AiChatSessionDto> ?? new();
    var currentSession = ViewBag.CurrentSession as AiChatSessionDto;
    var birthProfiles = ViewBag.BirthProfiles as List<BirthProfile> ?? new();
    bool isGuest = ViewBag.IsGuest == true;
}

<div class="container-fluid py-3 px-md-4" style="max-width: 1400px; min-height: 85vh;">
    <div class="row g-3" style="height: 82vh;">
        <!-- Left Sidebar: Conversations History -->
        <div class="col-lg-3 col-md-4 d-none d-md-block h-100">
            <div class="card bg-dark border-secondary border-opacity-50 h-100 rounded-4 shadow d-flex flex-column overflow-hidden">
                <div class="p-3 border-bottom border-secondary border-opacity-50">
                    <a href="/AiChat" class="btn btn-warning w-100 fw-bold rounded-pill text-dark d-flex align-items-center justify-content-center shadow-sm">
                        <i class="fa-solid fa-plus me-2"></i> New AI Reading
                    </a>
                </div>

                <div class="p-2 flex-grow-1 overflow-auto" id="sessionsList">
                    <div class="text-secondary small px-2 py-1 text-uppercase fw-semibold" style="font-size: 0.75rem;">Your Consultations</div>
                    @if (isGuest)
                    {
                        <div class="p-3 text-center text-secondary small">
                            <i class="fa-solid fa-lock fs-4 mb-2 text-warning opacity-75"></i>
                            <p class="mb-2">Sign in to save your AI astrology chats and link your birth chart.</p>
                            <a href="/Auth/Login" class="btn btn-outline-warning btn-sm rounded-pill">Sign In</a>
                        </div>
                    }
                    else if (!sessions.Any())
                    {
                        <div class="p-3 text-center text-secondary small">
                            <i class="fa-regular fa-comment-dots fs-3 mb-2 opacity-50"></i>
                            <p class="mb-0">No past readings yet. Ask your first astrological question!</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var s in sessions)
                            {
                                bool isActive = currentSession != null && currentSession.PublicId == s.PublicId;
                                <div class="list-group-item bg-transparent border-0 px-2 py-1">
                                    <div class="d-flex align-items-center justify-content-between p-2 rounded-3 @(isActive ? "bg-warning bg-opacity-25 border border-warning border-opacity-50" : "hover-dark")" style="cursor: pointer;" onclick="location.href='/AiChat?id=@s.PublicId'">
                                        <div class="text-truncate me-2">
                                            <div class="text-white small fw-semibold text-truncate"><i class="fa-solid fa-sparkles text-warning me-1"></i> @s.Title</div>
                                            <span class="text-secondary" style="font-size: 0.7rem;">@s.CreatedAt.ToString("dd MMM, hh:mm tt")</span>
                                        </div>
                                        <button class="btn btn-link text-secondary p-0 btn-sm opacity-50 hover-opacity" title="Delete" onclick="deleteSession(event, '@s.PublicId')">
                                            <i class="fa-regular fa-trash-can"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="p-3 border-top border-secondary border-opacity-50 bg-black bg-opacity-25 small text-secondary">
                    <div class="d-flex align-items-center justify-content-between">
                        <span><i class="fa-solid fa-brain text-warning me-1"></i> Gemini 1.5 Flash</span>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">Active</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Main: Chat Interface -->
        <div class="col-lg-9 col-md-8 col-12 h-100">
            <div class="card bg-dark border-secondary border-opacity-50 h-100 rounded-4 shadow d-flex flex-column overflow-hidden">
                <!-- Header -->
                <div class="p-3 border-bottom border-secondary border-opacity-50 bg-black bg-opacity-40 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-warning bg-opacity-10 border border-warning p-2 me-3 text-warning text-center" style="width: 44px; height: 44px;">
                            <i class="fa-solid fa-om fs-5"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-white fw-bold d-flex align-items-center">
                                AI Vedic Sage <span class="badge bg-warning text-dark ms-2 fw-bold" style="font-size: 0.65rem;">GEMINI AI</span>
                            </h6>
                            <span class="text-secondary small d-flex align-items-center">
                                <span class="spinner-grow spinner-grow-sm text-success me-1" style="width: 8px; height: 8px;"></span> Online &bull; Vedic Parashari Principles
                            </span>
                        </div>
                    </div>

                    <!-- Birth Profile Selector -->
                    <div class="d-flex align-items-center gap-2">
                        @if (birthProfiles.Any())
                        {
                            <div class="dropdown">
                                <select class="form-select form-select-sm bg-black border-secondary text-warning small rounded-pill" id="profileSelector">
                                    <option value="">Personalize with Kundli: None</option>
                                    @foreach (var p in birthProfiles)
                                    {
                                        <option value="@p.Id" selected="@(p.IsPrimary ? "selected" : null)">
                                            Kundli: @p.Name (@p.BirthPlace)
                                        </option>
                                    }
                                </select>
                            </div>
                        }
                        <button class="btn btn-outline-secondary btn-sm rounded-pill d-md-none" data-bs-toggle="offcanvas" data-bs-target="#mobileHistory">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </button>
                    </div>
                </div>

                <!-- Messages Scroll Area -->
                <div class="p-3 p-md-4 flex-grow-1 overflow-auto d-flex flex-column gap-3" id="chatThread">
                    <!-- Welcome Initial Message -->
                    <div class="d-flex align-items-start gap-2">
                        <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center flex-shrink-0 fw-bold" style="width: 34px; height: 34px;">
                            <i class="fa-solid fa-om"></i>
                        </div>
                        <div class="bg-black bg-opacity-50 border border-secondary border-opacity-50 text-light p-3 rounded-4 shadow-sm" style="max-width: 85%;">
                            <p class="mb-2 fw-semibold text-warning">Namaste! I am your AI Vedic Astrology Guide.</p>
                            <p class="mb-2 text-secondary small">I can interpret your planetary positions, analyze your current Dasha, and offer spiritual guidance for Career, Marriage, Finance, and Well-being according to classical Vedic Jyotish.</p>
                            <p class="mb-0 text-secondary small">What would you like to explore today?</p>
                        </div>
                    </div>

                    <!-- Render Historical Messages if active session -->
                    @if (currentSession != null && currentSession.Messages.Any())
                    {
                        foreach (var m in currentSession.Messages)
                        {
                            if (m.Role == "user")
                            {
                                <div class="d-flex align-items-start gap-2 justify-content-end">
                                    <div class="bg-warning text-dark p-3 rounded-4 fw-medium shadow-sm" style="max-width: 80%; border-bottom-right-radius: 4px;">
                                        @m.Content
                                        <div class="text-end text-dark opacity-50 mt-1" style="font-size: 0.65rem;">@m.Timestamp.ToString("hh:mm tt")</div>
                                    </div>
                                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px;">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-start gap-2">
                                    <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center flex-shrink-0 fw-bold" style="width: 34px; height: 34px;">
                                        <i class="fa-solid fa-om"></i>
                                    </div>
                                    <div class="bg-black bg-opacity-50 border border-secondary border-opacity-50 text-light p-3 rounded-4 shadow-sm" style="max-width: 85%; border-bottom-left-radius: 4px; white-space: pre-wrap;">
                                        @m.Content
                                        <div class="text-secondary opacity-50 mt-1" style="font-size: 0.65rem;">@m.Timestamp.ToString("hh:mm tt")</div>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>

                <!-- Quick Prompt Chips -->
                <div class="px-3 py-2 bg-black bg-opacity-25 border-top border-secondary border-opacity-25 d-flex gap-2 overflow-auto text-nowrap" id="chipsBar">
                    <button class="btn btn-sm btn-outline-warning rounded-pill py-1 px-3 text-secondary border-opacity-50 small" onclick="sendQuickPrompt('When is the best time for my career promotion or job switch?')">
                        💼 Career & Job Switch
                    </button>
                    <button class="btn btn-sm btn-outline-warning rounded-pill py-1 px-3 text-secondary border-opacity-50 small" onclick="sendQuickPrompt('Analyze my marriage timing and spouse characteristics according to my 7th house.')">
                        💍 Marriage & Relationship
                    </button>
                    <button class="btn btn-sm btn-outline-warning rounded-pill py-1 px-3 text-secondary border-opacity-50 small" onclick="sendQuickPrompt('What do my planetary Dhana Yogas indicate about my financial wealth?')">
                        💰 Wealth & Finance
                    </button>
                    <button class="btn btn-sm btn-outline-warning rounded-pill py-1 px-3 text-secondary border-opacity-50 small" onclick="sendQuickPrompt('What are my current planetary dasha and recommended Vedic remedies?')">
                        🪐 Dasha & Gemstone Remedies
                    </button>
                </div>

                <!-- Input Footer -->
                <div class="p-3 border-top border-secondary border-opacity-50 bg-black bg-opacity-40">
                    <form id="chatForm" onsubmit="handleSend(event)" class="d-flex gap-2 align-items-center">
                        <input type="text" id="userInput" class="form-control bg-dark border-secondary text-white rounded-pill px-4 py-2" placeholder="Ask any question regarding your life, Kundli, or future..." autocomplete="off" required />
                        <button type="submit" id="sendBtn" class="btn btn-warning rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 shadow" style="width: 44px; height: 44px;">
                            <i class="fa-solid fa-paper-plane text-dark"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-dark:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    .hover-opacity:hover {
        opacity: 1 !important;
        color: #dc3545 !important;
    }
</style>

@section Scripts {
    <script>
        let currentSessionPublicId = '@(currentSession?.PublicId ?? "")';

        function scrollToBottom() {
            const thread = document.getElementById('chatThread');
            thread.scrollTop = thread.scrollHeight;
        }
        scrollToBottom();

        function sendQuickPrompt(text) {
            document.getElementById('userInput').value = text;
            document.getElementById('chatForm').dispatchEvent(new Event('submit'));
        }

        async function handleSend(e) {
            e.preventDefault();
            const input = document.getElementById('userInput');
            const message = input.value.trim();
            if (!message) return;

            const sendBtn = document.getElementById('sendBtn');
            const profileSel = document.getElementById('profileSelector');
            const birthProfileId = profileSel ? profileSel.value : null;

            // Render user message bubble
            appendUserMessage(message);
            input.value = '';
            input.disabled = true;
            sendBtn.disabled = true;

            // Render typing indicator
            const typingId = appendTypingIndicator();
            scrollToBottom();

            try {
                const response = await fetch('/AiChat/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sessionPublicId: currentSessionPublicId,
                        message: message,
                        birthProfileId: birthProfileId ? parseInt(birthProfileId) : null,
                        language: 'en'
                    })
                });

                const res = await response.json();
                removeTypingIndicator(typingId);

                if (res.success && res.data) {
                    currentSessionPublicId = res.data.sessionPublicId;
                    appendAssistantMessage(res.data.reply.content);
                } else {
                    appendAssistantMessage("I encountered an issue connecting with the stars. Please try again.");
                }
            } catch (err) {
                removeTypingIndicator(typingId);
                appendAssistantMessage("Network error occurred. Please check your connection.");
            } finally {
                input.disabled = false;
                sendBtn.disabled = false;
                input.focus();
                scrollToBottom();
            }
        }

        function appendUserMessage(text) {
            const thread = document.getElementById('chatThread');
            const now = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            const div = document.createElement('div');
            div.className = 'd-flex align-items-start gap-2 justify-content-end';
            div.innerHTML = `
                <div class="bg-warning text-dark p-3 rounded-4 fw-medium shadow-sm" style="max-width: 80%; border-bottom-right-radius: 4px;">
                    ${escapeHtml(text)}
                    <div class="text-end text-dark opacity-50 mt-1" style="font-size: 0.65rem;">${now}</div>
                </div>
                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px;">
                    <i class="fa-solid fa-user"></i>
                </div>
            `;
            thread.appendChild(div);
        }

        function appendAssistantMessage(text) {
            const thread = document.getElementById('chatThread');
            const now = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            const div = document.createElement('div');
            div.className = 'd-flex align-items-start gap-2';
            div.innerHTML = `
                <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center flex-shrink-0 fw-bold" style="width: 34px; height: 34px;">
                    <i class="fa-solid fa-om"></i>
                </div>
                <div class="bg-black bg-opacity-50 border border-secondary border-opacity-50 text-light p-3 rounded-4 shadow-sm" style="max-width: 85%; border-bottom-left-radius: 4px; white-space: pre-wrap;">
                    ${escapeHtml(text)}
                    <div class="text-secondary opacity-50 mt-1" style="font-size: 0.65rem;">${now}</div>
                </div>
            `;
            thread.appendChild(div);
        }

        function appendTypingIndicator() {
            const thread = document.getElementById('chatThread');
            const id = 'typing_' + Date.now();
            const div = document.createElement('div');
            div.id = id;
            div.className = 'd-flex align-items-start gap-2';
            div.innerHTML = `
                <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center flex-shrink-0 fw-bold" style="width: 34px; height: 34px;">
                    <i class="fa-solid fa-om"></i>
                </div>
                <div class="bg-black bg-opacity-50 border border-secondary border-opacity-50 text-secondary p-3 rounded-4 small d-flex align-items-center gap-2">
                    <span class="spinner-grow spinner-grow-sm text-warning" role="status"></span>
                    <span>Consulting Vedic ephemeris and planetary charts...</span>
                </div>
            `;
            thread.appendChild(div);
            return id;
        }

        function removeTypingIndicator(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }

        async function deleteSession(e, publicId) {
            e.stopPropagation();
            if (!confirm("Are you sure you want to delete this AI reading history?")) return;

            try {
                const res = await fetch('/AiChat/DeleteSession/' + publicId, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    location.href = '/AiChat';
                }
            } catch (err) {
                alert("Could not delete session.");
            }
        }

        function escapeHtml(string) {
            const entityMap = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
            return String(string).replace(/[&<>"']/g, s => entityMap[s]);
        }
    </script>
}
