@model CYHAstro.Core.DTOs.Auth.RegisterRequestDto
@{
    ViewData["Title"] = "Create Free Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="cosmic-card p-4 p-sm-5">
                <div class="text-center mb-4">
                    <span class="fs-1 text-warning"><i class="fa-solid fa-sparkles"></i></span>
                    <h3 class="fw-bold text-white mt-2">Begin Your Astrological Journey</h3>
                    <p class="text-secondary small">Get free Janam Kundli, daily horoscope alerts & verified consultations</p>
                </div>

                <form asp-controller="Auth" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-regular fa-user"></i></span>
                            <input asp-for="DisplayName" class="form-control form-control-cosmic" placeholder="e.g. Rahul Sharma" required autofocus />
                        </div>
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-regular fa-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control form-control-cosmic" placeholder="name@example.com" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary">Phone Number (Optional)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-phone"></i></span>
                            <input asp-for="PhoneNumber" type="tel" class="form-control form-control-cosmic" placeholder="+919876543210" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-secondary">Password (At least 8 chars with uppercase, number & symbol)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-lock"></i></span>
                            <input asp-for="Password" type="password" class="form-control form-control-cosmic" placeholder="Create strong password" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-gold w-100 py-2 fs-6 mb-3">
                        <i class="fa-solid fa-user-plus me-2"></i> Register Account
                    </button>
                </form>

                <div class="text-center mt-3 pt-3 border-top border-secondary opacity-75">
                    <span class="small text-secondary">Already have an account?</span>
                    <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="small text-warning fw-semibold ms-1 text-decoration-none">
                        Sign In Here
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
