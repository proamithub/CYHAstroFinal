@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="theme-color" content="#0a0d14" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>@ViewData["Title"] - CYHAstro | India's Premier Vedic Astrology Platform</title>
    <link rel="icon" type="image/png" href="~/images/cyhastro-favicon.png" asp-append-version="true" />

    <!-- Resource Preconnects for Ultra Fast Mobile Speed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

    <!-- Google Fonts (Cinzel & Plus Jakarta Sans) -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var hideMobileBottomNav = string.Equals(currentController, "Consultation", StringComparison.OrdinalIgnoreCase)
                           && string.Equals(currentAction, "Room", StringComparison.OrdinalIgnoreCase);
    bool IsActive(string ctrl, string? act = null) =>
        string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase) &&
        (act == null || string.Equals(currentAction, act, StringComparison.OrdinalIgnoreCase));
}
<body class="@(hideMobileBottomNav ? "no-mobile-nav" : "has-mobile-nav")">
    <!-- Top Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-xl navbar-cosmic">
            <div class="container-fluid px-3 px-xxl-4" style="max-width: 1440px;">
                <!-- Brand -->
                <a class="navbar-brand d-flex align-items-center gap-2 brand-font fw-bold m-0 flex-shrink-0" asp-controller="Home" asp-action="Index">
                    <img src="~/images/cyhastro-logo.png" alt="CYHAstro Logo" class="brand-logo-img" asp-append-version="true" />
                    <span class="brand-title text-white">CYH<span class="text-warning">Astro</span></span>
                </a>

                <!-- Desktop Horizontal Nav (>= 1200px) -->
                <ul class="navbar-nav cosmic-desktop-nav d-none d-xl-flex align-items-center mx-auto gap-1">
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Astrologer") ? "active" : "")" asp-controller="Astrologer" asp-action="Index">
                            <i class="fa-solid fa-comments text-warning"></i><span>Astrologers</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Horoscope") ? "active" : "")" asp-controller="Horoscope" asp-action="Index">
                            <i class="fa-solid fa-moon text-info"></i><span>Horoscope</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Panchang") ? "active" : "")" asp-controller="Panchang" asp-action="Index">
                            <i class="fa-solid fa-om text-warning"></i><span>Panchang</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Kundli", "Index") || IsActive("Kundli", "Result") ? "active" : "")" asp-controller="Kundli" asp-action="Index">
                            <i class="fa-solid fa-circle-nodes text-warning"></i><span>Kundli</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Kundli", "Matchmaking") || IsActive("Kundli", "MatchmakingResult") ? "active" : "")" asp-controller="Kundli" asp-action="Matchmaking">
                            <i class="fa-solid fa-heart text-danger"></i><span>Milan</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("AiChat") ? "active" : "")" asp-controller="AiChat" asp-action="Index">
                            <i class="fa-solid fa-sparkles text-info"></i><span>AI Chat</span>
                            <span class="nav-pill-tag tag-gold">AI</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Scans") ? "active" : "")" asp-controller="Scans" asp-action="Index">
                            <i class="fa-solid fa-hand text-warning"></i><span>Palm &amp; Face</span>
                            <span class="nav-pill-tag tag-hot">NEW</span>
                        </a>
                    </li>
                </ul>

                <!-- Right Header Actions (Always Single Row) -->
                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Wallet Pill -->
                        <a asp-controller="Wallet" asp-action="Index" class="wallet-pill" title="Recharge Wallet">
                            <i class="fa-solid fa-wallet text-warning"></i>
                            <span>₹<span id="navWalletBalance">--</span></span>
                            <i class="fa-solid fa-circle-plus text-warning d-none d-sm-inline"></i>
                        </a>

                        <!-- Notifications Bell -->
                        <div class="dropdown">
                            <button class="header-icon-btn position-relative"
                                    type="button" id="notifMenuButton" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications" aria-label="Notifications">
                                <i class="fa-solid fa-bell"></i>
                                <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.6rem;">
                                    0
                                </span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-warning shadow-lg p-0 cosmic-notif-menu" aria-labelledby="notifMenuButton">
                                <div class="p-3 border-bottom border-secondary d-flex justify-content-between align-items-center bg-black">
                                    <h6 class="mb-0 text-white fw-bold brand-font small"><i class="fa-solid fa-bell text-warning me-1"></i> Notifications</h6>
                                    <button type="button" class="btn btn-link text-warning p-0 text-decoration-none small" style="font-size: 0.75rem;" onclick="markAllNotifsRead()">Mark all read</button>
                                </div>
                                <div id="notifListContainer">
                                    <div class="text-center py-4 text-secondary small">
                                        <i class="fa-solid fa-bell-slash fs-4 text-secondary mb-2 d-block opacity-50"></i>
                                        No notifications right now
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Desktop User Dropdown -->
                        <div class="dropdown d-none d-xl-block">
                            <button class="btn btn-outline-gold btn-sm dropdown-toggle d-flex align-items-center gap-2 py-1 px-3 header-user-btn"
                                    type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-regular fa-circle-user text-warning fs-6"></i>
                                <span class="text-truncate" style="max-width: 110px;">@(User.Identity?.Name ?? "Account")</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-warning shadow-lg mt-2" aria-labelledby="userMenuButton">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="Index">
                                        <i class="fa-solid fa-id-card me-2 text-warning"></i> My Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="BirthProfiles">
                                        <i class="fa-solid fa-users me-2 text-info"></i> Saved Birth Profiles
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Wallet" asp-action="Index">
                                        <i class="fa-solid fa-receipt me-2 text-success"></i> Wallet &amp; Passbook
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider border-secondary" /></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger" asp-controller="Auth" asp-action="Logout">
                                        <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Sign Out
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-gold btn-sm px-3 header-auth-btn">
                            <i class="fa-regular fa-user me-1"></i><span>Sign In</span>
                        </a>
                        <a asp-controller="Auth" asp-action="Register" class="btn btn-gold btn-sm px-3 header-auth-btn d-none d-sm-inline-flex">
                            Register
                        </a>
                    }

                    <!-- Mobile / Tablet Menu Drawer Button (< 1200px) -->
                    <button class="header-icon-btn d-xl-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavDrawer"
                            aria-controls="mobileNavDrawer" aria-label="Open navigation menu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <!-- Mobile / Tablet Slide-In Cosmic Navigation Drawer (< 1200px) -->
    <div class="offcanvas offcanvas-end cosmic-offcanvas d-xl-none" tabindex="-1" id="mobileNavDrawer" aria-labelledby="mobileNavDrawerLabel">
        <div class="offcanvas-header border-bottom border-secondary border-opacity-25 px-3 py-3">
            <a class="d-flex align-items-center gap-2 brand-font fw-bold text-decoration-none" id="mobileNavDrawerLabel" asp-controller="Home" asp-action="Index">
                <img src="~/images/cyhastro-logo.png" alt="CYHAstro Logo" class="brand-logo-img" style="width: 32px; height: 32px;" asp-append-version="true" />
                <span class="fs-5 text-white">CYH<span class="text-warning">Astro</span></span>
            </a>
            <button type="button" class="header-icon-btn" data-bs-dismiss="offcanvas" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="offcanvas-body d-flex flex-column p-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="drawer-user-card mb-3 p-3 rounded-4 d-flex align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                        <div class="drawer-avatar flex-shrink-0">
                            <i class="fa-solid fa-user text-dark"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="text-white fw-bold small text-truncate">@(User.Identity?.Name ?? "My Account")</div>
                            <div class="text-secondary" style="font-size: 0.72rem;">Verified Seeker</div>
                        </div>
                    </div>
                    <a asp-controller="Wallet" asp-action="Index" class="btn btn-gold btn-sm px-3 flex-shrink-0">
                        <i class="fa-solid fa-plus me-1"></i>Add ₹
                    </a>
                </div>
            }

            <div class="drawer-section-label">Explore Services</div>
            <div class="d-flex flex-column gap-1 mb-3">
                <a class="drawer-nav-item @(IsActive("Home") ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <span class="drawer-nav-icon text-warning"><i class="fa-solid fa-house"></i></span>
                    <span class="flex-grow-1">Home</span>
                </a>
                <a class="drawer-nav-item @(IsActive("Astrologer") ? "active" : "")" asp-controller="Astrologer" asp-action="Index">
                    <span class="drawer-nav-icon text-warning"><i class="fa-solid fa-comments"></i></span>
                    <span class="flex-grow-1">Talk to Astrologers</span>
                </a>
                <a class="drawer-nav-item @(IsActive("AiChat") ? "active" : "")" asp-controller="AiChat" asp-action="Index">
                    <span class="drawer-nav-icon text-info"><i class="fa-solid fa-sparkles"></i></span>
                    <span class="flex-grow-1">Ask AI Astrologer</span>
                    <span class="nav-pill-tag tag-gold">AI</span>
                </a>
                <a class="drawer-nav-item @(IsActive("Scans") ? "active" : "")" asp-controller="Scans" asp-action="Index">
                    <span class="drawer-nav-icon text-warning"><i class="fa-solid fa-hand"></i></span>
                    <span class="flex-grow-1">Palm &amp; Face Scan</span>
                    <span class="nav-pill-tag tag-hot">NEW</span>
                </a>
                <a class="drawer-nav-item @(IsActive("Kundli", "Index") || IsActive("Kundli", "Result") ? "active" : "")" asp-controller="Kundli" asp-action="Index">
                    <span class="drawer-nav-icon text-warning"><i class="fa-solid fa-circle-nodes"></i></span>
                    <span class="flex-grow-1">Free Janam Kundli</span>
                </a>
                <a class="drawer-nav-item @(IsActive("Kundli", "Matchmaking") || IsActive("Kundli", "MatchmakingResult") ? "active" : "")" asp-controller="Kundli" asp-action="Matchmaking">
                    <span class="drawer-nav-icon text-danger"><i class="fa-solid fa-heart"></i></span>
                    <span class="flex-grow-1">Kundli Milan (36 Gunas)</span>
                </a>
                <a class="drawer-nav-item @(IsActive("Horoscope") ? "active" : "")" asp-controller="Horoscope" asp-action="Index">
                    <span class="drawer-nav-icon text-info"><i class="fa-solid fa-moon"></i></span>
                    <span class="flex-grow-1">Daily Horoscope</span>
                </a>
                <a class="drawer-nav-item @(IsActive("Panchang") ? "active" : "")" asp-controller="Panchang" asp-action="Index">
                    <span class="drawer-nav-icon text-warning"><i class="fa-solid fa-om"></i></span>
                    <span class="flex-grow-1">Today's Panchang</span>
                </a>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="drawer-section-label">My Account</div>
                <div class="d-flex flex-column gap-1 mb-3">
                    <a class="drawer-nav-item @(IsActive("Dashboard", "Index") ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                        <span class="drawer-nav-icon text-warning"><i class="fa-solid fa-id-card"></i></span>
                        <span class="flex-grow-1">My Profile</span>
                    </a>
                    <a class="drawer-nav-item @(IsActive("Dashboard", "BirthProfiles") ? "active" : "")" asp-controller="Dashboard" asp-action="BirthProfiles">
                        <span class="drawer-nav-icon text-info"><i class="fa-solid fa-users"></i></span>
                        <span class="flex-grow-1">Saved Birth Profiles</span>
                    </a>
                    <a class="drawer-nav-item @(IsActive("Wallet") ? "active" : "")" asp-controller="Wallet" asp-action="Index">
                        <span class="drawer-nav-icon text-success"><i class="fa-solid fa-receipt"></i></span>
                        <span class="flex-grow-1">Wallet &amp; Passbook</span>
                    </a>
                </div>
                <div class="mt-auto pt-3 border-top border-secondary border-opacity-25">
                    <a class="btn btn-outline-danger w-100 rounded-pill fw-semibold" asp-controller="Auth" asp-action="Logout">
                        <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Sign Out
                    </a>
                </div>
            }
            else
            {
                <div class="mt-auto pt-3 border-top border-secondary border-opacity-25 d-grid gap-2">
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-gold fw-bold">
                        <i class="fa-solid fa-user-plus me-2"></i> Register Free
                    </a>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-gold fw-semibold">
                        <i class="fa-regular fa-user me-2"></i> Sign In
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1">
        <!-- Toast / Alert Container -->
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show bg-success text-white border-0 shadow" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show bg-danger text-white border-0 shadow" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Cosmic Footer -->
    <footer class="footer-cosmic text-muted mt-5">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 brand-font fw-bold mb-3">
                        <img src="~/images/cyhastro-logo.png" alt="CYHAstro Logo" class="brand-logo-img" asp-append-version="true" />
                        <span class="fs-4 text-white">CYH<span class="text-warning">Astro</span></span>
                    </div>
                    <p class="small text-secondary mb-3">
                        India's premier enterprise astrology platform providing authentic Vedic horoscope calculations, Kundli synthesis, and 24/7 verified astrologer consultations with 100% privacy assurance.
                    </p>
                    <div class="d-flex gap-3 fs-5">
                        <a href="#" class="text-secondary hover-gold"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#" class="text-secondary hover-gold"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="text-secondary hover-gold"><i class="fa-brands fa-youtube"></i></a>
                        <a href="#" class="text-secondary hover-gold"><i class="fa-brands fa-whatsapp"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Astrology Tools</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Horoscope" asp-action="Index" class="text-secondary text-decoration-none">Daily Horoscope</a></li>
                        <li><a asp-controller="Kundli" asp-action="Index" class="text-secondary text-decoration-none">Free Janam Kundli</a></li>
                        <li><a asp-controller="Kundli" asp-action="Matchmaking" class="text-secondary text-decoration-none">Kundli Milan (36 Gunas)</a></li>
                        <li><a asp-controller="Astrologer" asp-action="Index" class="text-secondary text-decoration-none">Talk to Astrologer</a></li>
                        <li><a href="/Astrologer" class="text-warning text-decoration-none fw-bold"><i class="fa-solid fa-om me-1"></i> Astrologer Portal</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Specialties</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="/Astrologers?specialization=Vedic+Astrology" class="text-secondary text-decoration-none">Vedic Astrology</a></li>
                        <li><a href="/Astrologers?specialization=Tarot+Reading" class="text-secondary text-decoration-none">Tarot Reading</a></li>
                        <li><a href="/Astrologers?specialization=Numerology" class="text-secondary text-decoration-none">Numerology</a></li>
                        <li><a href="/Astrologers?specialization=KP+Astrology" class="text-secondary text-decoration-none">KP Astrology</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Enterprise Security & Compliance</h6>
                    <p class="small text-secondary mb-3">
                        <i class="fa-solid fa-shield-halved text-warning me-2"></i> All conversations and consultation audio/video sessions are end-to-end encrypted and completely confidential.
                    </p>
                    <div class="p-3 rounded bg-dark border border-secondary text-secondary small">
                        <strong>Disclaimer:</strong> Astrology is an ancient predictive science. Individual results may vary based on personal karma and planetary transits.
                    </div>
                </div>
            </div>

            <hr class="border-secondary opacity-25 my-4" />

            <div class="d-flex flex-wrap justify-content-center justify-content-md-between align-items-center gap-2 text-center text-md-start small text-secondary">
                <div>
                    &copy; @DateTime.UtcNow.Year CYHAstro Platform. Built with .NET 10 LTS Enterprise Architecture.
                </div>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none">Privacy Policy</a>
                    <a href="#" class="text-secondary text-decoration-none">Terms of Service</a>
                    <a href="#" class="text-secondary text-decoration-none">Support & FAQs</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- SignalR for Live Real-Time Astrologer Availability & Presence -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        (function() {
            // Skip separate presence socket if currently inside consultation room (which has its own hub)
            if (window.location.pathname.toLowerCase().indexOf('/consultation/room') !== -1) return;
            if (typeof signalR === "undefined") return;

            const presenceConn = new signalR.HubConnectionBuilder()
                .withUrl("/consultationHub")
                .withAutomaticReconnect([0, 1000, 3000, 5000, 10000])
                .build();

            presenceConn.on("AstrologerStatusChanged", function(data) {
                if (!data || !data.publicId) return;

                console.log("[Presence] Astrologer status changed:", data);

                // 1. Update all badges with data-astro-badge="publicId"
                document.querySelectorAll('[data-astro-badge="' + data.publicId + '"]').forEach(function(badge) {
                    if (data.isAvailable) {
                        badge.className = "badge-online";
                        badge.innerHTML = '<i class="fa-solid fa-circle me-1" style="font-size: 6px;"></i> Online';
                    } else {
                        badge.className = "badge-offline";
                        badge.innerHTML = '<i class="fa-solid fa-circle me-1 text-secondary" style="font-size: 6px;"></i> Offline';
                    }
                });

                // 2. Update quick action / chat buttons on Home & Listing cards
                document.querySelectorAll('[data-astro-chat-btn="' + data.publicId + '"]').forEach(function(btn) {
                    if (data.isAvailable) {
                        if (btn.tagName === "BUTTON") {
                            const link = document.createElement("a");
                            link.href = '/Astrologer/Detail/' + data.publicId + '?action=chat';
                            link.className = "btn btn-gold btn-sm px-3";
                            link.setAttribute("data-astro-chat-btn", data.publicId);
                            link.innerHTML = '<i class="fa-solid fa-comment-dots me-1"></i> Consult';
                            btn.parentNode.replaceChild(link, btn);
                        } else {
                            btn.className = "btn btn-gold btn-sm px-3";
                            btn.innerHTML = '<i class="fa-solid fa-comment-dots me-1"></i> Consult';
                        }
                    } else {
                        if (btn.tagName === "A") {
                            const lockBtn = document.createElement("button");
                            lockBtn.type = "button";
                            lockBtn.className = "btn btn-secondary btn-sm px-3 opacity-50";
                            lockBtn.disabled = true;
                            lockBtn.style.cursor = "not-allowed";
                            lockBtn.setAttribute("data-astro-chat-btn", data.publicId);
                            lockBtn.title = "Astrologer is currently offline";
                            lockBtn.innerHTML = '<i class="fa-solid fa-lock me-1"></i> Offline';
                            btn.parentNode.replaceChild(lockBtn, btn);
                        } else {
                            btn.className = "btn btn-secondary btn-sm px-3 opacity-50";
                            btn.disabled = true;
                            btn.style.cursor = "not-allowed";
                            btn.title = "Astrologer is currently offline";
                            btn.innerHTML = '<i class="fa-solid fa-lock me-1"></i> Offline';
                        }
                    }
                });

                // 3. If on Astrologer Detail Page for this astrologer
                if (window.currentAstroPublicId && window.currentAstroPublicId === data.publicId) {
                    const bookingBox = document.getElementById("bookingActionsContainer");
                    const offlineBox = document.getElementById("offlineNoticeContainer");
                    if (bookingBox && offlineBox) {
                        if (data.isAvailable) {
                            bookingBox.classList.remove("d-none");
                            offlineBox.classList.add("d-none");
                        } else {
                            bookingBox.classList.add("d-none");
                            offlineBox.classList.remove("d-none");
                        }
                    }
                }
            });

            presenceConn.start().catch(function(err) {
                console.warn("[Presence] Connection error:", err);
            });
        })();
    </script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            // Live Wallet Balance & Notifications Fetch
            document.addEventListener("DOMContentLoaded", function () {
                fetch('/Client/Wallet/balance')
                    .then(res => res.ok ? res.json() : null)
                    .then(data => {
                        if (data && data.totalBalance !== undefined) {
                            const formatted = parseFloat(data.totalBalance).toFixed(2);
                            const elem = document.getElementById("navWalletBalance");
                            if (elem) elem.innerText = formatted;
                            const elemMob = document.getElementById("navWalletBalanceMobile");
                            if (elemMob) elemMob.innerText = formatted;
                        }
                    })
                    .catch(() => {});

                // Auto-refresh wallet balance every 60 seconds
                setInterval(function() {
                    fetch('/Client/Wallet/balance')
                        .then(res => res.ok ? res.json() : null)
                        .then(data => {
                            if (data && data.totalBalance !== undefined) {
                                const formatted = parseFloat(data.totalBalance).toFixed(2);
                                const elem = document.getElementById("navWalletBalance");
                                if (elem) elem.innerText = formatted;
                                const elemMob = document.getElementById("navWalletBalanceMobile");
                                if (elemMob) elemMob.innerText = formatted;
                            }
                        })
                        .catch(() => {});
                }, 60000);

                loadNotifications();
            });

            function loadNotifications() {
                fetch('/Client/Notifications/List')
                    .then(res => res.ok ? res.json() : null)
                    .then(data => {
                        if (!data || !data.success) return;

                        const badge = document.getElementById("notifBadge");
                        if (badge) {
                            if (data.unreadCount > 0) {
                                badge.innerText = data.unreadCount > 99 ? '99+' : data.unreadCount;
                                badge.classList.remove('d-none');
                            } else {
                                badge.classList.add('d-none');
                            }
                        }

                        const container = document.getElementById("notifListContainer");
                        if (!container) return;

                        if (data.items && data.items.length > 0) {
                            container.innerHTML = data.items.map(n => `
                                <div class="p-3 border-bottom border-secondary ${n.isRead ? 'opacity-75' : 'bg-dark bg-opacity-50'} position-relative" style="cursor: pointer;" onclick="markSingleNotifRead(${n.id}, '${n.actionUrl || ''}')">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <span class="fw-bold ${n.isRead ? 'text-light' : 'text-warning'} small">${escapeHtml(n.title)}</span>
                                        ${!n.isRead ? '<span class="badge bg-warning text-dark" style="font-size: 0.6rem;">NEW</span>' : ''}
                                    </div>
                                    <p class="text-secondary small mb-1 lh-sm">${escapeHtml(n.message)}</p>
                                    <span class="text-muted" style="font-size: 0.65rem;">${new Date(n.createdAt).toLocaleDateString()}</span>
                                </div>
                            `).join('');
                        } else {
                            container.innerHTML = `
                                <div class="text-center py-4 text-secondary small">
                                    <i class="fa-solid fa-bell-slash fs-4 text-secondary mb-2 d-block opacity-50"></i>
                                    No notifications right now
                                </div>`;
                        }
                    })
                    .catch(() => {});
            }

            function markSingleNotifRead(id, actionUrl) {
                const formData = new FormData();
                formData.append('id', id);
                fetch('/Client/Notifications/MarkRead', {
                    method: 'POST',
                    body: formData
                }).then(() => {
                    if (actionUrl && actionUrl !== 'null' && actionUrl.trim() !== '') {
                        window.location.href = actionUrl;
                    } else {
                        loadNotifications();
                    }
                }).catch(() => {});
            }

            function markAllNotifsRead() {
                fetch('/Client/Notifications/MarkAllRead', {
                    method: 'POST'
                }).then(() => {
                    loadNotifications();
                }).catch(() => {});
            }

            function escapeHtml(str) {
                if (!str) return '';
                return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
            }
        </script>
    }

    @if (!hideMobileBottomNav)
    {
        <!-- Mobile Bottom Navigation Bar (Visible on mobile only: < 768px) -->
        <nav class="mobile-bottom-nav d-md-none" aria-label="Mobile Bottom Navigation">
            <a asp-controller="Home" asp-action="Index" class="@(currentController == "Home" ? "active" : "")">
                <i class="fa-solid fa-house"></i>
                <span>Home</span>
            </a>
            <a asp-controller="Astrologer" asp-action="Index" class="@(currentController == "Astrologer" ? "active" : "")">
                <i class="fa-solid fa-comments"></i>
                <span>Talk</span>
            </a>
            <a asp-controller="AiChat" asp-action="Index" class="@(currentController == "AiChat" ? "active" : "")">
                <i class="fa-solid fa-sparkles"></i>
                <span>AI Chat</span>
            </a>
            <a asp-controller="Kundli" asp-action="Index" class="@(currentController == "Kundli" ? "active" : "")">
                <i class="fa-solid fa-circle-nodes"></i>
                <span>Kundli</span>
            </a>
            <a asp-controller="Scans" asp-action="Index" class="@(currentController == "Scans" ? "active" : "")">
                <i class="fa-solid fa-hand"></i>
                <span>Scans</span>
            </a>
        </nav>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
