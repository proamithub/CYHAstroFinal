@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="theme-color" content="#0a0d14" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>@ViewData["Title"] - CYHAstro | India's Premier Vedic Astrology Platform</title>

    <!-- Resource Preconnects for Ultra Fast Mobile Speed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

    <!-- Google Fonts (Cinzel & Plus Jakarta Sans) -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-cosmic py-3">
            <div class="container">
                <!-- Brand -->
                <a class="navbar-brand d-flex align-items-center gap-2 brand-font fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="fs-4 text-warning"><i class="fa-solid fa-sun-plant-wilt fa-spin" style="--fa-animation-duration: 25s;"></i></span>
                    <span class="fs-4 text-white">CYH<span class="text-warning">Astro</span></span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fa-solid fa-bars fs-4 text-warning"></i>
                </button>

                <!-- Navigation Links -->
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Astrologer" asp-action="Index">
                                <i class="fa-solid fa-comments text-warning me-1"></i> Astrologers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Horoscope" asp-action="Index">
                                <i class="fa-solid fa-moon text-info me-1"></i> Daily Horoscope
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Panchang" asp-action="Index">
                                <i class="fa-solid fa-om text-warning me-1"></i> Panchang
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Kundli" asp-action="Index">
                                <i class="fa-solid fa-circle-nodes text-warning me-1"></i> Free Kundli
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Kundli" asp-action="Matchmaking">
                                <i class="fa-solid fa-heart text-danger me-1"></i> Kundli Milan
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="AiChat" asp-action="Index">
                                <i class="fa-solid fa-sparkles text-info me-1"></i> Ask AI Astrologer <span class="badge bg-warning text-dark ms-1" style="font-size: 0.65rem;">AI</span>
                            </a>
                        </li>
                    </ul>

                    <!-- User Actions -->
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Wallet Pill -->
                            <a asp-controller="Wallet" asp-action="Index" class="wallet-pill" title="Recharge Wallet">
                                <i class="fa-solid fa-wallet text-warning"></i>
                                <span>₹<span id="navWalletBalance">--</span></span>
                                <i class="fa-solid fa-circle-plus ms-1 text-warning"></i>
                            </a>

                            <!-- Notifications Bell -->
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary position-relative py-1 px-2 text-warning border-0"
                                        type="button" id="notifMenuButton" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                                    <i class="fa-solid fa-bell fs-5"></i>
                                    <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.65rem;">
                                        0
                                    </span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-warning shadow p-0" style="width: 320px; max-height: 400px; overflow-y: auto;" aria-labelledby="notifMenuButton">
                                    <div class="p-3 border-bottom border-secondary d-flex justify-content-between align-items-center bg-black">
                                        <h6 class="mb-0 text-white fw-bold brand-font small"><i class="fa-solid fa-bell text-warning me-1"></i> Notifications</h6>
                                        <button type="button" class="btn btn-link text-warning p-0 text-decoration-none small" style="font-size: 0.75rem;" onclick="markAllNotifsRead()">Mark all read</button>
                                    </div>
                                    <div id="notifListContainer">
                                        <div class="text-center py-4 text-secondary small">
                                            <i class="fa-solid fa-bell-slash fs-4 text-secondary mb-2 d-block opacity-50"></i>
                                            No notifications right now
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- User Dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-outline-gold dropdown-toggle d-flex align-items-center gap-2 py-1 px-3"
                                        type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-regular fa-circle-user text-warning fs-5"></i>
                                    <span>@(User.Identity?.Name ?? "My Account")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-warning shadow" aria-labelledby="userMenuButton">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="Index">
                                            <i class="fa-solid fa-id-card me-2 text-warning"></i> My Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="BirthProfiles">
                                            <i class="fa-solid fa-users me-2 text-info"></i> Saved Birth Profiles
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Wallet" asp-action="Index">
                                            <i class="fa-solid fa-receipt me-2 text-success"></i> Wallet & Passbook
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider border-secondary" /></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-danger" asp-controller="Auth" asp-action="Logout">
                                            <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Sign Out
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-gold px-3">
                                <i class="fa-regular fa-user me-1"></i> Sign In
                            </a>
                            <a asp-controller="Auth" asp-action="Register" class="btn btn-gold px-3">
                                Register Free
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1">
        <!-- Toast / Alert Container -->
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show bg-success text-white border-0 shadow" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show bg-danger text-white border-0 shadow" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Cosmic Footer -->
    <footer class="footer-cosmic text-muted mt-5">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 brand-font fw-bold mb-3">
                        <span class="fs-4 text-warning"><i class="fa-solid fa-sun-plant-wilt"></i></span>
                        <span class="fs-4 text-white">CYH<span class="text-warning">Astro</span></span>
                    </div>
                    <p class="small text-secondary mb-3">
                        India's premier enterprise astrology platform providing authentic Vedic horoscope calculations, Kundli synthesis, and 24/7 verified astrologer consultations with 100% privacy assurance.
                    </p>
                    <div class="d-flex gap-3 fs-5">
                        <a href="#" class="text-secondary hover-gold"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#" class="text-secondary hover-gold"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="text-secondary hover-gold"><i class="fa-brands fa-youtube"></i></a>
                        <a href="#" class="text-secondary hover-gold"><i class="fa-brands fa-whatsapp"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Astrology Tools</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Horoscope" asp-action="Index" class="text-secondary text-decoration-none">Daily Horoscope</a></li>
                        <li><a asp-controller="Kundli" asp-action="Index" class="text-secondary text-decoration-none">Free Janam Kundli</a></li>
                        <li><a asp-controller="Kundli" asp-action="Matchmaking" class="text-secondary text-decoration-none">Kundli Milan (36 Gunas)</a></li>
                        <li><a asp-controller="Astrologer" asp-action="Index" class="text-secondary text-decoration-none">Talk to Astrologer</a></li>
                        <li><a href="/Astrologer" class="text-warning text-decoration-none fw-bold"><i class="fa-solid fa-om me-1"></i> Astrologer Portal</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Specialties</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="/Astrologers?specialization=Vedic+Astrology" class="text-secondary text-decoration-none">Vedic Astrology</a></li>
                        <li><a href="/Astrologers?specialization=Tarot+Reading" class="text-secondary text-decoration-none">Tarot Reading</a></li>
                        <li><a href="/Astrologers?specialization=Numerology" class="text-secondary text-decoration-none">Numerology</a></li>
                        <li><a href="/Astrologers?specialization=KP+Astrology" class="text-secondary text-decoration-none">KP Astrology</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Enterprise Security & Compliance</h6>
                    <p class="small text-secondary mb-3">
                        <i class="fa-solid fa-shield-halved text-warning me-2"></i> All conversations and consultation audio/video sessions are end-to-end encrypted and completely confidential.
                    </p>
                    <div class="p-3 rounded bg-dark border border-secondary text-secondary small">
                        <strong>Disclaimer:</strong> Astrology is an ancient predictive science. Individual results may vary based on personal karma and planetary transits.
                    </div>
                </div>
            </div>

            <hr class="border-secondary opacity-25 my-4" />

            <div class="d-flex flex-wrap justify-content-between align-items-center small text-secondary">
                <div>
                    &copy; @DateTime.UtcNow.Year CYHAstro Platform. Built with .NET 10 LTS Enterprise Architecture.
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none">Privacy Policy</a>
                    <a href="#" class="text-secondary text-decoration-none">Terms of Service</a>
                    <a href="#" class="text-secondary text-decoration-none">Support & FAQs</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            // Live Wallet Balance & Notifications Fetch
            document.addEventListener("DOMContentLoaded", function () {
                fetch('/Client/Wallet/balance')
                    .then(res => res.ok ? res.json() : null)
                    .then(data => {
                        if (data && data.totalBalance !== undefined) {
                            const elem = document.getElementById("navWalletBalance");
                            if (elem) elem.innerText = parseFloat(data.totalBalance).toFixed(2);
                        }
                    })
                    .catch(() => {});

                // Auto-refresh wallet balance every 60 seconds
                setInterval(function() {
                    fetch('/Client/Wallet/balance')
                        .then(res => res.ok ? res.json() : null)
                        .then(data => {
                            if (data && data.totalBalance !== undefined) {
                                const elem = document.getElementById("navWalletBalance");
                                if (elem) elem.innerText = parseFloat(data.totalBalance).toFixed(2);
                            }
                        })
                        .catch(() => {});
                }, 60000);

                loadNotifications();
            });

            function loadNotifications() {
                fetch('/Client/Notifications/List')
                    .then(res => res.ok ? res.json() : null)
                    .then(data => {
                        if (!data || !data.success) return;

                        const badge = document.getElementById("notifBadge");
                        if (badge) {
                            if (data.unreadCount > 0) {
                                badge.innerText = data.unreadCount > 99 ? '99+' : data.unreadCount;
                                badge.classList.remove('d-none');
                            } else {
                                badge.classList.add('d-none');
                            }
                        }

                        const container = document.getElementById("notifListContainer");
                        if (!container) return;

                        if (data.items && data.items.length > 0) {
                            container.innerHTML = data.items.map(n => `
                                <div class="p-3 border-bottom border-secondary ${n.isRead ? 'opacity-75' : 'bg-dark bg-opacity-50'} position-relative" style="cursor: pointer;" onclick="markSingleNotifRead(${n.id}, '${n.actionUrl || ''}')">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <span class="fw-bold ${n.isRead ? 'text-light' : 'text-warning'} small">${escapeHtml(n.title)}</span>
                                        ${!n.isRead ? '<span class="badge bg-warning text-dark" style="font-size: 0.6rem;">NEW</span>' : ''}
                                    </div>
                                    <p class="text-secondary small mb-1 lh-sm">${escapeHtml(n.message)}</p>
                                    <span class="text-muted" style="font-size: 0.65rem;">${new Date(n.createdAt).toLocaleDateString()}</span>
                                </div>
                            `).join('');
                        } else {
                            container.innerHTML = `
                                <div class="text-center py-4 text-secondary small">
                                    <i class="fa-solid fa-bell-slash fs-4 text-secondary mb-2 d-block opacity-50"></i>
                                    No notifications right now
                                </div>`;
                        }
                    })
                    .catch(() => {});
            }

            function markSingleNotifRead(id, actionUrl) {
                const formData = new FormData();
                formData.append('id', id);
                fetch('/Client/Notifications/MarkRead', {
                    method: 'POST',
                    body: formData
                }).then(() => {
                    if (actionUrl && actionUrl !== 'null' && actionUrl.trim() !== '') {
                        window.location.href = actionUrl;
                    } else {
                        loadNotifications();
                    }
                }).catch(() => {});
            }

            function markAllNotifsRead() {
                fetch('/Client/Notifications/MarkAllRead', {
                    method: 'POST'
                }).then(() => {
                    loadNotifications();
                }).catch(() => {});
            }

            function escapeHtml(str) {
                if (!str) return '';
                return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
            }
        </script>
    }

    <!-- Mobile Bottom Navigation Bar (Visible on mobile only: < 768px) -->
    <nav class="mobile-bottom-nav d-md-none" aria-label="Mobile Bottom Navigation">
        <a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
            <i class="fa-solid fa-house"></i>
            <span>Home</span>
        </a>
        <a asp-controller="Astrologer" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Astrologer" ? "active" : "")">
            <i class="fa-solid fa-comments"></i>
            <span>Talk</span>
        </a>
        <a asp-controller="Horoscope" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Horoscope" ? "active" : "")">
            <i class="fa-solid fa-moon"></i>
            <span>Horoscope</span>
        </a>
        <a asp-controller="Kundli" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Kundli" ? "active" : "")">
            <i class="fa-solid fa-circle-nodes"></i>
            <span>Kundli</span>
        </a>
        <a asp-controller="Wallet" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Wallet" ? "active" : "")">
            <i class="fa-solid fa-wallet"></i>
            <span>Wallet</span>
        </a>
    </nav>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
