@model IReadOnlyList<CYHAstro.Core.DTOs.User.BirthProfileDto>
@{
    ViewData["Title"] = "Saved Birth Profiles";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-warning text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index" class="text-warning text-decoration-none">My Account</a></li>
            <li class="breadcrumb-item active text-light" aria-current="page">Saved Birth Profiles</li>
        </ol>
    </nav>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Top Action Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary gap-3">
        <div>
            <h3 class="text-white fw-bold mb-1 brand-font">
                <i class="fa-solid fa-users-rays text-warning me-2"></i>Family & Saved Birth Profiles
            </h3>
            <p class="text-secondary small mb-0">
                Store birth charts for yourself and family to instantly launch Kundli readings, matchmaking, and consultations.
            </p>
        </div>
        <div>
            <button type="button" class="btn btn-warning fw-bold d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newProfileModal">
                <i class="fa-solid fa-circle-plus"></i> Add New Profile
            </button>
        </div>
    </div>

    <!-- Profiles Grid -->
    @if (Model == null || !Model.Any())
    {
        <div class="card bg-dark border-secondary p-5 text-center rounded-4 shadow">
            <div class="py-4">
                <i class="fa-solid fa-address-book text-secondary fs-1 mb-3"></i>
                <h5 class="text-white fw-bold">No Birth Profiles Saved Yet</h5>
                <p class="text-secondary small mb-4">
                    Add your birth details or those of your family members to quickly generate Vedic charts and match Kundlis without retyping.
                </p>
                <button type="button" class="btn btn-outline-gold" data-bs-toggle="modal" data-bs-target="#newProfileModal">
                    <i class="fa-solid fa-plus me-1"></i> Add Your First Profile
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var p in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card bg-dark border-secondary h-100 rounded-4 shadow-sm position-relative overflow-hidden">
                        <div class="position-absolute top-0 end-0 p-3">
                            <span class="badge @(p.IsPrimary ? "bg-warning text-dark" : "bg-secondary text-light")">
                                @(p.IsPrimary ? "Primary Chart" : p.RelationLabel)
                            </span>
                        </div>
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="rounded-circle bg-black border border-warning d-flex align-items-center justify-content-center text-warning"
                                     style="width: 50px; height: 50px; font-size: 1.5rem;">
                                    <i class="fa-solid @(p.Gender == "F" ? "fa-person-dress" : "fa-person")"></i>
                                </div>
                                <div>
                                    <h5 class="text-white fw-bold mb-0">@p.Name</h5>
                                    <span class="text-secondary small">Relation: <span class="text-light">@p.RelationLabel</span></span>
                                </div>
                            </div>

                            <ul class="list-unstyled small mb-4">
                                <li class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-50">
                                    <span class="text-secondary"><i class="fa-solid fa-calendar-day me-2 text-warning"></i>Date of Birth</span>
                                    <span class="text-white">@p.DateOfBirth.ToString("dd MMM yyyy")</span>
                                </li>
                                <li class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-50">
                                    <span class="text-secondary"><i class="fa-solid fa-clock me-2 text-info"></i>Time of Birth</span>
                                    <span class="text-white">@(p.TimeOfBirth.HasValue ? DateTime.Today.Add(p.TimeOfBirth.Value).ToString("hh:mm tt") : "Approximate")</span>
                                </li>
                                <li class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-50">
                                    <span class="text-secondary"><i class="fa-solid fa-location-dot me-2 text-danger"></i>Birth Place</span>
                                    <span class="text-white text-truncate" style="max-width: 150px;" title="@p.BirthPlace">@p.BirthPlace</span>
                                </li>
                                <li class="d-flex justify-content-between py-1">
                                    <span class="text-secondary"><i class="fa-solid fa-earth-americas me-2 text-success"></i>Coordinates</span>
                                    <span class="text-secondary font-monospace">@p.Latitude.ToString("F2")°N, @p.Longitude.ToString("F2")°E</span>
                                </li>
                            </ul>

                            <div class="d-flex gap-2">
                                <a asp-controller="Kundli" asp-action="Index"
                                   class="btn btn-sm btn-outline-gold flex-grow-1">
                                    <i class="fa-solid fa-circle-nodes me-1"></i> Open Kundli
                                </a>
                                <form asp-controller="Dashboard" asp-action="DeleteBirthProfile" method="post" onsubmit="return confirm('Delete birth profile for @p.Name?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="profileId" value="@p.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Profile">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal: Add New Birth Profile -->
<div class="modal fade" id="newProfileModal" tabindex="-1" aria-labelledby="newProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-secondary text-light rounded-4 shadow-lg">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-warning fw-bold" id="newProfileModalLabel">
                    <i class="fa-solid fa-circle-plus me-2"></i>Add Saved Birth Profile
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Dashboard" asp-action="CreateBirthProfile" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-light fw-medium">Full Name <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control bg-black text-light border-secondary" placeholder="e.g. Rahul Sharma" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-light fw-medium">Gender</label>
                            <select name="Gender" class="form-select bg-black text-light border-secondary">
                                <option value="M">Male</option>
                                <option value="F">Female</option>
                                <option value="O">Other</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-light fw-medium">Relation</label>
                            <select name="RelationLabel" class="form-select bg-black text-light border-secondary">
                                <option value="Self">Self</option>
                                <option value="Spouse">Spouse</option>
                                <option value="Son">Son</option>
                                <option value="Daughter">Daughter</option>
                                <option value="Father">Father</option>
                                <option value="Mother">Mother</option>
                                <option value="Brother">Brother</option>
                                <option value="Sister">Sister</option>
                                <option value="Friend">Friend</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-light fw-medium">Date of Birth <span class="text-danger">*</span></label>
                            <input type="date" name="DateOfBirth" class="form-control bg-black text-light border-secondary" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-light fw-medium">Time of Birth <span class="text-danger">*</span></label>
                            <input type="time" name="TimeOfBirth" class="form-control bg-black text-light border-secondary" step="1" required />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label text-light fw-medium">Birth City / Location <span class="text-danger">*</span></label>
                            <input type="text" id="bpCity" name="BirthPlace" class="form-control bg-black text-light border-secondary"
                                   placeholder="e.g. New Delhi, India" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-light fw-medium">Latitude</label>
                            <input type="number" step="0.0001" id="bpLat" name="Latitude" class="form-control bg-black text-light border-secondary" value="28.6139" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-light fw-medium">Longitude</label>
                            <input type="number" step="0.0001" id="bpLng" name="Longitude" class="form-control bg-black text-light border-secondary" value="77.2090" required />
                        </div>

                        <div class="col-12 mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="IsPrimary" value="true" id="isPrimaryCheck" />
                                <label class="form-check-label text-light" for="isPrimaryCheck">
                                    Set this as my Primary Birth Chart for daily horoscope insights
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning px-4 fw-bold">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Profile
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
