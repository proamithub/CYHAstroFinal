@model CYHAstro.Core.DTOs.Auth.UserProfileDto
@using CYHAstro.Core.DTOs.User
@using CYHAstro.Core.DTOs.Consultation
@using CYHAstro.Core.DTOs.Wallet
@{
    ViewData["Title"] = "My Account & Astrological Dashboard";
    var pref = ViewBag.Preferences as UserPreferenceDto ?? new UserPreferenceDto();
    var birthProfiles = ViewBag.BirthProfiles as IReadOnlyList<BirthProfileDto> ?? new List<BirthProfileDto>();
    var consultations = ViewBag.Consultations as IReadOnlyList<ConsultationResponseDto> ?? new List<ConsultationResponseDto>();
    var transactions = ViewBag.Transactions as IReadOnlyList<WalletTransactionDto> ?? new List<WalletTransactionDto>();
    decimal walletBal = (decimal)(ViewBag.WalletBalance ?? 0m);
    string activeTab = ViewBag.ActiveTab as string ?? "profile";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-warning text-decoration-none">Home</a></li>
            <li class="breadcrumb-item active text-light" aria-current="page">My Account</li>
        </ol>
    </nav>

    <!-- Notification Toasts / Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Stat Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card bg-dark border-secondary rounded-4 p-3 shadow-sm h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning me-3">
                        <i class="fa-solid fa-wallet fs-4"></i>
                    </div>
                    <div>
                        <div class="text-secondary small">Wallet Balance</div>
                        <h4 class="text-warning fw-bold mb-0">₹@walletBal.ToString("F2")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card bg-dark border-secondary rounded-4 p-3 shadow-sm h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info me-3">
                        <i class="fa-solid fa-comments fs-4"></i>
                    </div>
                    <div>
                        <div class="text-secondary small">Consultations</div>
                        <h4 class="text-white fw-bold mb-0">@consultations.Count</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card bg-dark border-secondary rounded-4 p-3 shadow-sm h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success me-3">
                        <i class="fa-solid fa-users fs-4"></i>
                    </div>
                    <div>
                        <div class="text-secondary small">Saved Kundlis</div>
                        <h4 class="text-white fw-bold mb-0">@birthProfiles.Count</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card bg-dark border-secondary rounded-4 p-3 shadow-sm h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning me-3">
                        <i class="fa-solid fa-sparkles fs-4"></i>
                    </div>
                    <div>
                        <div class="text-secondary small">AI Astrology</div>
                        <a href="/AiChat" class="badge bg-warning text-dark text-decoration-none fw-bold mt-1">Chat Free &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills nav-fill bg-dark border border-secondary border-opacity-50 rounded-4 p-2 mb-4 shadow-sm" id="dashboardTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-3 @(activeTab == "profile" ? "active" : "") fw-bold py-2" id="profile-tab" data-bs-toggle="tab" data-bs-target="#tab-profile" type="button" role="tab">
                <i class="fa-solid fa-user-gear me-2"></i> Profile & Settings
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-3 @(activeTab == "consultations" ? "active" : "") fw-bold py-2" id="consultations-tab" data-bs-toggle="tab" data-bs-target="#tab-consultations" type="button" role="tab">
                <i class="fa-solid fa-phone-volume me-2"></i> Consultations (@consultations.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-3 @(activeTab == "kundlis" ? "active" : "") fw-bold py-2" id="kundlis-tab" data-bs-toggle="tab" data-bs-target="#tab-kundlis" type="button" role="tab">
                <i class="fa-solid fa-circle-nodes me-2"></i> Family Kundlis (@birthProfiles.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-3 @(activeTab == "wallet" ? "active" : "") fw-bold py-2" id="wallet-tab" data-bs-toggle="tab" data-bs-target="#tab-wallet" type="button" role="tab">
                <i class="fa-solid fa-receipt me-2"></i> Wallet Passbook
            </button>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="dashboardTabsContent">
        <!-- ==================== TAB 1: PROFILE & SETTINGS ==================== -->
        <div class="tab-pane fade @(activeTab == "profile" ? "show active" : "")" id="tab-profile" role="tabpanel">
            <div class="row g-4">
                <!-- User Summary Column -->
                <div class="col-lg-4">
                    <div class="card bg-dark border-secondary shadow rounded-4 overflow-hidden mb-4">
                        <div class="card-header bg-black bg-opacity-50 p-4 text-center border-bottom border-secondary">
                            <div class="rounded-circle bg-dark d-inline-flex align-items-center justify-content-center text-warning border border-2 border-warning shadow"
                                 style="width: 80px; height: 80px; font-size: 2.2rem;">
                                <i class="fa-solid fa-user-astronaut"></i>
                            </div>
                            <h5 class="mt-3 mb-0 text-white fw-bold">@(Model?.DisplayName ?? "Cosmic Seeker")</h5>
                            <span class="badge bg-warning text-dark mt-1">Verified Member</span>
                        </div>
                        <div class="card-body p-4">
                            <ul class="list-unstyled mb-0">
                                <li class="d-flex justify-content-between py-2 border-bottom border-secondary">
                                    <span class="text-secondary"><i class="fa-solid fa-envelope me-2 text-warning"></i>Email</span>
                                    <span class="text-white fw-medium">@(Model?.Email ?? "N/A")</span>
                                </li>
                                <li class="d-flex justify-content-between py-2 border-bottom border-secondary">
                                    <span class="text-secondary"><i class="fa-solid fa-phone me-2 text-info"></i>Phone</span>
                                    <span class="text-white fw-medium">@(string.IsNullOrEmpty(Model?.PhoneNumber) ? "Not Linked" : Model.PhoneNumber)</span>
                                </li>
                                <li class="d-flex justify-content-between py-2">
                                    <span class="text-secondary"><i class="fa-solid fa-wallet me-2 text-success"></i>Wallet</span>
                                    <span class="text-warning fw-bold">₹@walletBal.ToString("F2")</span>
                                </li>
                            </ul>
                            <div class="mt-4">
                                <a asp-controller="Wallet" asp-action="Index" class="btn btn-warning w-100 fw-bold rounded-pill text-dark shadow-sm">
                                    <i class="fa-solid fa-plus-circle me-1"></i> Recharge Wallet
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Forms Column -->
                <div class="col-lg-8">
                    <!-- Profile Update Form -->
                    <div class="card bg-dark border-secondary shadow rounded-4 p-4 mb-4">
                        <h5 class="card-title text-warning fw-bold mb-4">
                            <i class="fa-solid fa-pen-to-square me-2"></i>Personal Details
                        </h5>
                        <form asp-action="UpdateProfile" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-secondary small">Display Name</label>
                                    <input type="text" name="DisplayName" class="form-control bg-black border-secondary text-light"
                                           value="@Model?.DisplayName" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-secondary small">Phone Number</label>
                                    <input type="tel" name="PhoneNumber" class="form-control bg-black border-secondary text-light"
                                           value="@Model?.PhoneNumber" placeholder="+91 9876543210" />
                                </div>
                                <div class="col-12 mt-4 text-end">
                                    <button type="submit" class="btn btn-warning px-4 fw-bold rounded-pill text-dark">
                                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Astrological Preferences Form -->
                    <div class="card bg-dark border-secondary shadow rounded-4 p-4">
                        <h5 class="card-title text-warning fw-bold mb-4">
                            <i class="fa-solid fa-sliders me-2"></i>Vedic Astrological Preferences
                        </h5>
                        <form asp-action="UpdatePreferences" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-secondary small">Chart Display Style</label>
                                    <select name="PreferredChartStyle" class="form-select bg-black border-secondary text-light">
                                        <option value="NorthIndian" selected="@(pref.PreferredChartStyle == "NorthIndian" ? "selected" : null)">North Indian (Diamond)</option>
                                        <option value="SouthIndian" selected="@(pref.PreferredChartStyle == "SouthIndian" ? "selected" : null)">South Indian (Square)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-secondary small">Ayanamsha Calculation</label>
                                    <select name="PreferredAyanamsha" class="form-select bg-black border-secondary text-light">
                                        <option value="Lahiri" selected="@(pref.PreferredAyanamsha == "Lahiri" ? "selected" : null)">Lahiri (Chitrapaksha - Default)</option>
                                        <option value="Raman" selected="@(pref.PreferredAyanamsha == "Raman" ? "selected" : null)">B.V. Raman</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" name="ReceiveDailyNotification" value="true" id="dailyNotif" checked="@(pref.ReceiveDailyNotification ? "checked" : null)" />
                                        <label class="form-check-label text-secondary small" for="dailyNotif">Receive Daily Horoscope Notifications</label>
                                    </div>
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" name="ReceivePromoAlerts" value="true" id="promoNotif" checked="@(pref.ReceivePromoAlerts ? "checked" : null)" />
                                        <label class="form-check-label text-secondary small" for="promoNotif">Receive Planetary Transit & Panchang Alerts</label>
                                    </div>
                                </div>
                                <div class="col-12 mt-4 text-end">
                                    <button type="submit" class="btn btn-outline-warning px-4 fw-bold rounded-pill">
                                        <i class="fa-solid fa-check me-1"></i> Update Preferences
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== TAB 2: CONSULTATIONS HISTORY ==================== -->
        <div class="tab-pane fade @(activeTab == "consultations" ? "show active" : "")" id="tab-consultations" role="tabpanel">
            <div class="card bg-dark border-secondary shadow rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="text-warning fw-bold mb-0">
                        <i class="fa-solid fa-clock-rotate-left me-2"></i>My Consultations History
                    </h5>
                    <a href="/Astrologers" class="btn btn-warning btn-sm rounded-pill fw-bold text-dark">
                        <i class="fa-solid fa-headset me-1"></i> Consult New Astrologer
                    </a>
                </div>

                @if (!consultations.Any())
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="fa-solid fa-comments fs-1 text-warning opacity-25 mb-3"></i>
                        <h5>No consultations yet</h5>
                        <p class="small mb-3">Connect with certified Vedic Astrologers via Live Audio, Video, or Chat.</p>
                        <a href="/Astrologers" class="btn btn-outline-warning btn-sm rounded-pill">Explore Astrologers</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0">
                            <thead>
                                <tr class="border-secondary text-secondary small">
                                    <th>Astrologer</th>
                                    <th>Type</th>
                                    <th>Date & Time</th>
                                    <th>Duration</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in consultations)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@(string.IsNullOrEmpty(c.AstrologerPhoto) ? "/img/default-astro.png" : c.AstrologerPhoto)"
                                                     class="rounded-circle me-2 border border-warning" style="width: 38px; height: 38px; object-fit: cover;"
                                                     onerror="this.src='/img/default-astro.png';" />
                                                <div>
                                                    <div class="fw-bold text-white small">@c.AstrologerName</div>
                                                    <span class="text-secondary" style="font-size: 0.7rem;">₹@c.RatePerMinute.ToString("F0")/min</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (c.SessionType == "VIDEO")
                                            {
                                                <span class="badge bg-danger bg-opacity-25 text-danger"><i class="fa-solid fa-video me-1"></i> Video</span>
                                            }
                                            else if (c.SessionType == "AUDIO")
                                            {
                                                <span class="badge bg-info bg-opacity-25 text-info"><i class="fa-solid fa-phone me-1"></i> Audio</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-25 text-warning"><i class="fa-solid fa-comments me-1"></i> Chat</span>
                                            }
                                        </td>
                                        <td class="small text-secondary">@c.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                        <td class="font-monospace text-light">@(c.DurationSeconds / 60)m @(c.DurationSeconds % 60)s</td>
                                        <td class="fw-bold text-warning font-monospace">₹@c.TotalCharge.ToString("F2")</td>
                                        <td>
                                            @if (c.Status == "COMPLETED")
                                            {
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">Completed</span>
                                            }
                                            else if (c.Status == "IN_PROGRESS" || c.Status == "ACCEPTED")
                                            {
                                                <span class="badge bg-warning text-dark fw-bold">Active Now</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@c.Status</span>
                                            }
                                        </td>
                                        <td>
                                            @if (c.Status == "IN_PROGRESS" || c.Status == "ACCEPTED")
                                            {
                                                <a href="/Consultation/Room/@c.PublicId" class="btn btn-warning btn-sm rounded-pill fw-bold text-dark">
                                                    Join Room &rarr;
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-secondary btn-sm rounded-pill" onclick="alert('Session ID: @c.PublicId\nAstrologer: @c.AstrologerName\nDuration: @(c.DurationSeconds/60)m @(c.DurationSeconds%60)s\nTotal Charged: ₹@c.TotalCharge.ToString("F2")')">
                                                    Receipt
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- ==================== TAB 3: FAMILY KUNDLIS ==================== -->
        <div class="tab-pane fade @(activeTab == "kundlis" ? "show active" : "")" id="tab-kundlis" role="tabpanel">
            <div class="card bg-dark border-secondary shadow rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="text-warning fw-bold mb-1">
                            <i class="fa-solid fa-circle-nodes me-2"></i>Saved Birth Profiles & Family Kundlis
                        </h5>
                        <p class="text-secondary small mb-0">Save birth charts for yourself and family members for instant analysis during consultations.</p>
                    </div>
                    <button class="btn btn-warning btn-sm rounded-pill fw-bold text-dark" data-bs-toggle="modal" data-bs-target="#addProfileModal">
                        <i class="fa-solid fa-plus me-1"></i> Add Birth Chart
                    </button>
                </div>

                @if (!birthProfiles.Any())
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="fa-solid fa-om fs-1 text-warning opacity-25 mb-3"></i>
                        <h5>No birth profiles saved</h5>
                        <p class="small mb-3">Save your birth profile to personalize your AI readings and Kundli calculations.</p>
                        <button class="btn btn-outline-warning btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#addProfileModal">
                            Add Your First Kundli
                        </button>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var p in birthProfiles)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card bg-black bg-opacity-40 border-secondary rounded-4 p-3 h-100 shadow-sm position-relative">
                                    @if (p.IsPrimary)
                                    {
                                        <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 fw-bold">Primary</span>
                                    }
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center p-2 me-3" style="width: 44px; height: 44px;">
                                            <i class="fa-solid fa-star fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="text-white fw-bold mb-0">@p.Name</h6>
                                            <span class="text-secondary small">Gender: @(p.Gender == "F" ? "Female" : "Male")</span>
                                        </div>
                                    </div>
                                    <ul class="list-unstyled text-secondary small mb-3">
                                        <li><i class="fa-regular fa-calendar me-2 text-warning"></i>@p.DateOfBirth.ToString("dd MMM yyyy")</li>
                                        <li><i class="fa-regular fa-clock me-2 text-info"></i>@(p.TimeOfBirth.HasValue ? p.TimeOfBirth.Value.ToString("hh:mm tt") : "Not provided")</li>
                                        <li class="text-truncate"><i class="fa-solid fa-location-dot me-2 text-danger"></i>@p.BirthPlace</li>
                                    </ul>
                                    <div class="d-flex gap-2 mt-auto pt-2 border-top border-secondary border-opacity-50">
                                        <a href="/Kundli?name=@Uri.EscapeDataString(p.Name)&dob=@p.DateOfBirth.ToString("yyyy-MM-dd")&place=@Uri.EscapeDataString(p.BirthPlace)&lat=@p.Latitude&lon=@p.Longitude" class="btn btn-outline-warning btn-sm rounded-pill flex-grow-1">
                                            View Kundli
                                        </a>
                                        <form asp-action="DeleteBirthProfile" method="post" onsubmit="return confirm('Delete this birth profile?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="profileId" value="@p.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle" title="Delete">
                                                <i class="fa-regular fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- ==================== TAB 4: WALLET PASSBOOK ==================== -->
        <div class="tab-pane fade @(activeTab == "wallet" ? "show active" : "")" id="tab-wallet" role="tabpanel">
            <div class="row g-4">
                <!-- Balance & Recharge Action Card -->
                <div class="col-lg-4">
                    <div class="card bg-dark border-secondary shadow rounded-4 p-4 text-center">
                        <span class="text-secondary small text-uppercase fw-semibold">Available Wallet Balance</span>
                        <h2 class="text-warning fw-bold my-2 font-monospace">₹@walletBal.ToString("F2")</h2>
                        <p class="text-secondary small mb-4">Balance is automatically deducted during live consultations per minute.</p>
                        <a asp-controller="Wallet" asp-action="Index" class="btn btn-warning w-100 fw-bold rounded-pill text-dark py-2 shadow-sm">
                            <i class="fa-solid fa-circle-plus me-2"></i> Recharge Wallet Now
                        </a>
                    </div>
                </div>

                <!-- Ledger Transactions Table -->
                <div class="col-lg-8">
                    <div class="card bg-dark border-secondary shadow rounded-4 p-4">
                        <h5 class="text-warning fw-bold mb-3">
                            <i class="fa-solid fa-receipt me-2"></i>Recent Transactions Passbook
                        </h5>
                        @if (!transactions.Any())
                        {
                            <div class="text-center py-5 text-secondary">
                                <i class="fa-solid fa-receipt fs-1 text-warning opacity-25 mb-3"></i>
                                <h5>No transactions found</h5>
                                <p class="small">Your recharge history and consultation billing deductions will appear here.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-dark table-hover align-middle mb-0">
                                    <thead>
                                        <tr class="border-secondary text-secondary small">
                                            <th>Type</th>
                                            <th>Description</th>
                                            <th>Date</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-end">Balance After</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in transactions)
                                        {
                                            bool isCredit = t.TransactionType == "CREDIT";
                                            <tr>
                                                <td>
                                                    @if (isCredit)
                                                    {
                                                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50"><i class="fa-solid fa-arrow-down me-1"></i> Credit</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50"><i class="fa-solid fa-arrow-up me-1"></i> Debit</span>
                                                    }
                                                </td>
                                                <td class="small">
                                                    <div class="text-white fw-medium">@t.Description</div>
                                                    <span class="text-secondary font-monospace" style="font-size: 0.65rem;">Ref: @t.ReferenceId</span>
                                                </td>
                                                <td class="small text-secondary">@t.CreatedAt.ToString("dd MMM, hh:mm tt")</td>
                                                <td class="text-end font-monospace fw-bold @(isCredit ? "text-success" : "text-danger")">
                                                    @(isCredit ? "+" : "-")₹@t.Amount.ToString("F2")
                                                </td>
                                                <td class="text-end font-monospace text-secondary small">
                                                    ₹@t.BalanceAfter.ToString("F2")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add New Birth Profile -->
<div class="modal fade" id="addProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-warning border-opacity-50 text-white rounded-4 shadow-lg">
            <div class="modal-header border-secondary border-opacity-50">
                <h5 class="modal-title text-warning fw-bold"><i class="fa-solid fa-user-plus me-2"></i>Add Family Kundli Profile</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateBirthProfile" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Full Name</label>
                        <input type="text" name="Name" class="form-control bg-black border-secondary text-white" placeholder="e.g. Priya Sharma" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Gender</label>
                        <select name="Gender" class="form-select bg-black border-secondary text-white">
                            <option value="M">Male</option>
                            <option value="F">Female</option>
                            <option value="O">Other</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-secondary small">Date of Birth</label>
                            <input type="date" name="DateOfBirth" class="form-control bg-black border-secondary text-white" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-secondary small">Time of Birth</label>
                            <input type="time" name="TimeOfBirth" class="form-control bg-black border-secondary text-white" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Place of Birth (City, Country)</label>
                        <input type="text" name="BirthPlace" class="form-control bg-black border-secondary text-white" placeholder="e.g. New Delhi, India" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-secondary small">Latitude (approx)</label>
                            <input type="number" step="0.0001" name="Latitude" class="form-control bg-black border-secondary text-white" value="28.6139" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-secondary small">Longitude (approx)</label>
                            <input type="number" step="0.0001" name="Longitude" class="form-control bg-black border-secondary text-white" value="77.2090" required />
                        </div>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="IsPrimary" value="true" class="form-check-input" id="checkPrimary" />
                        <label class="form-check-label text-secondary small" for="checkPrimary">Set as Primary Birth Profile</label>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-50">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning rounded-pill fw-bold text-dark px-4">Save Kundli</button>
                </div>
            </form>
        </div>
    </div>
</div>
