@model CYHAstro.Core.DTOs.Auth.UserProfileDto
@using CYHAstro.Core.DTOs.User
@{
    ViewData["Title"] = "My Profile & Astrological Settings";
    var pref = ViewBag.Preferences as UserPreferenceDto ?? new UserPreferenceDto();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-warning text-decoration-none">Home</a></li>
            <li class="breadcrumb-item active text-light" aria-current="page">My Account</li>
            <li class="breadcrumb-item active text-secondary" aria-current="page">Profile Settings</li>
        </ol>
    </nav>

    <!-- Notification Toasts / Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: User Summary Card -->
        <div class="col-lg-4">
            <div class="card bg-dark border-secondary shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-gradient-gold p-4 text-center border-0">
                    <div class="position-relative d-inline-block">
                        <div class="rounded-circle bg-dark d-flex align-items-center justify-content-center text-warning border border-2 border-warning shadow"
                             style="width: 90px; height: 90px; font-size: 2.5rem;">
                            <i class="fa-solid fa-user-astronaut"></i>
                        </div>
                    </div>
                    <h5 class="mt-3 mb-0 text-white fw-bold">@(Model?.DisplayName ?? "Cosmic Seeker")</h5>
                    <span class="badge bg-warning text-dark mt-1">Verified Member</span>
                </div>
                <div class="card-body p-4">
                    <ul class="list-unstyled mb-0">
                        <li class="d-flex justify-content-between py-2 border-bottom border-secondary">
                            <span class="text-secondary"><i class="fa-solid fa-envelope me-2 text-warning"></i>Email</span>
                            <span class="text-white fw-medium">@(Model?.Email ?? "N/A")</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom border-secondary">
                            <span class="text-secondary"><i class="fa-solid fa-phone me-2 text-info"></i>Phone</span>
                            <span class="text-white fw-medium">@(string.IsNullOrEmpty(Model?.PhoneNumber) ? "Not Linked" : Model.PhoneNumber)</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom border-secondary">
                            <span class="text-secondary"><i class="fa-solid fa-wallet me-2 text-success"></i>Wallet</span>
                            <span class="text-warning fw-bold">₹@(Model?.WalletBalance.ToString("F2") ?? "0.00")</span>
                        </li>
                        <li class="d-flex justify-content-between py-2">
                            <span class="text-secondary"><i class="fa-solid fa-fingerprint me-2 text-warning"></i>Account ID</span>
                            <span class="text-secondary font-monospace small">@(Model?.PublicId != null ? Model.PublicId.Substring(0, Math.Min(12, Model.PublicId.Length)) + "..." : "N/A")</span>
                        </li>
                    </ul>

                    <div class="mt-4 d-grid gap-2">
                        <a asp-controller="Wallet" asp-action="Index" class="btn btn-warning fw-bold">
                            <i class="fa-solid fa-plus-circle me-1"></i> Recharge Wallet
                        </a>
                        <a asp-controller="Dashboard" asp-action="BirthProfiles" class="btn btn-outline-light">
                            <i class="fa-solid fa-users me-1 text-info"></i> Manage Birth Profiles
                        </a>
                    </div>
                </div>
            </div>

            <!-- Quick Tip Card -->
            <div class="card bg-dark border-secondary p-4 rounded-4 shadow">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <i class="fa-solid fa-om text-warning fs-3"></i>
                    <h6 class="text-white mb-0 fw-bold">Vedic Astrology Accuracy</h6>
                </div>
                <p class="small text-secondary mb-0">
                    To receive precision planetary predictions and horoscope insights, maintain accurate birth time (within 5 minutes) and birth city coordinates.
                </p>
            </div>
        </div>

        <!-- Right Column: Settings Tabs & Forms -->
        <div class="col-lg-8">
            <!-- Navigation Tabs -->
            <ul class="nav nav-pills mb-4 gap-2" id="profileTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-pill px-4" id="basic-tab" data-bs-toggle="pill" data-bs-target="#basic-info" type="button" role="tab">
                        <i class="fa-solid fa-user-pen me-2"></i>Personal Details
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4" id="astro-tab" data-bs-toggle="pill" data-bs-target="#astro-prefs" type="button" role="tab">
                        <i class="fa-solid fa-sun me-2"></i>Astrology Preferences
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="profileTabsContent">
                <!-- Personal Details Tab -->
                <div class="tab-pane fade show active" id="basic-info" role="tabpanel">
                    <div class="card bg-dark border-secondary p-4 rounded-4 shadow">
                        <h5 class="text-white fw-bold mb-4">
                            <i class="fa-solid fa-id-card-clip text-warning me-2"></i>Edit Profile Information
                        </h5>
                        <form asp-controller="Dashboard" asp-action="UpdateProfile" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-light fw-medium">Display Name <span class="text-danger">*</span></label>
                                    <input type="text" name="DisplayName" class="form-control bg-black text-light border-secondary"
                                           value="@(Model?.DisplayName)" required maxlength="100" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-light fw-medium">Phone Number</label>
                                    <input type="tel" name="PhoneNumber" class="form-control bg-black text-light border-secondary"
                                           value="@(Model?.PhoneNumber)" placeholder="+919876543210" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-light fw-medium">Gender</label>
                                    <select name="Gender" class="form-select bg-black text-light border-secondary">
                                        <option value="M">Male</option>
                                        <option value="F">Female</option>
                                        <option value="O">Other</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-light fw-medium">Preferred Language</label>
                                    <select name="PreferredLanguage" class="form-select bg-black text-light border-secondary">
                                        <option value="en">English</option>
                                        <option value="hi">Hindi (हिन्दी)</option>
                                        <option value="bn">Bengali (বাংলা)</option>
                                        <option value="ta">Tamil (தமிழ்)</option>
                                        <option value="te">Telugu (తెలుగు)</option>
                                        <option value="mr">Marathi (मराठी)</option>
                                        <option value="gu">Gujarati (ગુજરાતી)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mt-4 text-end">
                                <button type="submit" class="btn btn-warning px-4 fw-bold">
                                    <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Astrological Preferences Tab -->
                <div class="tab-pane fade" id="astro-prefs" role="tabpanel">
                    <div class="card bg-dark border-secondary p-4 rounded-4 shadow">
                        <h5 class="text-white fw-bold mb-4">
                            <i class="fa-solid fa-compass-drafting text-warning me-2"></i>Chart & Notification Configurations
                        </h5>
                        <form asp-controller="Dashboard" asp-action="UpdatePreferences" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-light fw-medium">Chart Representation Style</label>
                                    <select name="PreferredChartStyle" class="form-select bg-black text-light border-secondary">
                                        <!option value="NorthIndian" @(pref.PreferredChartStyle == "NorthIndian" ? "selected" : "")>North Indian (Diamond / Sukshma)</!option>
                                        <!option value="SouthIndian" @(pref.PreferredChartStyle == "SouthIndian" ? "selected" : "")>South Indian (Box / Sthira)</!option>
                                        <!option value="EastIndian" @(pref.PreferredChartStyle == "EastIndian" ? "selected" : "")>East Indian (Bengali/Odia Style)</!option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-light fw-medium">Ayanamsha System</label>
                                    <select name="PreferredAyanamsha" class="form-select bg-black text-light border-secondary">
                                        <!option value="Lahiri" @(pref.PreferredAyanamsha == "Lahiri" ? "selected" : "")>Chitra Paksha / Lahiri (Standard)</!option>
                                        <!option value="Raman" @(pref.PreferredAyanamsha == "Raman" ? "selected" : "")>BV Raman</!option>
                                        <!option value="KP" @(pref.PreferredAyanamsha == "KP" ? "selected" : "")>Krishnamurti Padhdhati (KP)</!option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-light fw-medium">Visual Theme</label>
                                    <select name="ThemeMode" class="form-select bg-black text-light border-secondary">
                                        <!option value="Dark" @(pref.ThemeMode == "Dark" ? "selected" : "")>Cosmic Midnight (Dark Gold)</!option>
                                        <!option value="Light" @(pref.ThemeMode == "Light" ? "selected" : "")>Dawn Sanctuary (Light)</!option>
                                    </select>
                                </div>
                            </div>

                            <hr class="border-secondary my-4" />

                            <h6 class="text-white fw-bold mb-3"><i class="fa-solid fa-bell text-warning me-2"></i>Notification Channels</h6>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="ReceiveDailyNotification" value="true" id="dailyNotifCheck" @(pref.ReceiveDailyNotification ? "checked" : "") />
                                <label class="form-check-label text-light" for="dailyNotifCheck">
                                    Receive Daily Horoscope Insights every morning (06:00 AM IST)
                                </label>
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="ReceivePromoAlerts" value="true" id="promoAlertsCheck" @(pref.ReceivePromoAlerts ? "checked" : "") />
                                <label class="form-check-label text-light" for="promoAlertsCheck">
                                    Receive Discount Alerts, Festive Muhurata & Planetary Transit notices
                                </label>
                            </div>

                            <div class="mt-4 text-end">
                                <button type="submit" class="btn btn-warning px-4 fw-bold">
                                    <i class="fa-solid fa-check-double me-1"></i> Save Preferences
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
