@model CYHAstro.Core.DTOs.Astrology.KundliRequestDto
@{
    ViewData["Title"] = "Free Janam Kundli Generator";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-4">
                <span class="fs-1 text-warning"><i class="fa-solid fa-chart-pie"></i></span>
                <h2 class="fw-bold text-white brand-font mt-2">Free Vedic Janam Kundli</h2>
                <p class="text-secondary small">Generate your complete birth chart with precision planetary longitudes, Bhavas, and Gemini AI synthesis</p>
            </div>

            <div class="cosmic-card p-4 p-md-5 border-warning border-opacity-30">
                <form asp-controller="Kundli" asp-action="Generate" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small text-secondary">Full Name</label>
                            <input asp-for="Name" class="form-control form-control-cosmic" placeholder="e.g. Rahul Sharma" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-secondary">Gender</label>
                            <select asp-for="Gender" class="form-control form-control-cosmic">
                                <option value="M">Male</option>
                                <option value="F">Female</option>
                                <option value="O">Other</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Date of Birth</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control form-control-cosmic" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Time of Birth (Exact or approximate)</label>
                            <input asp-for="TimeOfBirth" type="time" class="form-control form-control-cosmic" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label small text-secondary">Birth Place / City</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-location-dot"></i></span>
                                <input asp-for="BirthPlace" class="form-control form-control-cosmic" placeholder="e.g. New Delhi, India" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Ayanamsha</label>
                            <select asp-for="Ayanamsha" class="form-control form-control-cosmic">
                                <option value="Lahiri">Lahiri (Chitra Paksha - Standard)</option>
                                <option value="Raman">B.V. Raman</option>
                                <option value="KP">Krishnamurti Paddhati (KP)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Chart Style</label>
                            <select asp-for="ChartStyle" class="form-control form-control-cosmic">
                                <option value="NorthIndian">North Indian (Diamond)</option>
                                <option value="SouthIndian">South Indian (Box)</option>
                            </select>
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-gold w-100 py-3 fs-6">
                                <i class="fa-solid fa-wand-magic-sparkles me-2"></i> Compute Janam Kundli
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
