@model CYHAstro.Core.DTOs.Astrology.MatchmakingRequestDto
@{
    ViewData["Title"] = "Vedic Kundli Milan (36 Gunas Matching)";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="text-center mb-4">
                <span class="fs-1 text-danger"><i class="fa-solid fa-heart"></i></span>
                <h2 class="fw-bold text-white brand-font mt-2">Vedic Kundli Milan (36 Gunas)</h2>
                <p class="text-secondary small">Classical Ashtakoot Guna Milan assessing marital harmony, longevity, mental compatibility & progeny</p>
            </div>

            <div class="cosmic-card p-4 p-md-5 border-warning border-opacity-30">
                <form asp-controller="Kundli" asp-action="Matchmaking" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-4">
                        <!-- Groom Column -->
                        <div class="col-md-6 border-end-md border-secondary border-opacity-25 pe-md-4">
                            <div class="d-flex align-items-center gap-2 mb-3 text-warning">
                                <i class="fa-solid fa-mars fs-4"></i>
                                <h5 class="fw-bold mb-0">Groom's Details (Var)</h5>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small text-secondary">Groom's Name</label>
                                <input asp-for="MaleName" class="form-control form-control-cosmic" placeholder="Groom's full name" required />
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small text-secondary">Date of Birth</label>
                                    <input asp-for="MaleDob" type="date" class="form-control form-control-cosmic" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-secondary">Time of Birth</label>
                                    <input asp-for="MaleTob" type="time" class="form-control form-control-cosmic" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small text-secondary">Birth Place</label>
                                <input asp-for="MalePlace" class="form-control form-control-cosmic" placeholder="e.g. New Delhi, India" required />
                                <input type="hidden" asp-for="MaleLat" value="@(Model.MaleLat != 0 ? Model.MaleLat : 28.6139m)" />
                                <input type="hidden" asp-for="MaleLon" value="@(Model.MaleLon != 0 ? Model.MaleLon : 77.2090m)" />
                            </div>
                        </div>

                        <!-- Bride Column -->
                        <div class="col-md-6 ps-md-4">
                            <div class="d-flex align-items-center gap-2 mb-3 text-danger">
                                <i class="fa-solid fa-venus fs-4"></i>
                                <h5 class="fw-bold mb-0">Bride's Details (Kanya)</h5>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small text-secondary">Bride's Name</label>
                                <input asp-for="FemaleName" class="form-control form-control-cosmic" placeholder="Bride's full name" required />
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small text-secondary">Date of Birth</label>
                                    <input asp-for="FemaleDob" type="date" class="form-control form-control-cosmic" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-secondary">Time of Birth</label>
                                    <input asp-for="FemaleTob" type="time" class="form-control form-control-cosmic" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small text-secondary">Birth Place</label>
                                <input asp-for="FemalePlace" class="form-control form-control-cosmic" placeholder="e.g. Mumbai, India" required />
                                <input type="hidden" asp-for="FemaleLat" value="@(Model.FemaleLat != 0 ? Model.FemaleLat : 19.0760m)" />
                                <input type="hidden" asp-for="FemaleLon" value="@(Model.FemaleLon != 0 ? Model.FemaleLon : 72.8777m)" />
                            </div>
                        </div>

                        <!-- Action Submit -->
                        <div class="col-12 mt-4 text-center">
                            <button type="submit" class="btn btn-gold btn-lg px-5 py-3 shadow">
                                <i class="fa-solid fa-calculator me-2"></i> Calculate Ashtakoot Milan (36 Gunas)
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
