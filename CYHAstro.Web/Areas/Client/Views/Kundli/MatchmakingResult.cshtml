@model CYHAstro.Core.DTOs.Astrology.MatchmakingResultDto
@{
    ViewData["Title"] = "Kundli Milan Result - 36 Gunas Matching";
    string groom = ViewBag.MaleName as string ?? "Groom";
    string bride = ViewBag.FemaleName as string ?? "Bride";
    var req = ViewBag.MatchmakingRequest as CYHAstro.Core.DTOs.Astrology.MatchmakingRequestDto;
}

<div class="container py-4">
    <div class="text-center mb-4">
        <span class="text-danger small fw-bold text-uppercase">Vedic Kundli Milan</span>
        <h2 class="fw-bold text-white brand-font mb-1">Compatibility for @groom & @bride</h2>
        <span class="text-secondary small">Ashtakoot Guna Milan Analysis</span>
    </div>

    <!-- Score & Conclusion Card -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-8">
            <div class="cosmic-card p-4 p-md-5 text-center border-warning border-opacity-40">
                <span class="text-secondary small d-block mb-1">Total Compatibility Score</span>
                <h1 class="display-3 fw-extrabold text-warning brand-font mb-2">
                    @Model.TotalScore.ToString("F1") <span class="fs-4 text-secondary">/ 36</span>
                </h1>

                <div class="d-inline-block px-4 py-2 rounded-pill @(Model.TotalScore >= 18 ? "bg-success bg-opacity-25 text-success border border-success" : "bg-danger bg-opacity-25 text-danger border border-danger") fw-bold mb-3">
                    <i class="fa-solid fa-certificate me-1"></i> @Model.Conclusion
                </div>

                <!-- Dosha Checks -->
                <div class="d-flex justify-content-center flex-wrap gap-3 mt-2">
                    <span class="badge @(Model.HasNadiDosha ? "bg-danger" : "bg-dark border border-secondary text-light") px-3 py-2">
                        Nadi Dosha: @(Model.HasNadiDosha ? "Present" : "No Dosha")
                    </span>
                    <span class="badge @(Model.HasBhakootDosha ? "bg-danger" : "bg-dark border border-secondary text-light") px-3 py-2">
                        Bhakoot Dosha: @(Model.HasBhakootDosha ? "Present" : "No Dosha")
                    </span>
                    <span class="badge @(Model.HasGanaDosha ? "bg-warning text-dark" : "bg-dark border border-secondary text-light") px-3 py-2">
                        Gana Compatibility: @(Model.HasGanaDosha ? "Needs Harmony" : "Auspicious")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Gemini AI Verdict -->
    @if (!string.IsNullOrWhiteSpace(Model.AiVerdict))
    {
        <div class="row justify-content-center mb-4">
            <div class="col-lg-8">
                <div class="cosmic-card p-4 border-warning border-opacity-30">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fa-solid fa-wand-magic-sparkles text-warning fs-5"></i>
                        <h6 class="fw-bold text-white brand-font mb-0">Gemini AI Astrological Verdict</h6>
                    </div>
                    <p class="text-light leading-relaxed small mb-0">
                        @Model.AiVerdict
                    </p>
                </div>
            </div>
        </div>
    }

    <!-- 8 Ashtakoot Gunas Breakdown Table -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-8">
            <div class="cosmic-card p-4">
                <h5 class="fw-bold text-white brand-font mb-3">
                    <i class="fa-solid fa-list-check text-warning me-2"></i> Ashtakoot (8 Dimensions) Breakdown
                </h5>
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 small">
                        <thead>
                            <tr class="text-secondary border-secondary">
                                <th>Guna</th>
                                <th>Significance</th>
                                <th class="text-center">Max Points</th>
                                <th class="text-center">Obtained</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in Model.GunaBreakdown)
                            {
                                <tr>
                                    <td class="fw-bold text-warning">@g.GunaName</td>
                                    <td class="text-secondary">@g.Description</td>
                                    <td class="text-center">@g.MaxPoints</td>
                                    <td class="text-center fw-bold @(g.ObtainedPoints > 0 ? "text-success" : "text-danger")">
                                        @g.ObtainedPoints
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="border-top border-warning text-warning fw-bold">
                                <td colspan="2">Total Match Score</td>
                                <td class="text-center">36</td>
                                <td class="text-center fs-6">@Model.TotalScore.ToString("F1")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA Actions -->
    <div class="text-center d-flex justify-content-center flex-wrap gap-2 mt-4">
        @if (req != null)
        {
            <form asp-action="DownloadMatchmakingPdf" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaleName" value="@req.MaleName" />
                <input type="hidden" name="MaleDob" value="@req.MaleDob.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="MaleTob" value="@req.MaleTob" />
                <input type="hidden" name="MaleLat" value="@req.MaleLat" />
                <input type="hidden" name="MaleLon" value="@req.MaleLon" />
                <input type="hidden" name="FemaleName" value="@req.FemaleName" />
                <input type="hidden" name="FemaleDob" value="@req.FemaleDob.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="FemaleTob" value="@req.FemaleTob" />
                <input type="hidden" name="FemaleLat" value="@req.FemaleLat" />
                <input type="hidden" name="FemaleLon" value="@req.FemaleLon" />
                <button type="submit" class="btn btn-warning fw-bold px-4 shadow">
                    <i class="fa-solid fa-file-pdf me-2"></i> Download PDF Report
                </button>
            </form>
        }
        <a asp-action="Matchmaking" class="btn btn-outline-gold">
            <i class="fa-solid fa-rotate-left me-1"></i> Check Another Match
        </a>
        <a asp-controller="Astrologer" asp-action="Index" class="btn btn-gold">
            <i class="fa-solid fa-comments me-1"></i> Consult Astrologer
        </a>
    </div>
</div>
