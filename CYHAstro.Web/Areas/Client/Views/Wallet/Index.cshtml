@{
    ViewData["Title"] = "Wallet & Passbook";
    var balance = ViewBag.Balance as CYHAstro.Core.DTOs.Wallet.WalletBalanceDto ?? new CYHAstro.Core.DTOs.Wallet.WalletBalanceDto();
    var packages = ViewBag.Packages as IReadOnlyList<CYHAstro.Core.DTOs.Wallet.RechargePackageDto> ?? new List<CYHAstro.Core.DTOs.Wallet.RechargePackageDto>();
    var transactions = ViewBag.Transactions as IReadOnlyList<CYHAstro.Core.DTOs.Wallet.WalletTransactionDto> ?? new List<CYHAstro.Core.DTOs.Wallet.WalletTransactionDto>();
}

<div class="container py-4">
    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold text-white brand-font mb-1">My Astrology Wallet</h2>
        <span class="text-secondary small">Safe, bank-grade encrypted wallet for astrologer consultations and reports</span>
    </div>

    <!-- Balance Banner -->
    <div class="row g-4 mb-5">
        <div class="col-lg-4">
            <div class="cosmic-card p-4 p-md-5 h-100 border-warning border-opacity-40 text-center text-lg-start">
                <span class="text-secondary small d-block mb-1">Total Available Balance</span>
                <h1 class="display-4 fw-extrabold text-warning brand-font mb-3">
                    ₹@balance.TotalBalance.ToString("F2")
                </h1>
                <div class="d-flex justify-content-between p-2 rounded bg-dark border border-secondary border-opacity-25 small mb-3">
                    <span class="text-secondary">Paid Balance:</span>
                    <strong class="text-white">₹@balance.PaidBalance.ToString("F2")</strong>
                </div>
                <div class="d-flex justify-content-between p-2 rounded bg-dark border border-secondary border-opacity-25 small">
                    <span class="text-secondary">Bonus Balance:</span>
                    <strong class="text-success">₹@balance.BonusBalance.ToString("F2")</strong>
                </div>
            </div>
        </div>

        <!-- Recharge Packages Grid -->
        <div class="col-lg-8">
            <div class="cosmic-card p-4 p-md-5 h-100">
                <h5 class="fw-bold text-white brand-font mb-3">
                    <i class="fa-solid fa-bolt text-warning me-2"></i> Quick Wallet Recharge
                </h5>
                <p class="text-secondary small mb-4">Choose a recharge package to get instant promotional bonus credits applied directly to your account.</p>

                <div class="row g-3">
                    @foreach (var pkg in packages)
                    {
                        <div class="col-sm-6 col-md-4">
                            <form asp-controller="Wallet" asp-action="Recharge" method="post" class="h-100">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="packageId" value="@pkg.Id" />
                                <div class="p-3 rounded bg-dark border @(pkg.IsPopular ? "border-warning" : "border-secondary border-opacity-30") text-center position-relative h-100 d-flex flex-column justify-content-between">
                                    @if (pkg.IsPopular)
                                    {
                                        <span class="badge bg-warning text-dark position-absolute top-0 start-50 translate-middle" style="font-size: 0.65rem;">
                                            MOST POPULAR
                                        </span>
                                    }

                                    <div>
                                        <h4 class="fw-bold text-white mb-1">₹@pkg.Amount.ToString("N0")</h4>
                                        @if (pkg.BonusAmount > 0)
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success small mb-2 d-inline-block">
                                                + ₹@pkg.BonusAmount.ToString("N0") Extra Bonus (@pkg.BonusPercentage%)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary small d-block mb-2">Standard Recharge</span>
                                        }
                                        <div class="small text-secondary mb-3">
                                            Total Credit: <strong>₹@pkg.TotalCredit.ToString("N0")</strong>
                                        </div>
                                    </div>

                                    <button type="button" class="btn btn-gold btn-sm w-100 fw-bold" onclick="initiatePayment(@pkg.Id, this)">
                                        Recharge Now
                                    </button>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Passbook / Ledger Table -->
    <div class="cosmic-card p-4 p-md-5">
        <h5 class="fw-bold text-white brand-font mb-3">
            <i class="fa-solid fa-receipt text-warning me-2"></i> Wallet Passbook (Immutable Ledger)
        </h5>

        @if (transactions.Any())
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 small">
                    <thead>
                        <tr class="text-secondary border-secondary">
                            <th>Date & Time</th>
                            <th>Transaction Type</th>
                            <th>Description</th>
                            <th>Balance Before</th>
                            <th>Amount</th>
                            <th>Balance After</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in transactions)
                        {
                            <tr>
                                <td class="text-secondary">@t.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>
                                    @if (t.TransactionType == "CREDIT")
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success">CREDIT</span>
                                    }
                                    else if (t.TransactionType == "DEBIT")
                                    {
                                        <span class="badge bg-danger bg-opacity-25 text-danger">DEBIT</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info bg-opacity-25 text-info">@t.TransactionType</span>
                                    }
                                </td>
                                <td>@t.Description</td>
                                <td class="text-secondary">₹@t.BalanceBefore.ToString("F2")</td>
                                <td class="fw-bold @(t.TransactionType == "CREDIT" ? "text-success" : "text-danger")">
                                    @(t.TransactionType == "CREDIT" ? "+" : "-") ₹@t.Amount.ToString("F2")
                                </td>
                                <td class="text-warning fw-bold">₹@t.BalanceAfter.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-secondary">
                <i class="fa-solid fa-receipt fs-2 mb-2 text-secondary"></i>
                <p class="small mb-0">No wallet transactions found. Recharge to start consultations.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <!-- Razorpay Standard Checkout SDK -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <script>
        async function initiatePayment(packageId, btn) {
            const form = btn.closest("form");
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Preparing...';

            try {
                const resp = await fetch("/Wallet/CreateOrder", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ packageId: packageId, paymentGateway: "Razorpay" })
                });

                if (!resp.ok) {
                    // Fall back to direct form submit for testing
                    form.submit();
                    return;
                }

                const order = await resp.json();

                // If no real Razorpay key configured or in placeholder mode, submit form
                if (!order.gatewayKey || order.gatewayKey.includes("placeholder") || typeof Razorpay === "undefined") {
                    form.submit();
                    return;
                }

                // Launch real Razorpay modal
                const options = {
                    key: order.gatewayKey,
                    amount: Math.round(order.amount * 100), // in paise
                    currency: order.currency || "INR",
                    name: "CYHAstro Jyotish",
                    description: "Astrology Wallet Recharge",
                    order_id: order.gatewayOrderId,
                    handler: async function (response) {
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Verifying...';
                        const verifyResp = await fetch("/Wallet/VerifyPayment", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                paymentPublicId: order.paymentPublicId,
                                gatewayOrderId: response.razorpay_order_id,
                                gatewayPaymentId: response.razorpay_payment_id,
                                gatewaySignature: response.razorpay_signature
                            })
                        });

                        if (verifyResp.ok) {
                            alert("Payment verified successfully! Your wallet balance has been updated.");
                            window.location.reload();
                        } else {
                            alert("Payment verification issue. Please check your transaction history.");
                            window.location.reload();
                        }
                    },
                    modal: {
                        ondismiss: function () {
                            btn.disabled = false;
                            btn.innerHTML = 'Recharge Now';
                        }
                    },
                    theme: {
                        color: "#e5a93b"
                    }
                };

                const rzp = new Razorpay(options);
                rzp.open();
            } catch (err) {
                console.error("Payment init error:", err);
                form.submit();
            }
        }
    </script>
}
