@model CYHAstro.Core.DTOs.Consultation.ConsultationResponseDto
@{
    ViewData["Title"] = $"Consultation with {Model.AstrologerName}";
    var walletBalance = (decimal)(ViewBag.WalletBalance ?? 0m);
    var isMedia = Model.SessionType == "AUDIO" || Model.SessionType == "VIDEO";
}

<div class="container-fluid py-3" style="max-width: 1400px;">
    <!-- Consultation Top Bar -->
    <div class="card cosmic-card p-3 mb-3 border-warning border-opacity-50">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <!-- Astrologer Info -->
            <div class="d-flex align-items-center gap-3">
                <img src="@(string.IsNullOrEmpty(Model.AstrologerPhoto) ? "https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&q=80&w=150" : Model.AstrologerPhoto)"
                     alt="@Model.AstrologerName" class="astro-avatar border border-warning" style="width: 50px; height: 50px;" />
                <div>
                    <h5 class="fw-bold text-white mb-0 brand-font">@Model.AstrologerName</h5>
                    <div class="small">
                        <span class="badge bg-warning text-dark fw-bold me-1">@Model.SessionType</span>
                        <span class="text-secondary">Rate: <strong class="text-white">₹@Model.RatePerMinute.ToString("F2")/min</strong></span>
                    </div>
                </div>
            </div>

            <!-- Live Session Counters -->
            <div class="d-flex align-items-center gap-4 bg-black bg-opacity-50 px-4 py-2 rounded-4 border border-secondary border-opacity-25">
                <div class="text-center">
                    <span class="d-block text-secondary small text-uppercase">Duration</span>
                    <span class="text-warning fw-bold fs-5 font-monospace" id="sessionTimer">00:00</span>
                </div>
                <div class="text-center border-start border-secondary border-opacity-50 ps-4">
                    <span class="d-block text-secondary small text-uppercase">Accrued Spend</span>
                    <span class="text-danger fw-bold fs-5 font-monospace" id="accruedSpend">₹0.00</span>
                </div>
                <div class="text-center border-start border-secondary border-opacity-50 ps-4">
                    <span class="d-block text-secondary small text-uppercase">Wallet Balance</span>
                    <span class="text-success fw-bold fs-5 font-monospace" id="liveBalance">₹@walletBalance.ToString("F2")</span>
                </div>
            </div>

            <!-- End Call Action -->
            <div>
                <button type="button" class="btn btn-danger fw-bold px-4 py-2" data-bs-toggle="modal" data-bs-target="#endSessionModal">
                    <i class="fa-solid fa-phone-slash me-1"></i> End Consultation
                </button>
            </div>
        </div>
    </div>

    <!-- Main Consultation Workspace -->
    <div class="row g-3">
        @if (isMedia)
        {
            <!-- Video / Audio Stream Grid -->
            <div class="col-lg-7">
                <div class="card cosmic-card p-3 h-100 d-flex flex-column" style="min-height: 520px;">
                    <div class="flex-grow-1 position-relative rounded-4 overflow-hidden bg-black d-flex align-items-center justify-content-center border border-secondary border-opacity-50" id="videoContainer">
                        <!-- Waiting Overlay — hidden once astrologer accepts -->
                        <div id="waitingOverlay" class="position-absolute w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-black bg-opacity-90" style="z-index: 10; border-radius: 12px; @(Model.Status == "ACTIVE" ? "display: none;" : "")">
                            <div class="spinner-grow text-warning mb-3" style="width: 3.5rem; height: 3.5rem;" role="status"></div>
                            <h5 class="text-white fw-bold mb-1">Waiting for Astrologer...</h5>
                            <p class="text-secondary small mb-2 text-center px-3">
                                Please wait while <strong class="text-warning">@Model.AstrologerName</strong> accepts your consultation request.
                            </p>
                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 px-3 py-2">
                                <i class="fa-solid fa-phone-volume fa-shake me-2"></i>Ringing Astrologer...
                            </span>
                        </div>

                        <!-- Remote Astrologer Placeholder / Feed -->
                        <div class="text-center p-4" id="remoteParticipantCard" style="z-index: 2;">
                            <img src="@(string.IsNullOrEmpty(Model.AstrologerPhoto) ? "https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&q=80&w=250" : Model.AstrologerPhoto)"
                                 alt="@Model.AstrologerName" class="rounded-circle border border-warning shadow-lg mb-3" style="width: 120px; height: 120px; object-fit: cover;" />
                            <h5 class="text-white fw-bold mb-1">@Model.AstrologerName</h5>
                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">
                                <i class="fa-solid fa-signal me-1"></i> WebRTC Connected
                            </span>
                        </div>

                        <!-- Local Participant Floating Pip -->
                        <div class="position-absolute bottom-0 end-0 m-3 rounded-3 overflow-hidden border border-warning shadow"
                             style="width: 150px; height: 100px; background-color: #151a30; z-index: 20;" id="localParticipantCard">
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-secondary small">
                                <i class="fa-solid fa-user me-1 text-warning"></i> You
                            </div>
                        </div>
                    </div>

                    <!-- Media Controls Bar -->
                    <div class="d-flex justify-content-center gap-3 mt-3">
                        <button class="btn btn-outline-light rounded-circle p-3" id="micToggleBtn" title="Mute/Unmute Mic" onclick="toggleAudio()">
                            <i class="fa-solid fa-microphone fs-5"></i>
                        </button>
                        @if (Model.SessionType == "VIDEO")
                        {
                            <button class="btn btn-outline-light rounded-circle p-3" id="camToggleBtn" title="Camera On/Off" onclick="toggleVideo()">
                                <i class="fa-solid fa-video fs-5"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Chat Stream Panel -->
        <div class="@(isMedia ? "col-lg-5" : "col-12")">
            <div class="card cosmic-card p-3 d-flex flex-column" style="height: 580px;">
                <div class="card-header bg-transparent border-0 pb-2 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                    <span class="text-white fw-bold"><i class="fa-solid fa-comments text-warning me-2"></i>Live Consultation Chat</span>
                    <span class="badge bg-dark border border-secondary text-secondary small" id="connectionStatus">Connecting...</span>
                </div>

                <!-- Messages Stream -->
                <div class="flex-grow-1 p-3 overflow-y-auto" id="chatMessages" style="background-color: rgba(11, 14, 27, 0.4); border-radius: 12px;">
                    <!-- System Welcome Message -->
                    <div class="text-center my-2">
                        <span class="badge bg-dark border border-secondary text-secondary px-3 py-1">
                            <i class="fa-solid fa-shield-halved text-warning me-1"></i> Consultation session #@Model.PublicId started.
                        </span>
                    </div>
                </div>

                <!-- Typing indicator -->
                <div class="small text-secondary px-3 py-1" id="typingIndicator" style="display: none;">
                    <i class="fa-solid fa-ellipsis fa-fade text-warning me-1"></i> Astrologer is typing...
                </div>

                <!-- Message Input -->
                <div class="card-footer bg-transparent border-0 pt-2 border-top border-secondary border-opacity-25">
                    <div class="input-group">
                        <input type="text" id="chatInput" class="form-control bg-black text-light border-secondary"
                               placeholder="Type your astrological inquiry..." onkeypress="handleKeyPress(event)" />
                        <button class="btn btn-gold px-4 fw-bold" type="button" onclick="sendMessage()">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Confirm End Consultation -->
<div class="modal fade" id="endSessionModal" tabindex="-1" aria-labelledby="endSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light rounded-4 shadow-lg">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title text-danger fw-bold" id="endSessionModalLabel">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>End Consultation?
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3">
                    Are you sure you want to end your consultation with <strong>@Model.AstrologerName</strong>?
                </p>
                <div class="p-3 rounded bg-black border border-secondary border-opacity-50 text-secondary small">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Elapsed Time:</span>
                        <strong class="text-white" id="modalElapsed">00:00</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Approximate Charge:</span>
                        <strong class="text-warning" id="modalCharge">₹0.00</strong>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary border-opacity-25">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Continue Consultation</button>
                <form asp-action="EndSession" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sessionPublicId" value="@Model.PublicId" />
                    <button type="submit" class="btn btn-danger px-4 fw-bold">Yes, End Consultation</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Post-Consultation Rating & Review -->
<div class="modal fade" id="reviewModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-warning border-opacity-50 text-light rounded-4 shadow-lg">
            <div class="modal-header border-secondary border-opacity-25 bg-black bg-opacity-25">
                <h5 class="modal-title text-warning fw-bold">
                    <i class="fa-solid fa-star text-warning me-2"></i>Rate Your Consultation
                </h5>
            </div>
            <div class="modal-body p-4 text-center">
                <img src="@(string.IsNullOrEmpty(Model.AstrologerPhoto) ? "https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&q=80&w=150" : Model.AstrologerPhoto)"
                     alt="@Model.AstrologerName" class="rounded-circle border border-warning shadow mb-2" style="width: 70px; height: 70px; object-fit: cover;" />
                <h5 class="text-white fw-bold mb-1">@Model.AstrologerName</h5>
                <span class="text-secondary small d-block mb-3" id="reviewSummaryText">Consultation Ended</span>

                <div class="mb-3">
                    <label class="form-label small text-secondary d-block">How was your astrological guidance experience?</label>
                    <div class="d-flex justify-content-center gap-2 fs-2 text-secondary" id="starContainer">
                        <i class="fa-solid fa-star star-btn" data-value="1" onclick="setRating(1)" style="cursor: pointer;"></i>
                        <i class="fa-solid fa-star star-btn" data-value="2" onclick="setRating(2)" style="cursor: pointer;"></i>
                        <i class="fa-solid fa-star star-btn" data-value="3" onclick="setRating(3)" style="cursor: pointer;"></i>
                        <i class="fa-solid fa-star star-btn" data-value="4" onclick="setRating(4)" style="cursor: pointer;"></i>
                        <i class="fa-solid fa-star star-btn" data-value="5" onclick="setRating(5)" style="cursor: pointer; color: #e5a93b;"></i>
                    </div>
                </div>

                <div class="mb-3 text-start">
                    <label class="form-label small text-secondary">Feedback / Testimonial (Optional)</label>
                    <textarea id="reviewComment" rows="3" class="form-control bg-black text-light border-secondary"
                              placeholder="Write a few words about how Acharya's insights helped you..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-secondary border-opacity-25 justify-content-between">
                <a href="/Astrologers" class="btn btn-outline-secondary btn-sm">Skip</a>
                <button type="button" class="btn btn-gold px-4 fw-bold" onclick="submitReview()">
                    Submit Review <i class="fa-solid fa-paper-plane ms-1"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SignalR Client Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>
        const sessionPublicId = "@Model.PublicId";
        const sessionType = "@Model.SessionType";     // CHAT, AUDIO, VIDEO
        const sessionStatus = "@Model.Status";         // REQUESTED, ACTIVE, etc.
        const ratePerMinute = @Model.RatePerMinute;
        let initialBalance = @walletBalance;
        let elapsedSeconds = @Model.DurationSeconds;
        let timerInterval = null;
        let timerStarted = false;

        // ===================== TIMER =====================
        function startTimer() {
            if (timerStarted) return;
            timerStarted = true;
            timerInterval = setInterval(() => {
                elapsedSeconds++;
                const mins = Math.floor(elapsedSeconds / 60);
                const secs = elapsedSeconds % 60;
                const timeStr = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
                document.getElementById("sessionTimer").innerText = timeStr;
                document.getElementById("modalElapsed").innerText = timeStr;

                const billedMinutes = Math.max(1, Math.ceil(elapsedSeconds / 60));
                const accrued = (billedMinutes * ratePerMinute);
                document.getElementById("accruedSpend").innerText = "₹" + accrued.toFixed(2);
                document.getElementById("modalCharge").innerText = "₹" + accrued.toFixed(2);

                const remaining = Math.max(0, initialBalance - accrued);
                document.getElementById("liveBalance").innerText = "₹" + remaining.toFixed(2);

                if (remaining <= 0) {
                    clearInterval(timerInterval);
                    alert("Your wallet balance is depleted. Consultation is auto-completing.");
                    window.location.reload();
                }
            }, 1000);
        }

        // ===================== SIGNALR =====================
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/consultation")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveMessage", function (msg) {
            appendMessage(msg.senderName, msg.message, msg.senderType === "USER");
        });

        connection.on("UserTyping", function (data) {
            const elem = document.getElementById("typingIndicator");
            if (elem) elem.style.display = data.isTyping ? "block" : "none";
        });

        // ===== ASTROLOGER ACCEPTED — Start Timer + WebRTC =====
        connection.on("SessionAccepted", function (data) {
            console.log("SessionAccepted received:", data);
            const waitingOverlay = document.getElementById("waitingOverlay");
            if (waitingOverlay) waitingOverlay.style.display = "none";

            const statusBadge = document.getElementById("connectionStatus");
            if (statusBadge) {
                statusBadge.innerText = "Live";
                statusBadge.className = "badge bg-success";
            }
            startTimer();
            startHeartbeat();
            if (sessionType === 'VIDEO' || sessionType === 'AUDIO') {
                initWebRTC(true); // callee mode: will answer astrologer's offer
            }
        });

        connection.on("SessionRejected", function (data) {
            alert("Astrologer is currently unavailable. Consultation request was not accepted.");
            window.location.href = "/Astrologers";
        });

        // ===== SESSION ENDED =====
        connection.on("SessionEnded", function (data) {
            clearInterval(timerInterval);
            stopHeartbeat();
            closeWebRTC();
            const mins = Math.floor((data.durationSeconds || 0) / 60);
            const secs = (data.durationSeconds || 0) % 60;
            document.getElementById("reviewSummaryText").innerText =
                `Duration: ${mins}m ${secs}s | Billed: ₹${(data.totalCharge || 0).toFixed(2)}`;
            const revModal = new bootstrap.Modal(document.getElementById("reviewModal"));
            revModal.show();
        });

        connection.on("UserJoinedSession", function (data) {
            console.log("Participant joined:", data.displayName);
            if (timerStarted && (sessionType === 'VIDEO' || sessionType === 'AUDIO')) {
                connection.invoke("RequestMediaOffer", sessionPublicId).catch(() => {});
            }
        });

        // WebRTC signaling receivers
        connection.on("ReceiveMediaOffer", async function (offer) {
            console.log("Seeker received media offer");
            if (!peerConnection) await initWebRTC();
            if (!peerConnection) return;
            try {
                await peerConnection.setRemoteDescription(new RTCSessionDescription(offer));
                await drainIceCandidates();
                const answer = await peerConnection.createAnswer();
                await peerConnection.setLocalDescription(answer);
                connection.invoke("SignalMediaAnswer", sessionPublicId, {
                    type: answer.type,
                    sdp: answer.sdp
                });
            } catch (err) {
                console.error("Error answering offer:", err);
            }
        });

        connection.on("ReceiveMediaAnswer", async function (answer) {
            console.log("Received media answer");
            if (peerConnection) {
                try {
                    await peerConnection.setRemoteDescription(new RTCSessionDescription(answer));
                    await drainIceCandidates();
                } catch (err) {
                    console.error("Error setting remote answer:", err);
                }
            }
        });

        connection.on("ReceiveIceCandidate", async function (candidate) {
            if (!candidate) return;
            await addIceCandidateSafely(candidate);
        });

        connection.start()
            .then(function () {
                connection.invoke("JoinSessionGroup", sessionPublicId);

                if (sessionStatus === 'ACTIVE') {
                    const waitingOverlay = document.getElementById("waitingOverlay");
                    if (waitingOverlay) waitingOverlay.style.display = "none";
                    document.getElementById("connectionStatus").innerText = "Live";
                    document.getElementById("connectionStatus").className = "badge bg-success";
                    startTimer();
                    startHeartbeat();
                    if (sessionType === 'VIDEO' || sessionType === 'AUDIO') {
                        setTimeout(() => initWebRTC(true), 1500);
                    }
                } else {
                    document.getElementById("connectionStatus").innerText = "Waiting...";
                    document.getElementById("connectionStatus").className = "badge bg-warning text-dark";
                }
            })
            .catch(function (err) {
                console.error("SignalR Connection Error: ", err);
                document.getElementById("connectionStatus").innerText = "Offline Mode";
                document.getElementById("connectionStatus").className = "badge bg-danger";
            });

        // ===================== HEARTBEAT =====================
        let heartbeatInterval = null;
        function startHeartbeat() {
            if (heartbeatInterval) return;
            heartbeatInterval = setInterval(() => {
                if (connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("Ping", sessionPublicId).catch(() => {});
                }
            }, 30000);
        }
        function stopHeartbeat() {
            if (heartbeatInterval) { clearInterval(heartbeatInterval); heartbeatInterval = null; }
        }

        // ===================== BEFORE UNLOAD =====================
        window.addEventListener("beforeunload", function () {
            stopHeartbeat();
            closeWebRTC();
            navigator.sendBeacon('/Consultation/Disconnect?sessionId=' + encodeURIComponent(sessionPublicId));
        });

        // ===================== CHAT =====================
        function appendMessage(sender, text, isMe) {
            const box = document.getElementById("chatMessages");
            const div = document.createElement("div");
            div.className = isMe ? "d-flex justify-content-end mb-2" : "d-flex justify-content-start mb-2";

            div.innerHTML = `
                <div class="p-3 rounded-4 shadow-sm" style="max-width: 80%; background-color: ${isMe ? '#e5a93b' : '#1e2642'}; color: ${isMe ? '#0c0f1d' : '#ffffff'};">
                    <div class="small fw-bold opacity-75 mb-1">${sender}</div>
                    <div style="font-size: 0.95rem;">${text}</div>
                </div>
            `;
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        }

        function sendMessage() {
            const input = document.getElementById("chatInput");
            const text = input.value.trim();
            if (!text) return;

            connection.invoke("SendMessage", sessionPublicId, text)
                .then(() => { input.value = ""; })
                .catch(err => {
                    appendMessage("You", text, true);
                    input.value = "";
                });
        }

        function handleKeyPress(e) {
            if (e.key === "Enter") sendMessage();
        }

        // ===================== REVIEW =====================
        let selectedRating = 5;
        function setRating(val) {
            selectedRating = val;
            const stars = document.querySelectorAll(".star-btn");
            stars.forEach(s => {
                const sVal = parseInt(s.getAttribute("data-value"));
                s.style.color = sVal <= val ? "#e5a93b" : "#6c757d";
            });
        }

        async function submitReview() {
            const comment = document.getElementById("reviewComment").value.trim();
            try {
                const resp = await fetch("/Consultation/SubmitReview", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        sessionPublicId: sessionPublicId,
                        rating: selectedRating,
                        reviewText: comment
                    })
                });
                if (resp.ok) {
                    alert("Thank you for your valuable feedback!");
                }
            } catch (e) {
                console.error("Review submission error:", e);
            }
            window.location.href = "/Astrologers";
        }

        // ===================== WebRTC =====================
        let peerConnection = null;
        let localStream = null;
        let isInitializingWebRTC = false;
        let remoteIceQueue = [];

        const iceServers = {
            iceServers: [
                { urls: "stun:stun.l.google.com:19302" },
                { urls: "stun:stun1.l.google.com:19302" },
                { urls: "stun:stun2.l.google.com:19302" }
            ]
        };

        async function getClientMediaStream(isVideo) {
            if (!isVideo) {
                return await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
            }
            try {
                return await navigator.mediaDevices.getUserMedia({
                    audio: true,
                    video: {
                        width: { ideal: 1280, max: 1920 },
                        height: { ideal: 720, max: 1080 },
                        facingMode: 'user'
                    }
                });
            } catch (err1) {
                console.warn("Retrying client media with basic constraints:", err1);
                try {
                    return await navigator.mediaDevices.getUserMedia({ audio: true, video: true });
                } catch (err2) {
                    console.error("Failed to acquire client media:", err2);
                    throw err2;
                }
            }
        }

        async function addIceCandidateSafely(candidate) {
            if (!candidate || (!candidate.candidate && candidate.candidate !== '')) return;
            if (peerConnection && peerConnection.remoteDescription && peerConnection.remoteDescription.type) {
                try {
                    await peerConnection.addIceCandidate(new RTCIceCandidate(candidate));
                } catch (e) {
                    console.warn("Client addIceCandidate error:", e);
                }
            } else {
                remoteIceQueue.push(candidate);
            }
        }

        async function drainIceCandidates() {
            if (!peerConnection) return;
            while (remoteIceQueue.length > 0) {
                const cand = remoteIceQueue.shift();
                try {
                    await peerConnection.addIceCandidate(new RTCIceCandidate(cand));
                } catch (e) {
                    console.warn("Client drain candidate error:", e);
                }
            }
        }

        async function initWebRTC() {
            if (localStream || isInitializingWebRTC) return;
            isInitializingWebRTC = true;

            try {
                const isVideo = sessionType === 'VIDEO';
                localStream = await getClientMediaStream(isVideo);

                // Show local video PiP
                if (isVideo) {
                    const localContainer = document.getElementById('localParticipantCard');
                    if (localContainer) {
                        localContainer.innerHTML = '';
                        const localVid = document.createElement('video');
                        localVid.srcObject = localStream;
                        localVid.autoplay = true;
                        localVid.muted = true;
                        localVid.playsInline = true;
                        localVid.style.cssText = 'width: 100%; height: 100%; object-fit: cover; border-radius: 8px;';
                        localContainer.appendChild(localVid);
                        localVid.play().catch(() => {});
                    }
                }

                peerConnection = new RTCPeerConnection(iceServers);
                localStream.getTracks().forEach(track => peerConnection.addTrack(track, localStream));

                peerConnection.onicecandidate = (event) => {
                    if (event.candidate) {
                        connection.invoke("SignalIceCandidate", sessionPublicId, {
                            candidate: event.candidate.candidate,
                            sdpMid: event.candidate.sdpMid,
                            sdpMLineIndex: event.candidate.sdpMLineIndex
                        });
                    }
                };

                peerConnection.ontrack = (event) => {
                    console.log("Client received astrologer track:", event.track.kind);
                    const placeholder = document.getElementById('remoteParticipantCard');
                    if (placeholder) placeholder.style.display = 'none';
                    const waitingOverlay = document.getElementById('waitingOverlay');
                    if (waitingOverlay) waitingOverlay.style.display = 'none';

                    const container = document.getElementById('videoContainer');

                    if (event.track.kind === 'video') {
                        let remoteVid = document.getElementById('remoteVideoEl');
                        if (!remoteVid) {
                            remoteVid = document.createElement('video');
                            remoteVid.id = 'remoteVideoEl';
                            remoteVid.autoplay = true;
                            remoteVid.playsInline = true;
                            remoteVid.muted = true; // muted to prevent browser autoplay block
                            remoteVid.style.cssText = 'width: 100%; height: 100%; object-fit: cover; border-radius: 12px; position: absolute; top: 0; left: 0; z-index: 1;';
                            container.appendChild(remoteVid);
                        }
                        if (event.streams && event.streams[0]) {
                            remoteVid.srcObject = event.streams[0];
                        } else {
                            if (!remoteVid.srcObject) remoteVid.srcObject = new MediaStream();
                            remoteVid.srcObject.addTrack(event.track);
                        }
                        remoteVid.play().catch(e => console.warn("Client video play notice:", e));
                    } else if (event.track.kind === 'audio') {
                        let remoteAudio = document.getElementById('remoteAudioEl');
                        if (!remoteAudio) {
                            remoteAudio = document.createElement('audio');
                            remoteAudio.id = 'remoteAudioEl';
                            remoteAudio.autoplay = true;
                            document.body.appendChild(remoteAudio);
                        }
                        if (event.streams && event.streams[0]) {
                            remoteAudio.srcObject = event.streams[0];
                        } else {
                            if (!remoteAudio.srcObject) remoteAudio.srcObject = new MediaStream();
                            remoteAudio.srcObject.addTrack(event.track);
                        }
                        remoteAudio.play().catch(e => console.warn("Client audio play notice:", e));
                    }
                };

            } catch (err) {
                console.error("Camera/Mic access error:", err);
                alert("Could not access camera or microphone. Please allow permissions in your browser.");
            } finally {
                isInitializingWebRTC = false;
            }
        }

        function closeWebRTC() {
            if (localStream) {
                localStream.getTracks().forEach(t => t.stop());
                localStream = null;
            }
            if (peerConnection) {
                peerConnection.close();
                peerConnection = null;
            }
            remoteIceQueue = [];
            isInitializingWebRTC = false;
        }

        let isAudioMuted = false;
        async function toggleAudio() {
            isAudioMuted = !isAudioMuted;
            const btn = document.getElementById('micToggleBtn');
            btn.innerHTML = isAudioMuted
                ? '<i class="fa-solid fa-microphone-slash text-danger fs-5"></i>'
                : '<i class="fa-solid fa-microphone fs-5"></i>';
            if (localStream) {
                localStream.getAudioTracks().forEach(t => t.enabled = !isAudioMuted);
            }
        }

        let isVideoOff = false;
        async function toggleVideo() {
            isVideoOff = !isVideoOff;
            const btn = document.getElementById('camToggleBtn');
            btn.innerHTML = isVideoOff
                ? '<i class="fa-solid fa-video-slash text-danger fs-5"></i>'
                : '<i class="fa-solid fa-video fs-5"></i>';
            if (localStream) {
                localStream.getVideoTracks().forEach(t => t.enabled = !isVideoOff);
            }
        }
    </script>
}
