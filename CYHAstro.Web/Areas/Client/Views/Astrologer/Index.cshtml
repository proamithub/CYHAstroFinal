@model CYHAstro.Core.Common.PagedResult<CYHAstro.Core.DTOs.Astrologer.AstrologerListingDto>
@{
    ViewData["Title"] = "Talk & Chat with India's Top Astrologers";
    var specialties = ViewBag.Specialties as IReadOnlyList<string> ?? new List<string>();
    var languages = ViewBag.Languages as IReadOnlyList<string> ?? new List<string>();
    string currentSpec = ViewBag.Specialization as string ?? "";
    string currentLang = ViewBag.Language as string ?? "";
    string currentSort = ViewBag.SortBy as string ?? "RATING_DESC";
    string currentSearch = ViewBag.Search as string ?? "";
}

<div class="container py-4">
    <!-- Header -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-white brand-font">Consult Verified Vedic Astrologers</h2>
        <p class="text-secondary small">Real-time chat and call sessions with 100% privacy and per-second billing</p>
    </div>

    <!-- Filter & Search Bar -->
    <div class="cosmic-card p-3 mb-4">
        <form method="get" asp-controller="Astrologer" asp-action="Index" class="row g-2 align-items-center">
            <!-- Search -->
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="search" value="@currentSearch" class="form-control form-control-cosmic form-control-sm" placeholder="Search by name..." />
                </div>
            </div>

            <!-- Specialization -->
            <div class="col-md-3">
                <select name="specialization" class="form-select form-control-cosmic form-select-sm">
                    <option value="">All Specializations</option>
                    @foreach (var spec in specialties)
                    {
                        <option value="@spec" selected="@(spec == currentSpec ? "selected" : null)">@spec</option>
                    }
                </select>
            </div>

            <!-- Language -->
            <div class="col-md-2">
                <select name="language" class="form-select form-control-cosmic form-select-sm">
                    <option value="">All Languages</option>
                    @foreach (var lang in languages)
                    {
                        <option value="@lang" selected="@(lang == currentLang ? "selected" : null)">@lang</option>
                    }
                </select>
            </div>

            <!-- Sort -->
            <div class="col-md-2">
                <select name="sortBy" class="form-select form-control-cosmic form-select-sm">
                    <option value="RATING_DESC" selected="@(currentSort == "RATING_DESC" ? "selected" : null)">Highest Rated</option>
                    <option value="PRICE_ASC" selected="@(currentSort == "PRICE_ASC" ? "selected" : null)">Price: Low to High</option>
                    <option value="PRICE_DESC" selected="@(currentSort == "PRICE_DESC" ? "selected" : null)">Price: High to Low</option>
                    <option value="EXPERIENCE_DESC" selected="@(currentSort == "EXPERIENCE_DESC" ? "selected" : null)">Most Experienced</option>
                </select>
            </div>

            <!-- Submit -->
            <div class="col-md-1">
                <button type="submit" class="btn btn-gold btn-sm w-100">
                    Filter
                </button>
            </div>
        </form>
    </div>

    <!-- Astrologer Grid -->
    <div class="row g-4 mb-4">
        @if (Model != null && Model.Items.Any())
        {
            @foreach (var astro in Model.Items)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="cosmic-card p-4 h-100 d-flex flex-column">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <img src="@(string.IsNullOrEmpty(astro.ProfilePhotoUrl) ? "https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&q=80&w=200" : astro.ProfilePhotoUrl)"
                                 alt="@astro.DisplayName" class="astro-avatar" loading="lazy" width="80" height="80" />
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="fw-bold text-white mb-0">@astro.DisplayName</h6>
                                    @if (astro.IsAvailable)
                                    {
                                        <span class="badge-online" data-astro-badge="@astro.PublicId"><i class="fa-solid fa-circle me-1" style="font-size: 6px;"></i> Online</span>
                                    }
                                    else
                                    {
                                        <span class="badge-offline" data-astro-badge="@astro.PublicId"><i class="fa-solid fa-circle me-1 text-secondary" style="font-size: 6px;"></i> Offline</span>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-1 my-1">
                                    <i class="fa-solid fa-star gold-star small"></i>
                                    <span class="fw-bold text-warning small">@astro.Rating.ToString("F2")</span>
                                    <span class="text-secondary small">(@astro.TotalReviews reviews)</span>
                                </div>
                                <span class="text-secondary small d-block">
                                    <i class="fa-solid fa-briefcase me-1 text-warning"></i> @astro.ExperienceYears yrs exp
                                </span>
                            </div>
                        </div>

                        <!-- Specialties -->
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var spec in astro.Specializations.Take(3))
                            {
                                <span class="badge bg-dark border border-secondary text-secondary small" style="font-size: 0.7rem;">@spec</span>
                            }
                        </div>

                        <!-- Languages -->
                        <div class="small text-secondary mb-3">
                            <i class="fa-solid fa-language me-1 text-info"></i> @string.Join(", ", astro.Languages)
                        </div>

                        <p class="text-secondary small line-clamp-2 mb-3 flex-grow-1">
                            @(astro.Bio ?? "Experienced Vedic scholar offering holistic astrological guidance and life solutions.")
                        </p>

                        <!-- Pricing & Action -->
                        <div class="pt-3 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-secondary" style="font-size: 0.75rem;">Starting At</span>
                                <h6 class="text-warning fw-bold mb-0">₹@astro.ChatRatePerMinute<span class="text-secondary fw-normal small">/min</span></h6>
                            </div>

                            <div class="d-flex gap-2">
                                <a href="/Astrologer/Detail/@astro.PublicId" class="btn btn-outline-gold btn-sm px-3">
                                    Profile
                                </a>
                                @if (astro.IsAvailable)
                                {
                                    <a href="/Astrologer/Detail/@astro.PublicId?action=chat" class="btn btn-gold btn-sm px-3" data-astro-chat-btn="@astro.PublicId">
                                        <i class="fa-solid fa-comment-dots me-1"></i> Consult
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary btn-sm px-3 opacity-50" disabled style="cursor: not-allowed;" data-astro-chat-btn="@astro.PublicId" title="Astrologer is currently offline">
                                        <i class="fa-solid fa-lock me-1"></i> Offline
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fa-solid fa-user-slash fs-1 text-secondary mb-3"></i>
                <h5 class="text-white">No astrologers found</h5>
                <p class="text-secondary small">Try adjusting your filters or search keywords.</p>
                <a asp-action="Index" class="btn btn-outline-gold btn-sm">Clear All Filters</a>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model != null && Model.TotalPages > 1)
    {
        <nav aria-label="Astrologer page navigation">
            <ul class="pagination justify-content-center">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link bg-dark text-warning border-secondary"
                           href="@Url.Action("Index", new { search = currentSearch, specialization = currentSpec, language = currentLang, sortBy = currentSort, page = p })">
                            @p
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
