@model CYHAstro.Core.DTOs.Admin.AdminAstrologerDto
@{
    ViewData["Title"] = $"Edit Astrologer - {Model.DisplayName}";
}

<div class="container-fluid px-0" style="max-width: 900px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-warning text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-controller="Astrologers" asp-action="Index" class="text-warning text-decoration-none">Astrologers</a></li>
            <li class="breadcrumb-item active text-light" aria-current="page">@Model.DisplayName</li>
        </ol>
    </nav>

    <div class="card admin-card p-4 rounded-4 shadow">
        <div class="d-flex align-items-center gap-3 pb-4 mb-4 border-bottom border-secondary border-opacity-25">
            <img src="@(string.IsNullOrEmpty(Model.ProfilePhotoUrl) ? "https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&q=80&w=150" : Model.ProfilePhotoUrl)"
                 alt="@Model.DisplayName" class="rounded-circle border border-warning" style="width: 70px; height: 70px; object-fit: cover;" />
            <div>
                <h4 class="text-white fw-bold mb-1">@Model.DisplayName</h4>
                <div class="text-secondary small">
                    <span class="text-warning"><i class="fa-solid fa-star me-1"></i>@Model.Rating.ToString("F1")</span> |
                    <span>@Model.TotalConsultations Consultations</span> |
                    <span>Experience: @Model.ExperienceYears years</span>
                </div>
            </div>
        </div>

        <form asp-action="Update" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="row g-4">
                <!-- Rates Section -->
                <div class="col-12">
                    <h6 class="text-warning fw-bold text-uppercase small" style="letter-spacing: 0.5px;">
                        <i class="fa-solid fa-tags me-1"></i> Consultation Rates (INR per minute)
                    </h6>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-light fw-medium">Chat Rate (₹/min)</label>
                    <input type="number" step="0.5" name="ChatRatePerMinute" class="form-control bg-black text-light border-secondary"
                           value="@Model.ChatRatePerMinute" required min="1" />
                </div>
                <div class="col-md-4">
                    <label class="form-label text-light fw-medium">Audio Call Rate (₹/min)</label>
                    <input type="number" step="0.5" name="AudioRatePerMinute" class="form-control bg-black text-light border-secondary"
                           value="@Model.AudioRatePerMinute" required min="1" />
                </div>
                <div class="col-md-4">
                    <label class="form-label text-light fw-medium">Video Call Rate (₹/min)</label>
                    <input type="number" step="0.5" name="VideoRatePerMinute" class="form-control bg-black text-light border-secondary"
                           value="@Model.VideoRatePerMinute" required min="1" />
                </div>

                <!-- Platform Commission & Financials -->
                <div class="col-12 mt-4">
                    <h6 class="text-warning fw-bold text-uppercase small" style="letter-spacing: 0.5px;">
                        <i class="fa-solid fa-percent me-1"></i> Financials & Platform Cut
                    </h6>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-light fw-medium">Platform Commission (%)</label>
                    <div class="input-group">
                        <input type="number" step="0.1" name="CommissionRatePct" class="form-control bg-black text-light border-secondary"
                               value="@Model.CommissionRatePct" required min="0" max="100" />
                        <span class="input-group-text bg-dark border-secondary text-secondary">%</span>
                    </div>
                    <small class="text-secondary">E.g., 20.00% means the platform takes 20% and the astrologer receives 80% of session earnings.</small>
                </div>

                <!-- Status & Badges -->
                <div class="col-12 mt-4">
                    <h6 class="text-warning fw-bold text-uppercase small" style="letter-spacing: 0.5px;">
                        <i class="fa-solid fa-toggle-on me-1"></i> Account Governance
                    </h6>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch p-3 rounded bg-dark border border-secondary border-opacity-50">
                        <input class="form-check-input ms-0 me-3" type="checkbox" name="IsVerified" value="true" id="isVerifiedCheck" @(Model.IsVerified ? "checked" : "") />
                        <label class="form-check-label text-light fw-medium" for="isVerifiedCheck">
                            Verified Astrologer Badge
                        </label>
                        <small class="d-block text-secondary mt-1">Credentials and Vedic certificates verified by CYHAstro admin team.</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch p-3 rounded bg-dark border border-secondary border-opacity-50">
                        <input class="form-check-input ms-0 me-3" type="checkbox" name="IsActive" value="true" id="isActiveCheck" @(Model.IsActive ? "checked" : "") />
                        <label class="form-check-label text-light fw-medium" for="isActiveCheck">
                            Active & Publicly Visible
                        </label>
                        <small class="d-block text-secondary mt-1">When turned off, astrologer will be hidden from seeker search and unable to accept new calls.</small>
                    </div>
                </div>
            </div>

            <hr class="border-secondary border-opacity-25 my-4" />

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Directory
                </a>
                <button type="submit" class="btn btn-gold px-4 fw-bold">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Save Configuration
                </button>
            </div>
        </form>
    </div>
</div>
