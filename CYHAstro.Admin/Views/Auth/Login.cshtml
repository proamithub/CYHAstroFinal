@{
    ViewData["Title"] = "Admin Sign In";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-black bg-opacity-75 py-5 px-3">
    <div class="card admin-card border-warning border-opacity-50 shadow-lg rounded-4 overflow-hidden" style="max-width: 440px; width: 100%;">
        <div class="card-header bg-gradient p-4 text-center border-0 border-bottom border-secondary border-opacity-25" style="background-color: #101528;">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning text-dark mb-3" style="width: 60px; height: 60px; font-size: 1.8rem;">
                <i class="fa-solid fa-user-shield"></i>
            </div>
            <h4 class="text-white fw-bold mb-1">CYH<span class="text-warning">Astro</span> Console</h4>
            <p class="text-secondary small mb-0">Platform Administration & Real-time Operations</p>
        </div>

        <div class="card-body p-4">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 small py-2 px-3 mb-4" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-1"></i> @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-controller="Auth" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold text-uppercase">Admin Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-black border-secondary text-warning"><i class="fa-solid fa-envelope"></i></span>
                        <input type="email" name="email" class="form-control bg-black text-light border-secondary"
                               placeholder="admin@cyhastro.com" value="admin@cyhastro.com" required autofocus />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold text-uppercase">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-black border-secondary text-warning"><i class="fa-solid fa-key"></i></span>
                        <input type="password" name="password" class="form-control bg-black text-light border-secondary"
                               placeholder="••••••••" required />
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="rememberMe" value="true" id="rememberCheck" checked />
                        <label class="form-check-label text-secondary small" for="rememberCheck">
                            Remember session
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-gold w-100 py-2 fw-bold shadow">
                    <i class="fa-solid fa-right-to-bracket me-2"></i> Authenticate & Enter
                </button>
            </form>

            <div class="mt-4 p-3 rounded bg-dark border border-secondary border-opacity-25 text-secondary small">
                <div class="d-flex align-items-center gap-2 mb-1 text-warning fw-semibold">
                    <i class="fa-solid fa-circle-info"></i> Initial Deployment Credentials
                </div>
                <div>Default Email: <strong class="text-white">admin@cyhastro.com</strong></div>
                <div>Default Password: <strong class="text-white">Admin@CYHAstro2026!</strong></div>
            </div>
        </div>
    </div>
</div>
