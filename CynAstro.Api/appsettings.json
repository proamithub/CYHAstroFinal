{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CynAstroDB": "Server=localhost;Database=CynAstroDB;Integrated Security=true;TrustServerCertificate=true;",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_SECRET_IN_USER_SECRETS_OR_ENV",
    "Issuer": "CynAstro",
    "Audience": "CynAstroUsers"
  },
  "Google": {
    "ClientId": "REPLACE_WITH_GOOGLE_CLIENT_ID",
    "ClientSecret": "REPLACE_WITH_GOOGLE_CLIENT_SECRET"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5001",
      "http://localhost:5002",
      "https://cynastro.com",
      "https://admin.cynastro.com"
    ]
  },
  "LiveKit": {
    "Url": "ws://localhost:7880",
    "ApiKey": "REPLACE_WITH_LIVEKIT_API_KEY",
    "ApiSecret": "REPLACE_WITH_LIVEKIT_API_SECRET"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
